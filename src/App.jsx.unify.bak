  const closeOd = (a, b) => Math.abs(a - b) < 0.02, closeThk = (a, b) => Math.abs(a - b) < 0.011;   // a size typed in inches (0.492 in) still finds its mm size
  return sizesFor(sizes, f.productType).find(x => closeOd(x.od, od.mm) && closeThk(x.thk || 0, thk.mm || 0) && (!x.spec || mdSame(x.spec, f.specification))) || null;
