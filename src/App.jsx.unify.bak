function sortPlanOrders(orders, closestFirst = false) {
  const key = (o) => o.dueDate || '';
  const no = (o) => String(o.orderNo || o.salesOrderNo || '');
  return [...(orders || [])].sort((a, b) => {
    const ka = key(a), kb = key(b);
    if (ka !== kb) {
