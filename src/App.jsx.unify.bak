function stockForSpec(finished, spec) {
  const k = spec && String(spec).trim() ? specKey(normalizeSpec(spec)) : '';
  return k ? (finished || []).filter(f => f.unit === 'kg' && specKey(normalizeSpec(f.spec || '')) === k).reduce((t, f) => t + (Number(f.qty) || 0), 0) : 0;
}
