/* =========================================================================
   COMMAND PALETTE (Ctrl/Cmd+K) — type to jump to any section instead of
   hunting through the grouped sidebar.
   ========================================================================= */
function CommandPalette({ onNavigate, onClose, items }) {
  const [query, setQuery] = useState('');
  const inputRef = useRef(null);
  useEffect(() => { inputRef.current?.focus(); }, []);
  const q = query.trim().toLowerCase();
  const navItems = items || NAV;
  const matches = q ? navItems.filter(n => (n.label + ' ' + (n.keywords || '')).toLowerCase().includes(q)) : navItems;

  return (
    <div style={{
      position: 'fixed', inset: 0, background: 'rgba(27,32,36,0.5)', zIndex: 100,
      display: 'flex', alignItems: 'flex-start', justifyContent: 'center', paddingTop: '12vh',
    }} onClick={onClose}>
      <div onClick={e => e.stopPropagation()} style={{
        width: '100%', maxWidth: 460, background: C.panel, borderRadius: 12,
        boxShadow: '0 20px 60px rgba(0,0,0,0.25)', overflow: 'hidden',
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '12px 16px', borderBottom: `1px solid ${C.borderSoft}` }}>
          <Search size={16} color={C.faint} />
          <input
            ref={inputRef}
            value={query}
            onChange={e => setQuery(e.target.value)}
            placeholder="Jump to a section…"
            style={{ flex: 1, border: 'none', outline: 'none', fontSize: 14.5, background: 'transparent', color: C.ink }}
          />
          <span style={{ fontSize: 11, color: C.faint, border: `1px solid ${C.border}`, borderRadius: 5, padding: '2px 6px' }}>Esc</span>
        </div>
        <div style={{ maxHeight: 360, overflowY: 'auto' }}>
          {matches.length === 0 ? (
            <div style={{ padding: 20 }}><EmptyState title="No matching section." /></div>
          ) : (
            matches.map(n => (
              <button key={n.key} type="button" onClick={() => onNavigate(n.key)} style={{
                width: '100%', display: 'flex', alignItems: 'center', gap: 12, padding: '11px 16px',
                border: 'none', background: 'transparent', cursor: 'pointer', textAlign: 'left', fontSize: 14,
              }} className="hover-lift">
                <n.icon size={16} color={C.subtext} />
                <span style={{ color: C.ink }}>{n.label}</span>
              </button>
            ))
          )}
        </div>
      </div>
    </div>
  );
}

/* =========================================================================
   NOTIFICATION BELL
   ========================================================================= */
function NotificationBell({ notifications, user, onMarkRead }) {
  const [open, setOpen] = useState(false);
  const mine = (notifications || []).filter(n => isNotificationForUser(n, user));
  const unreadCount = mine.filter(n => isNotificationUnread(n, user)).length;

  const markAllRead = () => {
    const unreadIds = mine.filter(n => isNotificationUnread(n, user)).map(n => n.id);
    if (unreadIds.length) onMarkRead(unreadIds);
  };

  return (
    <div style={{ position: 'relative' }}>
      <button type="button" onClick={() => { setOpen(v => !v); }} title="Notifications" style={{
        position: 'relative', display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
        width: 32, height: 32, borderRadius: 8, border: `1px solid ${C.border}`, background: C.panel, cursor: 'pointer',
      }}>
        <Bell size={17} color={C.subtext} />
        {unreadCount > 0 && (
          <span style={{
            position: 'absolute', top: -4, right: -4, minWidth: 16, height: 16, borderRadius: 999,
            background: C.red, color: '#fff', fontSize: 10, fontWeight: 700,
            display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '0 3px',
          }}>{unreadCount > 9 ? '9+' : unreadCount}</span>
        )}
      </button>
      {open && (
        <div style={{
          position: 'absolute', top: 40, right: 0, width: 320, maxHeight: 400, overflowY: 'auto',
          background: C.panel, border: `1px solid ${C.border}`, borderRadius: 10, boxShadow: '0 8px 24px rgba(0,0,0,0.12)', zIndex: 40,
        }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '10px 14px', borderBottom: `1px solid ${C.borderSoft}` }}>
            <span style={{ fontWeight: 700, fontSize: 13 }}>Notifications</span>
            {unreadCount > 0 && <button type="button" onClick={markAllRead} style={{ background: 'none', border: 'none', color: C.copper, fontSize: 12, fontWeight: 600, cursor: 'pointer' }}>Mark all read</button>}
          </div>
          {mine.length === 0 ? (
            <div style={{ padding: 20 }}><EmptyState title="Nothing yet." /></div>
          ) : (
            mine.slice(0, 40).map(n => (
              <div key={n.id} style={{
                padding: '10px 14px', borderBottom: `1px solid ${C.borderSoft}`,
                background: isNotificationUnread(n, user) ? C.copperFaint : 'transparent',
              }}>
                <p style={{ fontSize: 12.5, color: C.ink, margin: 0 }}>{n.message}</p>
                <p style={{ fontSize: 11, color: C.faint, margin: '4px 0 0' }}>{timeAgo(new Date(n.createdAt))}</p>
              </div>
            ))
          )}
        </div>
      )}
    </div>
  );
}

function Shell({
  tab, setTab, user, onLogout, lastSync, onRefresh, notifications, onMarkNotificationsRead,
  isOnline, pendingSyncCount, orders, settings, onUpdateSettings, onAddOrder, onAddMaintenance,
  pullRequests, children,
}) {
  const navGroups = NAV_GROUPS.map(g => ({ ...g, items: g.items.filter(n => !n.hidden && canSeeTab(user, n.key)) })).filter(g => g.items.length);
  const navItems = NAV.filter(n => canSeeTab(user, n.key)).map(n => Object.assign({}, n, { keywords: neelKeywords(n.key) }));
  const [paletteOpen, setPaletteOpen] = useState(false);
  const [leftMenuOpen, setLeftMenuOpen] = useState(false);
  const [userPopoverOpen, setUserPopoverOpen] = useState(false);
  const [settingsModalOpen, setSettingsModalOpen] = useState(false);
  const [settingsTab, setSettingsTab] = useState('account');
  const [, setSelectedTheme] = useState(null);
  const [quickAction, setQuickAction] = useState(null);

  useEffect(() => {
    const onKeyDown = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        setPaletteOpen(v => !v);
      }
      if (e.key === 'Escape') {
        setPaletteOpen(false);
        setLeftMenuOpen(false);
        setUserPopoverOpen(false);
        setSettingsModalOpen(false);
      }
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, []);

  const SPACES = [
    { key: 'launchpad', label: 'My Home', match: ['launchpad'] },
    { key: 'hub_qm', label: 'Neel : QM Apps', match: ['hub_qm', 'quality', 'qchold', 'qmlots', 'lab', 'spc', 'capa'] },
    { key: 'hub_sd', label: 'Neel : SD Apps', match: ['hub_sd', 'orders'] },
    { key: 'hub_ship', label: 'Shipping', match: ['hub_ship', 'dispatch'] },
    { key: 'invhub', label: 'Inventory Management', match: ['invhub', 'inventory', 'cyclecount', 'matdocs', 'bomMrp', 'migo', 'stocksingle', 'deadstock', 'slowmoving', 'analyzestock', 'purchaseorders', 'matprices', 'overduepo', 'conpurchase', 'constore', 'concost'] },
    { key: 'hub_prod', label: 'Production & Shop Floor', match: ['hub_prod', 'plan', 'stages', 'floor', 'dpr', 'schedule'] },
    { key: 'hub_maint', label: 'Maintenance & Tooling', match: ['hub_maint', 'maintenance', 'tooling', 'energy'] },
    ...(canSeeTab(user, 'master') ? [{ key: 'hub_admin', label: 'Administration', match: ['hub_admin', 'master', 'team', 'cost', 'reports', 'audit', 'trends', 'skills', 'kaizen'] }] : []),
  ].filter(s => canSeeTab(user, s.key));

  return (
    <div className="neel-root" style={{ minHeight: '100vh', background: 'var(--neel-page, #f5f6f7)', display: 'flex', flexDirection: 'column' }}>
      {/* Morning Horizon Top Shell Bar */}
      <header className="fiori-shellbar no-print" style={{
        display: 'flex', alignItems: 'center', gap: 12,
        padding: '0 16px', height: 48, background: '#ffffff', color: C.ink,
        borderBottom: `1px solid ${C.border}`, position: 'sticky', top: 0, zIndex: 50,
      }}>
        <button
          type="button"
          aria-label="Open navigation menu"
          data-testid="hamburger-btn"
          onClick={() => { setLeftMenuOpen(v => !v); setUserPopoverOpen(false); }}
          style={{
            width: 34, height: 34, borderRadius: 6, border: 'none',
            background: leftMenuOpen ? '#eaf3fc' : 'transparent', color: C.ink,
            cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center',
          }}
        >
          <div style={{ display: 'flex', flexDirection: 'column', gap: 4, width: 16 }}>
            <span style={{ height: 2, background: C.ink, borderRadius: 2 }} />
            <span style={{ height: 2, background: C.ink, borderRadius: 2 }} />
            <span style={{ height: 2, background: C.ink, borderRadius: 2 }} />
          </div>
        </button>

        <div
          onClick={() => setTab('launchpad')}
          style={{ display: 'flex', alignItems: 'center', gap: 8, cursor: 'pointer' }}
        >
          <IndigoBrandLogo size="shell" />
        </div>

        <button
          type="button"
          onClick={() => setLeftMenuOpen(v => !v)}
          style={{
            display: 'inline-flex', alignItems: 'center', gap: 4, background: 'none', border: 'none',
            fontSize: 13.5, fontWeight: 600, color: C.ink, cursor: 'pointer', padding: '4px 8px', borderRadius: 6,
          }}
        >
          <span>{tab === 'launchpad' ? 'Home' : (NAV.find(n => n.key === tab)?.label || 'Home')}</span>
          <ChevronDown size={14} color={C.subtext} />
        </button>

        <div style={{
          display: 'flex', alignItems: 'center', marginLeft: 'auto', marginRight: 8,
          border: '1px solid #89919a', borderRadius: 999, background: '#fff', height: 32,
          overflow: 'hidden', maxWidth: 380, width: '100%',
        }} className="shellbar-search">
          <div style={{
            display: 'flex', alignItems: 'center', gap: 6, padding: '0 12px', fontSize: 12.5,
            color: C.ink, borderRight: `1px solid ${C.border}`, height: '100%', background: '#f5f6f7',
          }}>
            <span>All</span>
            <ChevronDown size={12} color={C.subtext} />
          </div>
          <button
            type="button"
            onClick={() => setPaletteOpen(true)}
            style={{
              flex: 1, display: 'flex', alignItems: 'center', justifyContent: 'space-between',
              padding: '0 12px', border: 'none', background: 'transparent', color: C.subtext,
              fontSize: 12.5, cursor: 'pointer', fontStyle: 'italic', textAlign: 'left',
            }}
          >
            <span className="shellbar-search-text">Search or app launch</span>
            <Search size={14} color={C.ink} style={{ flexShrink: 0 }} />
          </button>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          {!isOnline ? (
            <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 11.5, color: C.red, fontWeight: 600, whiteSpace: 'nowrap' }}>
              <WifiOff size={14} /> Offline
            </span>
          ) : pendingSyncCount > 0 ? (
            <span style={{ fontSize: 11.5, color: C.amber, fontWeight: 600, whiteSpace: 'nowrap' }}>Syncing {pendingSyncCount}…</span>
          ) : (
            <span style={{ fontSize: 11.5, color: C.subtext, whiteSpace: 'nowrap' }} className="shellbar-sync">
              {timeAgo(lastSync)}
            </span>
          )}

          <NotificationBell notifications={notifications} user={user} onMarkRead={onMarkNotificationsRead} />

          <button
            type="button"
            onClick={onRefresh}
            title="Sync now"
            style={{
              width: 32, height: 32, borderRadius: 8, border: `1px solid ${C.border}`,
              background: '#fff', color: C.subtext, cursor: 'pointer',
              display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            }}
          ><RefreshCw size={15} /></button>

          <button
            type="button"
            aria-label="User menu"
            aria-expanded={userPopoverOpen}
            data-testid="user-avatar-btn"
            onClick={() => { setUserPopoverOpen(v => !v); setLeftMenuOpen(false); }}
            title={`${user.name} · ${roleLabel(user.role)}`}
            style={{
              width: 32, height: 32, borderRadius: '50%', background: '#d1e8ff', color: '#0854a0',
              border: '1px solid #a6d0f8', cursor: 'pointer', display: 'flex', alignItems: 'center',
              justifyContent: 'center', fontSize: 12, fontWeight: 700, flexShrink: 0,
            }}
          >{initials(user.name)}</button>
        </div>
      </header>

      {/* Secondary Horizontal Spaces Bar */}
      <div className="no-print" style={{
        display: 'flex', alignItems: 'center', gap: 22, padding: '0 20px', height: 38,
        background: '#ffffff', borderBottom: `1px solid ${C.border}`, overflowX: 'auto',
      }}>
        {SPACES.map(s => {
          const active = s.match.includes(tab);
          return (
            <button
              key={s.label}
              type="button"
              onClick={() => setTab(s.key)}
              style={{
                height: '100%', background: 'none', border: 'none', cursor: 'pointer',
                fontSize: 12.5, fontWeight: active ? 700 : 500,
                color: active ? 'var(--neel-accent, #0a6ed1)' : C.ink,
                borderBottom: active ? '2px solid var(--neel-accent, #0a6ed1)' : '2px solid transparent',
                whiteSpace: 'nowrap', padding: '0 2px',
              }}
            >{s.label}</button>
          );
        })}
      </div>

      {/* Left Hamburger Popover Navigation Drawer */}
      {leftMenuOpen && (
        <div
          data-testid="hamburger-backdrop"
          onClick={() => setLeftMenuOpen(false)}
          style={{ position: 'fixed', inset: 0, top: 48, background: 'rgba(0,0,0,0.18)', zIndex: 80 }}
        >
          <aside
            onClick={e => e.stopPropagation()}
            style={{
              width: 280, maxHeight: 'calc(100vh - 56px)', margin: '4px 0 0 8px',
              background: '#ffffff', borderRadius: 8, border: `1px solid ${C.border}`,
              boxShadow: '0 10px 28px rgba(0,0,0,0.18)', display: 'flex', flexDirection: 'column',
              overflow: 'hidden',
            }}
          >
            <div style={{ padding: 8, borderBottom: `1px solid ${C.borderSoft}` }}>
              <button
                type="button"
                onClick={() => { setTab('launchpad'); setLeftMenuOpen(false); }}
                style={{
                  width: '100%', display: 'flex', alignItems: 'center', gap: 10, padding: '9px 12px',
                  borderRadius: 6, border: tab === 'launchpad' ? '1px solid var(--neel-accent, #0a6ed1)' : '1px solid transparent',
                  background: tab === 'launchpad' ? 'var(--neel-accent-soft, #eaf3fc)' : 'transparent',
                  color: C.ink, fontSize: 13, fontWeight: 600, cursor: 'pointer', textAlign: 'left',
                }}
              >
                <LayoutDashboard size={16} color="#0a6ed1" /> My Home
              </button>
            </div>
            <div style={{ overflowY: 'auto', flex: 1, padding: '0 8px 8px' }}>
              {navGroups.map(group => (
                <div key={group.label} style={{ marginBottom: 8 }}>
                  <div style={{ padding: '6px 10px 3px', fontSize: 10.5, fontWeight: 700, color: C.faint, textTransform: 'uppercase' }}>
                    {group.label}
                  </div>
                  {group.items.map(n => {
                    const active = tab === n.key;
                    return (
                      <button
                        key={n.key}
                        type="button"
                        onClick={() => { setTab(n.key); setLeftMenuOpen(false); }}
                        style={{
                          width: '100%', display: 'flex', alignItems: 'center', gap: 10,
                          padding: '8px 10px', borderRadius: 6, border: 'none',
                          background: active ? 'var(--neel-accent-soft, #eaf3fc)' : 'transparent',
                          color: active ? '#0854a0' : C.ink,
                          fontSize: 13, fontWeight: active ? 700 : 500, cursor: 'pointer', textAlign: 'left',
                        }}
                      >
                        <n.icon size={15} color={active ? 'var(--neel-accent, #0a6ed1)' : C.subtext} />
                        {n.label}
                      </button>
                    );
                  })}
                </div>
              ))}
            </div>
          </aside>
        </div>
      )}

      {/* Top-Right User Profile Popover with Bottom-Right Sign Out Button */}
      {userPopoverOpen && (
        <div
          data-testid="user-panel-backdrop"
          onClick={() => setUserPopoverOpen(false)}
          style={{ position: 'fixed', inset: 0, top: 48, background: 'transparent', zIndex: 90 }}
        >
          <div
            role="dialog"
            aria-label="User account"
            data-testid="user-side-panel"
            onClick={e => e.stopPropagation()}
            style={{
              position: 'absolute', top: 6, right: 14, width: 290, background: '#ffffff',
              borderRadius: 10, border: `1px solid ${C.border}`,
              boxShadow: '0 12px 32px rgba(0,0,0,0.18)', overflow: 'hidden',
            }}
          >
            <div style={{ padding: '22px 20px 16px', textAlign: 'center', borderBottom: `1px solid ${C.borderSoft}` }}>
              <div style={{
                width: 68, height: 68, borderRadius: '50%', background: '#d1e8ff', color: '#0854a0',
                border: '2px solid var(--neel-accent, #0a6ed1)', margin: '0 auto 10px',
                display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 24, fontWeight: 700,
              }}>{initials(user.name)}</div>
              <div data-testid="user-panel-name" style={{ fontWeight: 700, fontSize: 15, color: C.ink }}>
                {user.name}
              </div>
              <div data-testid="user-panel-role" style={{ fontSize: 12.5, color: C.subtext, marginTop: 3 }}>
                {roleLabel(user.role)} · Plant {PLANT_CODE}
              </div>
            </div>

            <div style={{ padding: '6px 0' }}>
              {[
                { label: 'Settings', icon: SlidersHorizontal, onClick: () => { setUserPopoverOpen(false); setSettingsModalOpen(true); } },
                { label: 'Recent Activities', icon: History, onClick: () => { setUserPopoverOpen(false); setTab('stages'); } },
                { label: 'Frequently Used', icon: LayoutGrid, onClick: () => { setUserPopoverOpen(false); setTab('launchpad'); } },
                { label: 'App Finder', icon: Search, onClick: () => { setUserPopoverOpen(false); setPaletteOpen(true); } },
                { label: 'My Home Settings', icon: Wrench, onClick: () => { setUserPopoverOpen(false); setSettingsModalOpen(true); } },
              ].map(item => (
                <button
                  key={item.label}
                  type="button"
                  onClick={item.onClick}
                  style={{
                    width: '100%', display: 'flex', alignItems: 'center', gap: 12,
                    padding: '10px 18px', background: 'none', border: 'none',
                    fontSize: 13, color: C.ink, cursor: 'pointer', textAlign: 'left',
                  }}
                  className="hover-lift"
                >
                  <item.icon size={15} color={C.subtext} />
                  <span>{item.label}</span>
                </button>
              ))}
            </div>

            <div style={{
              padding: '10px 16px', borderTop: `1px solid ${C.borderSoft}`,
              display: 'flex', justifyContent: 'flex-end', background: '#fafbfc',
            }}>
              <button
                type="button"
                onClick={() => { setUserPopoverOpen(false); onLogout(); }}
                style={{
                  display: 'inline-flex', alignItems: 'center', gap: 6, background: 'none',
                  border: 'none', color: 'var(--neel-accent, #0a6ed1)', fontSize: 13, fontWeight: 600,
                  cursor: 'pointer', padding: '6px 10px', borderRadius: 6,
                }}
              >
                <LogOut size={15} /> Sign Out
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Two-Pane Settings Modal */}
      {settingsModalOpen && (
        <div
          onClick={() => setSettingsModalOpen(false)}
          style={{
            position: 'fixed', inset: 0, background: 'rgba(27,32,36,0.45)', zIndex: 110,
            display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 20,
          }}
        >
          <div
            onClick={e => e.stopPropagation()}
            style={{
              width: '100%', maxWidth: 680, minHeight: 420, background: '#fff',
              borderRadius: 10, border: `1px solid ${C.border}`,
              boxShadow: '0 20px 50px rgba(0,0,0,0.25)', display: 'flex', flexDirection: 'column', overflow: 'hidden',
            }}
          >
            <div style={{ padding: '14px 20px', borderBottom: `1px solid ${C.border}`, fontWeight: 700, fontSize: 15 }}>
              Settings
            </div>
            <div style={{ display: 'flex', flex: 1, minHeight: 320 }}>
              <div style={{ width: 220, borderRight: `1px solid ${C.border}`, background: '#f7f8f9' }}>
                {[
                  { key: 'account', title: 'User Account', sub: user.name },
                  { key: 'appearance', title: 'Appearance', sub: 'Morning Horizon' },
                  { key: 'region', title: 'Language and Region', sub: 'English (India)' },
                  { key: 'defaults', title: 'Default Values', sub: `Plant ${PLANT_CODE}` },
                ].map(item => {
                  const active = settingsTab === item.key;
                  return (
                    <button
                      key={item.key}
                      type="button"
                      onClick={() => setSettingsTab(item.key)}
                      style={{
                        width: '100%', padding: '12px 16px', textAlign: 'left', border: 'none',
                        borderBottom: `1px solid ${C.borderSoft}`, cursor: 'pointer',
                        background: active ? 'var(--neel-accent-soft, #eaf3fc)' : 'transparent',
                        borderLeft: active ? '3px solid var(--neel-accent, #0a6ed1)' : '3px solid transparent',
                      }}
                    >
                      <div style={{ fontSize: 13, fontWeight: 600, color: C.ink }}>{item.title}</div>
                      <div style={{ fontSize: 11.5, color: C.subtext, marginTop: 2 }}>{item.sub}</div>
                    </button>
                  );
                })}
              </div>
              <div style={{ flex: 1, padding: 24 }}>
                {settingsTab === 'account' && (
                  <div>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 20 }}>
                      <Users size={22} color={C.ink} />
                      <h3 style={{ fontSize: 17, fontWeight: 700, margin: 0 }}>{user.name}</h3>
                    </div>
                    <div style={{
                      background: '#f8f9fa', borderRadius: 8, padding: 18,
                      display: 'grid', gridTemplateColumns: '110px 1fr', rowGap: 10, fontSize: 13,
                    }}>
                      <span style={{ color: C.subtext, textAlign: 'right', paddingRight: 14 }}>Name:</span>
                      <span style={{ fontWeight: 600 }}>{user.name}</span>
                      <span style={{ color: C.subtext, textAlign: 'right', paddingRight: 14 }}>Role:</span>
                      <span style={{ fontWeight: 600 }}>{roleLabel(user.role)}</span>
                      <span style={{ color: C.subtext, textAlign: 'right', paddingRight: 14 }}>Plant:</span>
                      <span style={{ fontWeight: 600 }}>{PLANT_NAME} ({PLANT_CODE})</span>
                      <span style={{ color: C.subtext, textAlign: 'right', paddingRight: 14 }}>Server:</span>
                      <span className="font-mono" style={{ fontSize: 12 }}>{typeof window !== 'undefined' ? window.location.host : 'neel-suite.local'}</span>
                    </div>
                  </div>
                )}
                {settingsTab === 'appearance' && (
                  <div>
                    <h3 style={{ fontSize: 16, fontWeight: 700, marginTop: 0 }}>Theme</h3>
                    <p style={{ fontSize: 13, color: C.subtext }}>Choose a visual theme for your workspace (applies live across banners, shell & cards):
                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, minmax(0, 1fr))', gap: 8, marginTop: 10, maxHeight: 245, overflowY: 'auto', overflowX: 'hidden', paddingRight: 2 }}>
                      {Object.values(NEEL_WORKSPACE_THEMES).map(t => {
                        const currentTheme = localStorage.getItem('neel_active_theme') || 'morning_horizon';
                        const isSelected = currentTheme === t.id;
                        return (
                          <div
                            key={t.id}
                            onClick={() => {
                              applyThemeToDocument(t.id);
                              // Force immediate react state update in settings modal if available
                              try { setSelectedTheme(t.id); } catch {}
                              window.dispatchEvent(new CustomEvent('neel-theme-changed', { detail: t.id }));
                            }}
                            style={{
                              display: 'flex',
                              alignItems: 'center',
                              justifyContent: 'space-between',
                              gap: 8,
                              padding: '9px 11px',
                              borderRadius: 8,
                              border: isSelected ? `2px solid ${t.accent}` : '1px solid #d9e0e6',
                              background: isSelected ? '#f0f7ff' : '#ffffff',
                              cursor: 'pointer',
                              transition: 'all 0.15s ease',
                            }}
                          >
                            <div style={{ display: 'flex', alignItems: 'center', gap: 9, minWidth: 0 }}>
                              <div style={{ width: 26, height: 26, borderRadius: 6, background: t.swatch, flexShrink: 0, boxShadow: 'inset 0 0 0 1px rgba(0,0,0,0.12)' }} />
                              <div style={{ minWidth: 0 }}>
                                <div style={{ fontSize: 12.5, fontWeight: 700, color: '#1d2d3e', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{t.name}</div>
                                <div style={{ fontSize: 10.5, color: '#556b82', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{t.shortDesc}</div>
                              </div>
                            </div>
                            <span style={{
                              fontSize: 10.5,
                              fontWeight: 700,
                              whiteSpace: 'nowrap',
                              padding: '3px 8px',
                              borderRadius: 999,
                              background: isSelected ? t.accent : '#f1f5f9',
                              color: isSelected ? '#fff' : '#475569',
                              flexShrink: 0,
                            }}>
                              {isSelected ? '✓ Active' : 'Use'}
                            </span>
                          </div>
                        );
                      })}
                    </div></p>
                  </div>
                )}
                {settingsTab === 'region' && (
                  <div>
                    <h3 style={{ fontSize: 16, fontWeight: 700, marginTop: 0 }}>Language &amp; Region</h3>
                    <p style={{ fontSize: 13, color: C.subtext }}>Date format: YYYY-MM-DD · Currency: INR (₹) / USD ($)</p>
                  </div>
                )}
                {settingsTab === 'defaults' && (
                  <div>
                    <h3 style={{ fontSize: 16, fontWeight: 700, marginTop: 0 }}>Default Plant Values</h3>
                    <p style={{ fontSize: 13, color: C.subtext }}>Plant Code: {PLANT_CODE} · Default UOM: kg / MT</p>
                  </div>
                )}
              </div>
            </div>
            <div style={{
              padding: '10px 16px', borderTop: `1px solid ${C.border}`,
              display: 'flex', justifyContent: 'flex-end', gap: 8, background: '#fafbfc',
            }}>
              <Button onClick={() => setSettingsModalOpen(false)}>Save</Button>
              <Button variant="ghost" onClick={() => setSettingsModalOpen(false)}>Cancel</Button>
            </div>
          </div>
        </div>
      )}

      {paletteOpen && <CommandPalette items={navItems} onNavigate={(key) => { setTab(key); setPaletteOpen(false); }} onClose={() => setPaletteOpen(false)} />}

      <main className="main-pad" style={{ padding: '20px 28px', flex: 1, minWidth: 0 }}>
        {React.Children.map(children, child =>
          React.isValidElement(child) && child.type === HomePage
            ? React.cloneElement(child, { onOpenSettings: () => setSettingsModalOpen(true), pullRequests })
            : child
        )}
      </main>
    </div>
  );
}

/* =========================================================================
   ROOT APP
   ========================================================================= */
export default function App() {
  const [user, setUser] = useState(null);
  const [userLoading, setUserLoading] = useState(true);
  const [tab, setTab] = useState('launchpad');
  useEffect(() => { if (user && !canSeeTab(user, tab)) setTab(firstVisibleTab(user)); });
  useEffect(() => { if (user && canSeeTab(user, 'launchpad')) setTab('launchpad'); }, [user && user.name]);
  // If the person arrived via a password-reset email link, Supabase puts
  // #access_token=...&type=recovery in the URL. Detect that once, up front,
  // so we can show the "set new password" screen instead of the normal
  // login/app flow.
  const [recoveryToken] = useState(() => {
    if (typeof window === 'undefined') return null;
    const hash = window.location.hash || '';
    const params = new URLSearchParams(hash.replace(/^#/, ''));
    return params.get('type') === 'recovery' ? params.get('access_token') : null;
  });
  // A customer opening a shared tracking link (?track=<orderId>) should see
  // just their order's status -- no login, no plant data, nothing else.
  // Checked before any auth state loads, so it never even touches the
  // sign-in screen.
  const [trackingCode] = useState(() => {
    if (typeof window === 'undefined') return null;
    return new URLSearchParams(window.location.search).get('track');
  });

  const [orders, setOrders] = useState([]);
  const [dailyPlans, setDailyPlans] = useState({});
  const [batches, setBatches] = useState([]);
  const batchIndex = useMemo(() => Object.fromEntries(batches.map(x => [x.id, x])), [batches]);
  const [rawItems, setRawItems] = useState([]);
  const [finishedItems, setFinishedItems] = useState([]);
  const [downtimeLogs, setDowntimeLogs] = useState({});
  const [settings, setSettings] = useState({ monthlyTargetMT: 3000 });
  const [machines, setMachines] = useState(DEFAULT_MACHINES);
  const [spinnerPlans, setSpinnerPlans] = useState({});
  const [dprEntries, setDprEntries] = useState({});
  const [machineProd, setMachineProd] = useState({});
  const [dq, setDq] = useState({});
  const [wipBuffer, setWipBuffer] = useState({ limits: {}, days: {} });
  const [planMeta, setPlanMeta] = useState({});
  const [dispatchPlans, setDispatchPlans] = useState({});
  const [annealCharges, setAnnealCharges] = useState([]);
  const [pullRequests, setPullRequests] = useState([]);
  const [deliveries, setDeliveries] = useState([]);
  const [heats, setHeats] = useState([]);
  const [processPlans, setProcessPlans] = useState({});
  const [dprClosed, setDprClosed] = useState({});
  const [costData, setCostData] = useState({});
  const [master, setMaster] = useState({ version: 1, lists: {}, history: [], access: {}, customerLinks: {} });
  const masterRefLists = useRef({});
  const masterRefLinks = useRef({});
  const masterRefData = useRef({});
  const [targetActual, setTargetActual] = useState({});
  const [userRoles, setUserRoles] = useState({});
  // a role changed in Team & Roles reaches a person who is already signed in at the next sync
  useEffect(() => {
    if (!user || !userRoles) return;
    const assigned = userRoles[String(user.name || '').toLowerCase()];
    if (assigned && assigned !== user.role) setUser(prev => { if (!prev) return prev; const next = { ...prev, role: assigned }; savePersonal(KEYS.user, next); return next; });
  }, [userRoles]);
  const [shiftNames, setShiftNames] = useState({});
  const [notifications, setNotifications] = useState([]);
  const [maintenanceLogs, setMaintenanceLogs] = useState([]);
  const [rawConsumption, setRawConsumption] = useState([]);
  const [capaRecords, setCapaRecords] = useState([]);
  const [skillMatrix, setSkillMatrix] = useState({});
  const [kaizenIdeas, setKaizenIdeas] = useState([]);
  const [toolingItems, setToolingItems] = useState(DEFAULT_DIES);
  const toolingRef = useRef(DEFAULT_DIES); toolingRef.current = toolingItems;   // latest tooling list for handlers that must not wait for a re-render
  const [energyLogs, setEnergyLogs] = useState([]);
  const [labResults, setLabResults] = useState([]);
  const labRef = useRef([]); labRef.current = labResults;
  const [cycleCounts, setCycleCounts] = useState([]);
  const ccRef = useRef([]); ccRef.current = cycleCounts;
  const [pmTasks, setPmTasks] = useState([]);
  const [bom, setBom] = useState([]);
  const [matDocs, setMatDocs] = useState([]);
  const [numberRanges, setNumberRanges] = useState({});
  const [dataLoading, setDataLoading] = useState(true);

  /* NEEL_PHASE3_V1 - purchase orders, per-user preferences, alerts */
  const [purchaseOrders, setPurchaseOrders] = useState([]);
  const [userPrefsAll, setUserPrefsAll] = useState({});
  const poRef = useRef([]); poRef.current = purchaseOrders;
  const prefsRef = useRef({}); prefsRef.current = userPrefsAll;
  const alertsSentRef = useRef({});
  const prefsTimer = useRef(null);
  const saveUserPref = (patch, delayMs) => {
    if (!user) return;
    const k = String(user.name || '').toLowerCase(); if (!k) return;
    const mine = Object.assign({}, prefsRef.current[k] || {}, patch);
    const nextAll = Object.assign({}, prefsRef.current, { [k]: mine });
    prefsRef.current = nextAll; setUserPrefsAll(nextAll);
    if (delayMs) {
      clearTimeout(prefsTimer.current);
      prefsTimer.current = setTimeout(() => saveShared(NEEL_PREFS_PREFIX + k, prefsRef.current[k]), delayMs);
    } else saveShared(NEEL_PREFS_PREFIX + k, mine);
  };
  useEffect(() => {
    if (dataLoading || !user || !tab || tab === 'launchpad' || SPACE_HUBS[tab]) return;
    const k = String(user.name || '').toLowerCase(); if (!k) return;
    const usage = (prefsRef.current[k] || {}).usage || { counts: {}, recent: [] };
    saveUserPref({ usage: { counts: Object.assign({}, usage.counts, { [tab]: ((usage.counts || {})[tab] || 0) + 1 }), recent: [tab].concat((usage.recent || []).filter(t => t !== tab)).slice(0, 12) } }, 5000);
  }, [tab, dataLoading, user && user.name]);
  useEffect(() => {
    if (dataLoading || !user || !NEEL_ALERT_WEBHOOK_URL || !canSeeTab(user, 'inventory')) return;
    const today = new Date().toISOString().slice(0, 10);
    const sent = alertsSentRef.current || {};
    const fresh = [];
    (rawItems || []).forEach(r => {
      const key = 'low:' + r.id + ':' + today;
      if (Number(r.reorderLevel) >= 0 && Number(r.qty) <= Number(r.reorderLevel) && !sent[key]) fresh.push({ key, type: 'low_stock', data: { material: r.name, onHand: r.qty, unit: r.unit, reorderLevel: r.reorderLevel } });
    });
    (purchaseOrders || []).forEach(p => {
      const key = 'po:' + p.poNumber + ':' + today;
      if (poIsOverdue(p) && !sent[key]) fresh.push({ key, type: 'po_overdue', data: { po: p.poNumber, vendor: p.vendor, deliveryDate: p.deliveryDate } });
    });
    if (!fresh.length) return;
    const next = {};
    Object.keys(sent).forEach(k2 => { if (sent[k2] === today) next[k2] = today; });
    fresh.forEach(f => { next[f.key] = today; });
    alertsSentRef.current = next; saveShared(KEYS.alertsSent, next);
    fresh.forEach(f => triggerAutomatedAlert(f.type, f.data));
  }, [rawItems, purchaseOrders, dataLoading]);
  const [lastSync, setLastSync] = useState(null);
  useEffect(() => {
    if (!user || dataLoading) return undefined;
    runAutoClose();
    const t = setInterval(() => runAutoClose(), 60000);
    return () => clearInterval(t);
  }, [user, dataLoading, lastSync]);

  useEffect(() => {
    (async () => {
      const u = await loadPersonal(KEYS.user, null);
      if (u) setAuthSession(u.accessToken, u.refreshToken, u.expiresAt ? Math.max(0, (u.expiresAt - Date.now()) / 1000) : 0);
      setUser(u);
      setUserLoading(false);
    })();
  }, []);

  // Keep the Supabase session token fresh for the whole shift. Access tokens
  // expire in ~1 hour by default; without this, saves would start silently
  // failing partway through a long shift even though the person never logged
  // out. Also persist the refreshed tokens so a page reload doesn't force a
  // re-login just because the old access token in localStorage had expired.
  useEffect(() => {
    onTokenRefreshed = (accessToken, refreshToken, expiresIn) => {
      setUser(prev => {
        if (!prev) return prev;
        const next = { ...prev, accessToken, refreshToken, expiresAt: Date.now() + (Number(expiresIn) || 3600) * 1000 };
        savePersonal(KEYS.user, next);
        return next;
      });
    };
    return () => { onTokenRefreshed = null; };
  }, []);
  useEffect(() => {
    if (!user) return;
    const t = setInterval(() => { ensureFreshToken(); }, 45 * 60 * 1000); // every 45 min
    return () => clearInterval(t);
  }, [user]);

  const loadAll = useCallback(async () => {
    const bulk = await loadAllSharedBulk();
    if (!bulk) {
      setDataLoading(false);
      return;
    }
    const pick = (k, fb) => (bulk[k] !== undefined ? bulk[k] : fb);
    const o = pick(KEYS.orders, []);
    const dp = pick(KEYS.plans, {});
    const b = pick(KEYS.batches, []);
    const ri = pick(KEYS.raw, []);
    const fi = pick(KEYS.finished, []);
    const dt = pick(KEYS.downtime, {});
    const st = pick(KEYS.settings, { monthlyTargetMT: 3000 });
    const mc = pick(KEYS.machines, DEFAULT_MACHINES);
    const sp = pick(KEYS.spinnerPlans, {});
    const de = pick(KEYS.dprEntries, {});
    const mp = pick(KEYS.dprMachineProd, {});
    const dqv = pick(KEYS.dprDowntimeQuality, {});
    const wb = pick(KEYS.dprWipBuffer, { limits: {}, days: {} });
    const ta = pick(KEYS.dprTargetActual, {});
    const ur = pick(KEYS.userRoles, {});
    const sn = pick(KEYS.shiftNames, {});
    const nt = pick(KEYS.notifications, []);
    const ml = pick(KEYS.maintenance, []);
    const rc = pick(KEYS.rawConsumption, []);
    const cr = pick(KEYS.capa, []);
    const pm = pick(KEYS.pmTasks, []);
    const sk = pick(KEYS.skills, {});
    const kz = pick(KEYS.kaizen, []);
    const bm = pick(KEYS.bom, []);
    const md = pick(KEYS.matDocs, []);
    const poList = pick(KEYS.purchaseOrders, []);
    const alsent = pick(KEYS.alertsSent, {});
    const upAll = {};
    Object.keys(bulk).forEach(k => { if (k.indexOf(NEEL_PREFS_PREFIX) === 0) upAll[k.slice(NEEL_PREFS_PREFIX.length)] = bulk[k]; });
    const nr = pick(KEYS.numberRanges, {});
    const pmeta = pick(KEYS.planMeta, {});
    const dpl = pick(KEYS.dispatchPlans, {});
    const ac = pick(KEYS.annealCharges, []);
    const prq = pick(KEYS.pullRequests, []);
    const dlv = pick(KEYS.deliveries, []);
    const cop = pick(KEYS.costOfProduction, {});
    const hts = pick(KEYS.heats, []);
    const mst = pick(KEYS.master, { version: 1, lists: {}, history: [] });
    const ppl = pick(KEYS.processPlans, {});
    const dcl = pick(KEYS.dprClosed, {});
    const td = pick(KEYS.tooling, DEFAULT_DIES);
    const el = pick(KEYS.machineEnergy, []);
    const lb = pick(KEYS.lab, []);
    const cc = pick(KEYS.cycleCounts, []);
    if (!shouldSkipLoad(KEYS.tooling)) setToolingItems(Array.isArray(td) ? td : DEFAULT_DIES);
    if (!shouldSkipLoad(KEYS.machineEnergy)) setEnergyLogs(Array.isArray(el) ? el : []);
    if (!shouldSkipLoad(KEYS.lab)) setLabResults(Array.isArray(lb) ? lb : []);
    if (!shouldSkipLoad(KEYS.cycleCounts)) setCycleCounts(Array.isArray(cc) ? cc : []);
    if (!shouldSkipLoad(KEYS.orders)) setOrders(o);
    if (!shouldSkipLoad(KEYS.plans)) setDailyPlans(dp);
    if (!shouldSkipLoad(KEYS.batches)) setBatches(b);
    if (!shouldSkipLoad(KEYS.raw)) setRawItems(ri);
    if (!shouldSkipLoad(KEYS.finished)) setFinishedItems(fi);
    if (!shouldSkipLoad(KEYS.downtime)) setDowntimeLogs(dt);
    if (!shouldSkipLoad(KEYS.settings)) setSettings(st);
    if (!shouldSkipLoad(KEYS.machines)) setMachines(allMachines(mc));
    if (!shouldSkipLoad(KEYS.spinnerPlans)) setSpinnerPlans(sp);
    if (!shouldSkipLoad(KEYS.dprEntries)) setDprEntries(de);
    if (!shouldSkipLoad(KEYS.dprMachineProd)) setMachineProd(mp);
    if (!shouldSkipLoad(KEYS.dprDowntimeQuality)) setDq(dqv);
    if (!shouldSkipLoad(KEYS.dprWipBuffer)) setWipBuffer({ limits: {}, days: {}, ...(wb || {}) });
    if (!shouldSkipLoad(KEYS.dprTargetActual)) setTargetActual(ta);
    if (!shouldSkipLoad(KEYS.userRoles)) setUserRoles(ur);
    if (!shouldSkipLoad(KEYS.shiftNames)) setShiftNames(sn);
    if (!shouldSkipLoad(KEYS.notifications)) setNotifications(nt);
    if (!shouldSkipLoad(KEYS.maintenance)) setMaintenanceLogs(ml);
    if (!shouldSkipLoad(KEYS.rawConsumption)) setRawConsumption(rc);
    if (!shouldSkipLoad(KEYS.capa)) setCapaRecords(cr);
    if (!shouldSkipLoad(KEYS.pmTasks)) setPmTasks(pm);
    if (!shouldSkipLoad(KEYS.skills)) setSkillMatrix(sk);
    if (!shouldSkipLoad(KEYS.kaizen)) setKaizenIdeas(kz);
    if (!shouldSkipLoad(KEYS.bom)) setBom(bm);
    if (!shouldSkipLoad(KEYS.matDocs)) setMatDocs(md);
    if (!shouldSkipLoad(KEYS.purchaseOrders)) setPurchaseOrders(poList);
    alertsSentRef.current = alsent;
    setUserPrefsAll(upAll);
    if (!shouldSkipLoad(KEYS.numberRanges)) setNumberRanges(nr);
    if (!shouldSkipLoad(KEYS.planMeta)) setPlanMeta(pmeta);
    if (!shouldSkipLoad(KEYS.dispatchPlans)) setDispatchPlans(dpl);
    if (!shouldSkipLoad(KEYS.annealCharges)) setAnnealCharges(ac);
    if (!shouldSkipLoad(KEYS.pullRequests)) setPullRequests(prq);
    if (!shouldSkipLoad(KEYS.deliveries)) setDeliveries(dlv);
    if (!shouldSkipLoad(KEYS.costOfProduction)) setCostData(cop);
    if (!shouldSkipLoad(KEYS.heats)) setHeats(hts);
    if (!shouldSkipLoad(KEYS.master)) setMaster(sanitizeMaster(mst));
    if (!shouldSkipLoad(KEYS.processPlans)) setProcessPlans(ppl && typeof ppl === 'object' ? ppl : {});
    if (!shouldSkipLoad(KEYS.dprClosed)) setDprClosed(dcl && typeof dcl === 'object' ? dcl : {});
    setLastSync(new Date());
    setDataLoading(false);
  }, []);

  useEffect(() => { if (user) loadAll(); }, [user, loadAll]);
  // tooling register + machine-wise energy readings (loaded separately from the main sync)
  useEffect(() => {
    if (!user) return;
    let cancelled = false;
    (async () => {
      const [td, el, lb, cc] = await Promise.all([loadShared(KEYS.tooling, DEFAULT_DIES), loadShared(KEYS.machineEnergy, []), loadShared(KEYS.lab, []), loadShared(KEYS.cycleCounts, [])]);
      if (cancelled) return;
      if (!shouldSkipLoad(KEYS.tooling)) setToolingItems(Array.isArray(td) ? td : DEFAULT_DIES);
      if (!shouldSkipLoad(KEYS.machineEnergy)) setEnergyLogs(Array.isArray(el) ? el : []);
      if (!shouldSkipLoad(KEYS.lab)) setLabResults(Array.isArray(lb) ? lb : []);
      if (!shouldSkipLoad(KEYS.cycleCounts)) setCycleCounts(Array.isArray(cc) ? cc : []);
    })();
    return () => { cancelled = true; };
  }, [user]);

  useEffect(() => {
    if (!user) return;
    const t = setInterval(loadAll, 25000);
    return () => clearInterval(t);
  }, [user, loadAll]);

  const handleSetUser = (u) => {
    setUser(u); // enter immediately; sync identity to storage in the background
    savePersonal(KEYS.user, u);
  };
  const handleConfirmActing = (name) => {
    setUser(prev => {
      const next = { ...prev, name, actingAsConfirmed: true };
      savePersonal(KEYS.user, next);
      return next;
    });
  };
  const handleLogout = () => {
    setUser(null);
    deletePersonal(KEYS.user);
    setAuthSession(null, null);
  };

  // Real connectivity tracking -- the offline queue (writes saved to
  // localStorage when a save fails) is only useful if something actually
  // retries it and shows its state. onQueueChanged fires instantly whenever
  // a write gets queued or clears (see queueOfflineWrite/clearOfflineWrite),
  // so the header count updates the moment something saves or fails, not on
  // the next poll.
const [isOnline, setIsOnline] = useState(() => (typeof navigator === 'undefined' ? true : navigator.onLine));
  const [pendingSyncCount, setPendingSyncCount] = useState(() => totalPendingOfflineCount());
  const [loadProblem, setLoadProblem] = useState(0);
  useEffect(() => { onLoadProblem = (n) => setLoadProblem(n); return () => { onLoadProblem = null; }; }, []);

  useEffect(() => {
    onQueueChanged = (count) => setPendingSyncCount(count);
    
    const onOnline = async () => {
      setIsOnline(true);
      await Promise.all([flushOfflineQueue(), flushOfflineActions()]);
    };
    
    const onOffline = () => setIsOnline(false);
    
    window.addEventListener('online', onOnline);
    window.addEventListener('offline', onOffline);
    
    if (navigator.onLine) { 
      flushOfflineQueue(); 
      flushOfflineActions(); 
    }

    return () => {
      window.removeEventListener('online', onOnline);
      window.removeEventListener('offline', onOffline);
    };
  }, []);

  // Auto-logout after inactivity, but only for shared department logins --
  // these often sit on a shop-floor terminal anyone can walk up to, so an
  // idle shared session left signed in is a real risk. Individual accounts
  // (Sales, Admin, Manager) are exempt since those are personal devices/desks.
  useEffect(() => {
    if (!user || !SHARED_LOGIN_ROLES.includes(user.role)) return;
    const IDLE_LIMIT_MS = 15 * 60 * 1000; // 15 minutes
    let timer;
    const reset = () => {
      clearTimeout(timer);
      timer = setTimeout(() => { handleLogout(); }, IDLE_LIMIT_MS);
    };
    const events = ['mousedown', 'mousemove', 'keydown', 'touchstart', 'scroll'];
    events.forEach(ev => window.addEventListener(ev, reset));
    reset();
    return () => { clearTimeout(timer); events.forEach(ev => window.removeEventListener(ev, reset)); };
  }, [user]);

  // ---- Latest-state refs ----
  // Handlers that touch several records at once (a delivery updates batches,
  // an order, stock and a document number) read the latest committed value
  // from these refs and write it back through the commit* helpers, so two
  // changes in the same click can never overwrite each other with stale state.
  const ordersRef = useRef([]); ordersRef.current = orders;
  const batchesRef = useRef([]); batchesRef.current = batches;
  const deliveriesRef = useRef([]); deliveriesRef.current = deliveries;
  const heatsRef = useRef([]); heatsRef.current = heats;
  const chargesRef = useRef([]); chargesRef.current = annealCharges;
  const requestsRef = useRef([]); requestsRef.current = pullRequests;
  const notificationsRef = useRef([]); notificationsRef.current = notifications;
  const rangesRef = useRef({}); rangesRef.current = numberRanges;
  const rawItemsRef = useRef([]); rawItemsRef.current = rawItems;
  const finishedRef = useRef([]); finishedRef.current = finishedItems;
  const spinnerPlansRef = useRef({}); spinnerPlansRef.current = spinnerPlans;
  const planMetaRef = useRef({}); planMetaRef.current = planMeta;
  const dispatchPlansRef = useRef({}); dispatchPlansRef.current = dispatchPlans;
  const commitOrders = (next) => { ordersRef.current = next; setOrders(next); saveShared(KEYS.orders, next); };
  const commitBatches = (next) => { batchesRef.current = next; setBatches(next); saveShared(KEYS.batches, next); const linkedOrderIds = [...new Set((next || []).filter(b => b.orderId && b.productionOrderNo).map(b => b.orderId))]; if (linkedOrderIds.length) { const current = ordersRef.current || []; let changed = false; const nextOrders = current.map(o => { if (linkedOrderIds.includes(o.id) && o.status === 'New') { changed = true; return { ...o, status: 'In Production' }; } return o; }); if (changed) { ordersRef.current = nextOrders; setOrders(nextOrders); saveShared(KEYS.orders, nextOrders); nextOrders.filter(o => linkedOrderIds.includes(o.id) && o.status === 'In Production').forEach(o => syncOrderTracking(o)); } } };
  const commitDeliveries = (next) => { deliveriesRef.current = next; setDeliveries(next); saveShared(KEYS.deliveries, next); };
  const commitHeats = (next) => { heatsRef.current = next; setHeats(next); saveShared(KEYS.heats, next); };
  const commitCharges = (next) => { chargesRef.current = next; setAnnealCharges(next); saveShared(KEYS.annealCharges, next); };
  const commitRequests = (next) => { requestsRef.current = next; setPullRequests(next); saveShared(KEYS.pullRequests, next); };
  const commitSpinnerPlans = (next) => { spinnerPlansRef.current = next; setSpinnerPlans(next); saveShared(KEYS.spinnerPlans, next); };
  const commitPlanMeta = (next) => { planMetaRef.current = next; setPlanMeta(next); saveShared(KEYS.planMeta, next); };
  const commitDispatchPlans = (next) => { dispatchPlansRef.current = next; setDispatchPlans(next); saveShared(KEYS.dispatchPlans, next); };

  // ---- Orders ----
  // Draws the next number from a SAP-style number range and persists the
  // updated counter, so document numbers are plant-wide and sequential.
  // Synchronous: reads/writes the ref, so several numbers drawn inside one
  // handler (e.g. a delivery plus its goods-issue documents) are all distinct.
  const drawDocNumber = (type) => {
    const { number, nextRanges } = nextDocNumber(rangesRef.current, type);
    rangesRef.current = nextRanges;
    setNumberRanges(nextRanges);
    saveShared(KEYS.numberRanges, nextRanges);
    return number;
  };

  // In-app + WhatsApp-bound notification (same two channels existing events use).
  // a message that names the customer only for the roles that may see customers
  const notifyRolesMasked = (roles, make, type, payload) => {
    const groups = new Map();
    roles.forEach(r => { const see = canDo(r, 'customer.see'); if (!groups.has(see)) groups.set(see, []); groups.get(see).push(r); });
    groups.forEach((rs, see) => notifyRoles(rs, make(see), type, payload));
  };
  const notifyRoles = (targetRoles, message, type, payload) => {
    const next = pushNotification(notificationsRef.current, { message, targetRoles });
    notificationsRef.current = next;
    setNotifications(next);
    saveShared(KEYS.notifications, next);
    supabaseNotify({ type, targetDepartment: targetRoles.join(','), message, payload: payload || null, createdBy: user?.name });
  };

  // Saving an order is refused unless every required field is present -- in particular the
  // delivery date -- whichever screen submits it. Order numbers are generated here, so they
  // cannot be skipped or typed by hand.
  const addOrder = (order) => {
    if (!canEditOrders(user.role)) return { error: 'You do not have access to add orders.' };
    const input = { ...order, orderDate: order.orderDate || todayKey() };
    const v = validateOrderInput(input);
    if (!v.valid) return { error: Object.values(v.errors)[0], errors: v.errors };
    const gen = orderNoFor(rangesRef.current, input.productType, input.orderDate, ordersRef.current);
    rangesRef.current = gen.nextRanges;
    setNumberRanges(gen.nextRanges);
    saveShared(KEYS.numberRanges, gen.nextRanges);
    const salesOrderNo = drawDocNumber('salesOrder');
    order = {
      ...input, customer: input.customer.trim(), location: input.location.trim(), specification: input.specification.trim(),
      sizeMm: v.size.mm, sizeDisplay: v.size.display, sizeEntered: v.size.originalDisplay,
      thicknessMm: v.thickness.mm, thicknessAuto: v.thickness.auto, weightPerM: v.thickness.weightKgPerM ?? null,
      spec: buildDimSpec(v.size.mm, v.thickness.mm), orderNo: gen.orderNo, salesOrderNo, dispatchedQty: 0,
    };
    commitOrders([...ordersRef.current, order]);
    const msg = `New ${order.productType} order ${order.orderNo} (SO ${salesOrderNo}): ${order.customer}, ${order.location} — ${orderTitle(order)}, ${Number(order.qty).toLocaleString()} ${order.unit}, delivery ${order.dueDate}. Booked by ${order.salesperson}.`;
    setNotifications(prev => { const next = pushNotification(prev, { message: msg, targetRoles: ['Production', 'Packing', 'Dispatch'] }); saveShared(KEYS.notifications, next); return next; });
    supabaseNotify({ type: 'new_order', targetDepartment: 'Production,Packing,Dispatch', message: msg, payload: order, createdBy: order.salesperson });
    syncOrderTracking(order);
    logAudit({ actor: user.name, action: 'create', entityType: 'order', entityId: order.id, details: { orderNo: order.orderNo, customer: order.customer, qty: order.qty, unit: order.unit } });
    return { ok: true, orderNo: order.orderNo };
  };
  const updateOrderStatus = (id, status) => {
    const next = ordersRef.current.map(o => o.id === id ? { ...o, status } : o);
    commitOrders(next);
    const updated = next.find(o => o.id === id);
    if (updated) syncOrderTracking(updated);
    logAudit({ actor: user.name, action: 'status_change', entityType: 'order', entityId: id, details: { newStatus: status } });
  };
  const deleteOrder = (id) => setOrders(prev => {
    const next = prev.filter(o => o.id !== id);
    saveShared(KEYS.orders, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'order', entityId: id });
    return next;
  });

  // ---- Team & roles ----
  const updateUserRoles = (next) => setUserRoles(prev => {
    saveShared(KEYS.userRoles, next);
    // Diff old vs new so the audit entry says exactly what changed, not just "roles updated".
    const changed = Object.entries(next).filter(([email, role]) => prev[email] !== role);
    changed.forEach(([email, role]) => logAudit({ actor: user.name, action: 'role_change', entityType: 'user_role', entityId: email, details: { newRole: role } }));
    return next;
  });
  const updateShiftNames = (next) => setShiftNames(() => { saveShared(KEYS.shiftNames, next); return next; });

  // ---- Notifications (in-app) ----
  const markNotificationsRead = (ids) => setNotifications(prev => {
    const idSet = new Set(ids);
    const next = prev.map(n => idSet.has(n.id) ? { ...n, readBy: [...(n.readBy || []), user.name] } : n);
    saveShared(KEYS.notifications, next);
    return next;
  });

  // ---- Maintenance / breakdowns ----
  const addMaintenance = (f) => {
    const entry = { id: uid(), machineId: f.machineId, department: f.department, description: f.description,
      occurredAt: new Date(f.occurredAt).toISOString(), status: 'Open', reportedBy: user.name,
      resolvedAt: null, resolutionNotes: '', delayReason: '' };
    setMaintenanceLogs(prev => { const next = [entry, ...prev]; saveShared(KEYS.maintenance, next); return next; });
    const msg = `Breakdown on ${f.machineId} (${f.department}): ${f.description}. Reported by ${user.name}.`;
    setNotifications(prev => { const next = pushNotification(prev, { message: msg, targetRoles: [maintenanceRoleForDept(f.department), 'Admin'] }); saveShared(KEYS.notifications, next); return next; });
    supabaseNotify({ type: 'breakdown', targetDepartment: f.department, message: msg, payload: entry, createdBy: user.name });
  };
  const setMaintenanceInProgress = (id) => setMaintenanceLogs(prev => {
    const next = prev.map(m => m.id === id ? { ...m, status: 'In Progress' } : m);
    saveShared(KEYS.maintenance, next); return next;
  });
  const resolveMaintenance = (id, { resolvedAt, delayReason, resolutionNotes }) => setMaintenanceLogs(prev => {
    const next = prev.map(m => m.id === id ? { ...m, status: 'Resolved', resolvedAt: new Date(resolvedAt).toISOString(), delayReason, resolutionNotes } : m);
    saveShared(KEYS.maintenance, next);
    logAudit({ actor: user.name, action: 'resolve', entityType: 'maintenance', entityId: id, details: { resolutionNotes, delayReason } });
    return next;
  });
  const deleteMaintenance = (id) => setMaintenanceLogs(prev => {
    const next = prev.filter(m => m.id !== id);
    saveShared(KEYS.maintenance, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'maintenance', entityId: id });
    return next;
  });

  // ---- Tooling & Dies ----
  const addDie = (die) => setToolingItems(prev => {
    if (prev.some(d => d.id === die.id)) return prev;   // die IDs are unique
    const next = [...prev, die];
    saveShared(KEYS.tooling, next);
    logAudit({ actor: user.name, action: 'create', entityType: 'die', entityId: die.id, details: { type: die.type || 'Die', size: die.size, limitMeters: die.limitMeters } });
    return next;
  });
  const updateDieUsage = (id, meters) => setToolingItems(prev => {
    const next = prev.map(d => d.id === id ? { ...d, usageMeters: d.usageMeters + meters } : d);
    saveShared(KEYS.tooling, next);
    return next;
  });
  const sendDieForPolishing = (id) => setToolingItems(prev => {
    const next = prev.map(d => d.id === id ? { ...d, usageMeters: 0, status: 'Active' } : d);
    saveShared(KEYS.tooling, next);
    logAudit({ actor: user.name, action: 'status_change', entityType: 'die', entityId: id, details: { newStatus: 'Polished / reset' } });
    return next;
  });
  const deleteDie = (id) => setToolingItems(prev => {
    const cur = prev.find(d => d.id === id);
    if (cur && cur.usageMeters > 0 && user.role !== 'Admin') return prev;   // history is kept unless the Admin deletes it
    const next = prev.filter(d => d.id !== id);
    saveShared(KEYS.tooling, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'die', entityId: id });
    return next;
  });
  // ---- Machine-wise energy: accepts one reading or an array; one reading per machine per date (latest wins) ----
  const addLabResult = (rec) => {
    if (!canDo(user.role, 'lab.enter')) return { error: 'Only the Quality team can enter lab results.' };
    const row = { ...rec, id: uid(), at: new Date().toISOString(), testedBy: user.name };
    const next = [...labRef.current, row]; labRef.current = next; setLabResults(next); saveShared(KEYS.lab, next);
    logAudit({ actor: user.name, action: 'create', entityType: 'lab_result', entityId: row.id, details: { kind: row.kind, heatId: row.heatId, batchId: row.batchId } });
    return { ok: true };
  };
  const deleteLabResult = (id) => {
    if (user.role !== 'Admin') return { error: 'Only the Admin can delete lab results.' };
    const next = labRef.current.filter(r => r.id !== id); labRef.current = next; setLabResults(next); saveShared(KEYS.lab, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'lab_result', entityId: id });
    return { ok: true };
  };
  const logMachineEnergy = (logs) => setEnergyLogs(prev => {
    const incoming = (Array.isArray(logs) ? logs : [logs]).map(l => ({ ...l, loggedBy: user.name, loggedAt: new Date().toISOString() }));
    const next = [...prev.filter(p => !incoming.some(n => n.date === p.date && n.machineId === p.machineId)), ...incoming];
    saveShared(KEYS.machineEnergy, next);
    return next;
  });

  // ---- CAPA (Corrective & Preventive Action) ----
  const addCapa = (f) => setCapaRecords(prev => {
    const entry = { id: uid(), ...f, status: 'Open', createdBy: user.name, createdAt: new Date().toISOString() };
    const next = [entry, ...prev];
    saveShared(KEYS.capa, next);
    logAudit({ actor: user.name, action: 'create', entityType: 'capa', entityId: entry.id, details: { source: f.source } });
    return next;
  });
  const updateCapaStatus = (id, status) => setCapaRecords(prev => {
    const next = prev.map(c => c.id === id ? { ...c, status } : c);
    saveShared(KEYS.capa, next);
    logAudit({ actor: user.name, action: 'status_change', entityType: 'capa', entityId: id, details: { newStatus: status } });
    return next;
  });
  const deleteCapa = (id) => setCapaRecords(prev => {
    const next = prev.filter(c => c.id !== id);
    saveShared(KEYS.capa, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'capa', entityId: id });
    return next;
  });

  // ---- Skill matrix ----
  const updateSkillLevel = (personName, machineId, level) => setSkillMatrix(prev => {
    const next = { ...prev, [personName]: { ...(prev[personName] || {}), [machineId]: level } };
    saveShared(KEYS.skills, next);
    return next;
  });
  const removeSkillPerson = (personName) => setSkillMatrix(prev => {
    const next = { ...prev };
    delete next[personName];
    saveShared(KEYS.skills, next);
    return next;
  });

  // ---- Kaizen ----
  const addKaizen = (f) => setKaizenIdeas(prev => {
    const entry = { id: uid(), ...f, status: 'Proposed', proposedBy: f.proposedBy || user.name, createdAt: new Date().toISOString() };
    const next = [entry, ...prev];
    saveShared(KEYS.kaizen, next);
    logAudit({ actor: user.name, action: 'create', entityType: 'kaizen', entityId: entry.id, details: { title: f.title } });
    return next;
  });
  const updateKaizenStatus = (id, status) => setKaizenIdeas(prev => {
    const next = prev.map(k => k.id === id ? { ...k, status } : k);
    saveShared(KEYS.kaizen, next);
    logAudit({ actor: user.name, action: 'status_change', entityType: 'kaizen', entityId: id, details: { newStatus: status } });
    return next;
  });
  const deleteKaizen = (id) => setKaizenIdeas(prev => {
    const next = prev.filter(k => k.id !== id);
    saveShared(KEYS.kaizen, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'kaizen', entityId: id });
    return next;
  });

  // ---- Bill of Materials (BOM) -- feeds MRP and cost variance ----
  const addBom = (line) => setBom(prev => {
    const next = [...prev, line];
    saveShared(KEYS.bom, next);
    logAudit({ actor: user.name, action: 'create', entityType: 'bom', entityId: line.id, details: { spec: line.spec } });
    return next;
  });
  const deleteBom = (id) => setBom(prev => {
    const next = prev.filter(b => b.id !== id);
    saveShared(KEYS.bom, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'bom', entityId: id });
    return next;
  });

  // ---- Preventive maintenance ----
  const addPmTask = (task) => setPmTasks(prev => { const next = [...prev, task]; saveShared(KEYS.pmTasks, next); return next; });
  const markPmDone = (id, actingUser) => setPmTasks(prev => {
    const next = prev.map(t => t.id === id ? { ...t, lastDoneDate: todayKey(), lastDoneAt: new Date().toISOString(), lastDoneBy: actingUser.name } : t);
    saveShared(KEYS.pmTasks, next); return next;
  });
  const deletePmTask = (id) => setPmTasks(prev => {
    const next = prev.filter(t => t.id !== id);
    saveShared(KEYS.pmTasks, next); return next;
  });

  // ---- Daily plan ----
  const addPlanRow = (date, row) => setDailyPlans(prev => { const next = { ...prev, [date]: [...(prev[date] || []), row] }; saveShared(KEYS.plans, next); return next; });
  const updateActual = (date, rowId, value) => setDailyPlans(prev => {
    const next = { ...prev, [date]: (prev[date] || []).map(r => r.id === rowId ? { ...r, actual: value } : r) };
    saveShared(KEYS.plans, next); return next;
  });
  const deletePlanRow = (date, rowId) => setDailyPlans(prev => {
    const next = { ...prev, [date]: (prev[date] || []).filter(r => r.id !== rowId) };
    saveShared(KEYS.plans, next); return next;
  });

  // ---- Batches / stage tracking ----
  // Goods receipt into finished stock: kilograms plus the count of pallets / boxes, under the
  // category of the route that made it (LWC, PCC or Straight tube).
  const addOrIncrementFinished = (spec, unit, qty, extra = {}) => {
    if (qty <= 0) return;
    const prev = finishedRef.current;
    const alt = Number(extra.altQty) || 0;
    const match = prev.find(f => f.spec.trim().toLowerCase() === spec.trim().toLowerCase() && f.unit === unit && (!f.category || !extra.category || f.category === extra.category));
    const next = match
      ? prev.map(f => f.id === match.id ? { ...f, qty: Number(f.qty) + qty, category: f.category || extra.category || null, altUnit: f.altUnit || extra.altUnit || null, altQty: (Number(f.altQty) || 0) + alt } : f)
      : [...prev, { id: uid(), spec, unit, qty, category: extra.category || null, altUnit: extra.altUnit || (extra.category ? fgAltUnit(extra.category) : null), altQty: alt }];
    finishedRef.current = next;
    setFinishedItems(next);
    saveShared(KEYS.finished, next);
  };
  const setFinishedCategory = (id, category) => {
    const next = finishedRef.current.map(f => f.id === id ? { ...f, category, altUnit: fgAltUnit(category) } : f);
    finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next);
  };
  // Legacy (push-flow) advance. Works from the latest committed batch list rather
  // than from inside a state updater, so the goods receipt on completion is
  // posted every time -- not only when React happens to run the updater early.
  const advanceStage = (id, user) => {
    const cur = batchesRef.current.find(b => b.id === id);
    if (!cur || isPullBatch(cur)) return; // pull-flow batches only move when the next department pulls them
    const stages = batchStages(cur);
    const atLast = cur.currentStageIndex === stages.length - 1;
    const newIndex = atLast ? cur.currentStageIndex : cur.currentStageIndex + 1;
    const entry = { stageIndex: newIndex, label: stages[newIndex], at: new Date().toISOString(), by: user.name };
    const updated = { ...cur, currentStageIndex: newIndex, status: atLast ? 'Complete' : cur.status, history: [...cur.history, entry] };
    commitBatches(batchesRef.current.map(b => b.id === id ? updated : b));
    if (atLast) {
      const scrapped = (updated.scrapLog || []).reduce((s, r) => s + Number(r.qty || 0), 0);
      const net = Math.max(0, Number(updated.qty || 0) - scrapped);
      addOrIncrementFinished(updated.spec || 'Unspecified', updated.unit, net, { category: fgCategoryOfRoute(updated.route) });
      // Movement type 101 -- goods receipt for a production order. This is
      // the posting that turns finished output into stock in SAP, referenced
      // back to the production order that produced it.
      postMaterialDocument({
        movementType: '101',
        materialNumber: materialNumberForSpec(updated.spec || 'Unspecified'),
        materialName: updated.spec || 'Unspecified',
        quantity: net,
        unit: updated.unit,
        storageLocation: 'FG01',
        refDoc: updated.productionOrderNo || updated.batchCode,
      });
      if (scrapped > 0) {
        // 551 -- goods issue for scrapping, posted to the scrap yard location.
        postMaterialDocument({
          movementType: '551',
          materialNumber: materialNumberForSpec(updated.spec || 'Unspecified'),
          materialName: updated.spec || 'Unspecified',
          quantity: scrapped,
          unit: updated.unit,
          storageLocation: 'SCRP',
          refDoc: updated.productionOrderNo || updated.batchCode,
        });
      }
    }
    // Fires after the batch update above, so the order's own status
    // history/audit entry reflects "this changed because the batch moved",
    // and the customer's tracking link updates the moment this happens --
    // no separate manual step for whoever's running the line.
    if (cur.orderId) {
      const mapped = stageToOrderStatus(stages[newIndex]);
      if (mapped) updateOrderStatus(cur.orderId, mapped);
    }
  };
  const backStage = (id, user) => {
    const next = batchesRef.current.map(b => {
      if (b.id !== id || b.currentStageIndex === 0 || isPullBatch(b)) return b;
      const stages = batchStages(b);
      const newIndex = b.currentStageIndex - 1;
      const entry = { stageIndex: newIndex, label: stages[newIndex], at: new Date().toISOString(), by: user.name };
      return { ...b, currentStageIndex: newIndex, history: [...b.history, entry] };
    });
    commitBatches(next);
  };
  // The Spinner supervisor does not type a spec or pick a route any more: they
  // confirm one line of the day's plan, and spec, route, route machine, linked
  // order, annealing need and packing station all come from that line.
  const setBatchRoute = (id, args, user) => {
    if (!canActSpinner(user.role)) return { error: 'Only the Spinner Supervisor, the Production Manager or a Manager can confirm the planned size at the Spinner.' };
    const rs = resolveStandard(masterRefData.current, 'Spinner', args, user.role);
    if (rs.error) return { error: rs.error };
    const { planDate, planLineId, targetOD, toleranceOD, actualOD, targetThickness, toleranceThickness, actualThickness, passLogs, dieId, dieMeters } = rs.data;
    const line = (spinnerPlansRef.current[planDate] || []).find(l => l.id === planLineId);
    if (!line || !line.route) return { error: 'That plan line is missing or has no route. Ask the Manager to complete it in the Production Plan.' };
    const target = batchesRef.current.find(b => b.id === id);
    if (!target) return { error: 'Batch not found.' };
    const next = batchesRef.current.map(b => {
      if (b.id !== id) return b;
      const measurement = buildMeasurement('Spinner', { targetOD, toleranceOD, actualOD, targetThickness, toleranceThickness, actualThickness }, user);
      if (rs.standard) { measurement.standardId = rs.standard.id; measurement.standardName = rs.standard.name; }
      if (dieId && Number(dieMeters) > 0) { measurement.dieId = dieId; measurement.dieMeters = Math.round(Number(dieMeters)); }
      if (Array.isArray(passLogs) && passLogs.length) measurement.passLogs = passLogs;   // pass-by-pass record from the Spinner schedule
      const updated = {
        ...b, spec: line.spec, route: line.route, routeMachine: line.routeMachine || null,
        annealing: line.annealing !== false, orderId: line.orderId || b.orderId || null,
        planDate, planLineId, packingStation: line.packingStation || null,
        flowVersion: 2, flow: {},
        targetOD, toleranceOD, targetThickness, toleranceThickness,
        passMeasurements: [...(b.passMeasurements || []), measurement],
      };
      const stages = batchStages(updated);
      const newIndex = SPINNER_INDEX + 1;
      const entry = { stageIndex: newIndex, label: `${stages[newIndex]}${line.routeMachine ? ` (${line.routeMachine})` : ''} — per plan ${formatDate(planDate)}`, at: new Date().toISOString(), by: user.name };
      return { ...updated, currentStageIndex: newIndex, history: [...updated.history, entry] };
    });
    commitBatches(next);
    // the die that drew this basket wears by the metres in it
    if (dieId && Number(dieMeters) > 0 && toolingRef.current.some(d => d.id === dieId)) {
      updateDieUsage(dieId, Math.round(Number(dieMeters)));
      logAudit({ actor: user.name, action: 'update', entityType: 'die', entityId: dieId, details: { addedMeters: Math.round(Number(dieMeters)), batchId: id } });
    }
    // Now that the plan has told us which order this batch fulfils, move it
    // off "New" (never backwards) -- this also pushes the public tracking link.
    if (line.orderId) {
      const ord = ordersRef.current.find(o => o.id === line.orderId);
      if (ord && ord.status === 'New') updateOrderStatus(ord.id, 'In Production');
    }
    return { ok: true };
  };
  const deleteBatch = (id) => !canManageProductionOrders(user.role) ? undefined : setBatches(prev => {
    const next = prev.filter(b => b.id !== id);
    saveShared(KEYS.batches, next);
    logAudit({ actor: user.name, action: 'delete', entityType: 'batch', entityId: id });
    return next;
  });
  const logScrap = (batchId, stage, entry, user) => setBatches(prev => {
    const next = prev.map(b => b.id === batchId
      ? { ...b, scrapLog: [...(b.scrapLog || []), { ...entry, stage, id: uid(), at: new Date().toISOString(), by: user.name }] }
      : b);
    saveShared(KEYS.batches, next); return next;
  });
  // Final pass at Planetary Rolling or Cascade. At Planetary Rolling every pass is an
  // INSPECTION LOT (own number) closed by a USAGE DECISION: Accept (A, moves on) or Rework (R,
  // the ENTIRE lot goes to rework under a rework order and must be re-inspected under a new lot).
  const logPass = (batchId, stage, data, user) => {
    const rs = resolveStandard(masterRefData.current, stage, data, user.role);
    if (rs.error) return { error: rs.error };
    data = rs.data;
    const { targetOD, toleranceOD, actualOD, targetThickness, toleranceThickness, actualThickness, scrapQty, scrapReason, machine, decision = 'Accept', reason = '', note = '' } = data;
    const basketIn = String(data.basketNo || '').trim();
    const cur = batchesRef.current.find(b => b.id === batchId);
    if (!cur) return { error: 'Production order not found.' };
    if (reworkStatus(cur) === 'IN_REWORK') return { error: 'The lot is in rework. Confirm the rework is complete before re-inspecting.' };
    const nowIso = new Date().toISOString();
    const measurement = buildMeasurement(stage, { targetOD, toleranceOD, actualOD, targetThickness, toleranceThickness, actualThickness }, user);
    if (rs.standard) { measurement.standardId = rs.standard.id; measurement.standardName = rs.standard.name; }
    const stages = batchStages(cur);
    const isRolling = stage === ROLLING_STAGE;
    const base = { ...cur, targetOD, toleranceOD, targetThickness, toleranceThickness, ...(machine ? { spinnerMachine: machine } : {}) };
    let updated;
    if (isRolling) {
      const defects = deviationDefects(measurement);
      const results = characteristicResults(measurement);
      const prevCount = cur.rework?.count || 0;
      // validate first: a refused submission must not use up a document number
      if (decision === 'Rework') {
        if (!canRework(user.role)) return { error: 'Only Production, Quality or a Manager can send a lot for rework.' };
        const why0 = String(reason || '').trim() || defects.join('; ');
        if (!why0) return { error: 'Write the reason for sending the lot for rework.' };
      } else if (defects.length > 0 && !String(note || '').trim()) {
        return { error: 'The lot is out of tolerance. Write the reason for accepting it with a deviation, or send it for rework.' };
      }
      const lotNo = drawDocNumber('inspectionLot');
      if (decision === 'Rework') {
        const why = String(reason || '').trim() || defects.join('; ');
        const reworkNo = drawDocNumber('reworkOrder');
        const lot = { lotNo, type: 'Rolling', typeText: 'In-process inspection — Planetary Rolling', stage, createdAt: nowIso, createdBy: user.name, status: 'UD', results, defects,
          ud: { ...UD_CODES.R, at: nowIso, by: user.name, remark: why, reworkNo } };
        const cycle = { reworkNo, lotNo, sentAt: nowIso, sentBy: user.name, reason: why, defects, qty: batchNetQty(cur), completedAt: null };
        updated = {
          ...base,
          passMeasurements: [...(cur.passMeasurements || []), { ...measurement, lotNo, decision: 'Rework', reworkNo }],
          qm: { ...(cur.qm || {}), lots: [...(cur.qm?.lots || []), lot] },
          rework: { status: 'IN_REWORK', count: prevCount + 1, cycles: [...(cur.rework?.cycles || []), cycle] },
          history: [...cur.history, { stageIndex: cur.currentStageIndex, label: `Inspection lot ${lotNo}: usage decision R (Rework) — entire lot to rework order ${reworkNo}: ${why}`, at: nowIso, by: user.name }],
        };
        commitBatches(batchesRef.current.map(b => b.id === batchId ? updated : b));
        notifyRoles(['Manager', 'Assistant Manager', 'Quality'], `${cur.productionOrderNo} · ${fmtQty(batchNetQty(cur), cur.unit)} sent back for rework at Planetary Rolling (rework order ${reworkNo}): ${why}`, 'rework', { batchId, reworkNo, lotNo });
        logAudit({ actor: user.name, action: 'rework', entityType: 'production_order', entityId: batchId, details: { reworkNo, lotNo, reason: why } });
        return { ok: true, lotNo, reworkNo };
      }
      // Accept
      const oot = defects.length > 0;
      const lot = { lotNo, type: 'Rolling', typeText: 'In-process inspection — Planetary Rolling', stage, createdAt: nowIso, createdBy: user.name, status: 'UD', results, defects,
        ud: { ...(oot ? UD_CODES.AD : UD_CODES.A), at: nowIso, by: user.name, remark: String(note || '').trim(), afterRework: prevCount > 0 } };
      const atLast = cur.currentStageIndex === stages.length - 1;
      const newIndex = atLast ? cur.currentStageIndex : cur.currentStageIndex + 1;
      const entry = { stageIndex: newIndex, label: stages[newIndex], at: nowIso, by: user.name };
      updated = {
        ...base,
        passMeasurements: [...(cur.passMeasurements || []), { ...measurement, lotNo, decision: oot ? 'Accept with deviation' : 'Accept' }],
        qm: { ...(cur.qm || {}), lots: [...(cur.qm?.lots || []), lot] },
        rework: cur.rework ? { ...cur.rework, status: null } : cur.rework,
        currentStageIndex: newIndex, status: atLast ? 'Complete' : cur.status,
        history: [...cur.history, { stageIndex: cur.currentStageIndex, label: `Inspection lot ${lotNo}: usage decision A (${oot ? 'Accepted with deviation' : 'Accepted'})`, at: nowIso, by: user.name }, entry],
      };
    } else if (stage === 'Cascade') {
      // PULL: Cascade no longer chooses a spinner. The basket waits in the Cascade output buffer
      // until the spinner supervisor requests and pulls it (Shop Floor > Spinner).
      if (cur.cascade?.readyAt) return { error: 'This basket is already finished at Cascade.' };
      if (!canActCascade(user.role)) return { error: 'Only the Cascade Operator, the Production Manager or a Manager can finish a basket at Cascade.' };
      if (!basketIn) return { error: 'Enter the basket number before sending the basket on.' };
      if (basketIn.length > 24) return { error: 'The basket number can be at most 24 characters.' };
      if (batchesRef.current.some(x => x.id !== batchId && x.status !== 'Complete' && String(x.basketNo || '').toLowerCase() === basketIn.toLowerCase())) return { error: `Basket ${basketIn} is already in use by another open production order.` };
      updated = {
        ...base,
        basketNo: basketIn,
        passMeasurements: [...(cur.passMeasurements || []), measurement],
        cascade: { readyAt: nowIso, readyBy: user.name, qty: batchNetQty(cur) },
        history: [...cur.history, { stageIndex: cur.currentStageIndex, label: `Cascade finished — basket ${basketIn} ready for the Spinner (waiting to be requested)`, at: nowIso, by: user.name }],
      };
      notifyRoles(['Spinner Supervisor', 'Production'], `Basket ${basketIn} · ${cur.productionOrderNo} · ${fmtQty(batchNetQty(cur), cur.unit)} finished at Cascade — ready to be requested for a spinner.`, 'ready_for_spinner', { batchId, basketNo: basketIn });
    } else {
      const atLast = cur.currentStageIndex === stages.length - 1;
      const newIndex = atLast ? cur.currentStageIndex : cur.currentStageIndex + 1;
      const stageLabel = machine ? `${stages[newIndex]} (${machine})` : stages[newIndex];
      updated = {
        ...base,
        passMeasurements: [...(cur.passMeasurements || []), measurement],
        currentStageIndex: newIndex, status: atLast ? 'Complete' : cur.status,
        history: [...cur.history, { stageIndex: newIndex, label: stageLabel, at: nowIso, by: user.name }],
      };
    }
    if (scrapQty > 0) {
      updated.scrapLog = [...(cur.scrapLog || []), { id: uid(), stage, qty: scrapQty, reason: scrapReason, at: nowIso, by: user.name }];
    }
    commitBatches(batchesRef.current.map(b => b.id === batchId ? updated : b));
    return { ok: true };
  };
  // Rework finished: the lot goes back for re-inspection (a new inspection lot is created then).
  const completeRework = (batchId, { minutes, notes }) => {
    const cur = batchesRef.current.find(b => b.id === batchId);
    if (!cur || reworkStatus(cur) !== 'IN_REWORK') return { error: 'This production order is not in rework.' };
    if (!canRework(user.role)) return { error: 'Only Production, Quality or a Manager can confirm the rework.' };
    const nowIso = new Date().toISOString();
    const cycles = cur.rework.cycles.map((c, i) => i === cur.rework.cycles.length - 1
      ? { ...c, completedAt: nowIso, completedBy: user.name, minutes: minutes === '' || minutes == null ? null : Number(minutes), notes: notes || '' } : c);
    const last = cycles[cycles.length - 1];
    const updated = { ...cur, rework: { ...cur.rework, status: 'REINSPECT', cycles },
      history: [...cur.history, { stageIndex: cur.currentStageIndex, label: `Rework order ${last.reworkNo} completed — lot waiting for re-inspection`, at: nowIso, by: user.name }] };
    commitBatches(batchesRef.current.map(b => b.id === batchId ? updated : b));
    return { ok: true };
  };

  // ---- Machines ----
  const updateMachines = (category, list) => setMachines(prev => { const next = { ...prev, [category]: list }; saveShared(KEYS.machines, next); return next; });

  // ---- Spinner & route plan ----
  // Per-keystroke "actual" entry on a plan line (adding / editing / removing
  // lines goes through addPlanLine / updatePlanLine / deletePlanLine below).
  const updateSpinnerPlanActual = (date, rowId, value) => commitSpinnerPlans({
    ...spinnerPlansRef.current,
    [date]: (spinnerPlansRef.current[date] || []).map(r => r.id === rowId ? { ...r, actual: value } : r),
  });

  // ---- Downtime ----
  const addDowntime = (date, row) => setDowntimeLogs(prev => { const next = { ...prev, [date]: [...(prev[date] || []), row] }; saveShared(KEYS.downtime, next); return next; });
  const deleteDowntime = (date, id) => setDowntimeLogs(prev => {
    const next = { ...prev, [date]: (prev[date] || []).filter(d => d.id !== id) };
    saveShared(KEYS.downtime, next); return next;
  });

  // ---- Settings ----
  const updateSettings = (patch) => setSettings(prev => { const next = { ...prev, ...patch }; saveShared(KEYS.settings, next); return next; });

  // ---- Master (Admin): fixed values and lists. Settings stay in ctpm:settings, lists and the change history in ctpm:master. ----
  const commitMaster = (mutate) => setMaster(prev => { const next = mutate(prev); saveShared(KEYS.master, next); return next; });
  const withHistory = (prev, changes, lists) => {
    const now = new Date().toISOString();
    return { ...prev, version: 1, updatedAt: now, updatedBy: user.name, lists: lists || prev.lists || {}, access: prev.access || {}, customerLinks: prev.customerLinks || {},
      history: [...changes.map(c => ({ at: now, by: user.name, ...c })), ...(prev.history || [])].slice(0, 200) };
  };
  const saveMasterSettings = (patch) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    const { errors, clean } = validateMasterSettings(patch);
    if (Object.keys(errors).length) return { errors, error: Object.values(errors)[0] };
    const changes = Object.entries(clean).filter(([k, v]) => settingValue(settings, k) !== v).map(([k, v]) => ({ section: 'settings', field: k, from: settingValue(settings, k), to: v }));
    if (!changes.length) return { ok: true, changed: 0 };
    updateSettings(Object.fromEntries(changes.map(c => [c.field, c.to])));
    commitMaster(prev => withHistory(prev, changes));
    logAudit({ actor: user.name, action: 'master_update', entityType: 'master', entityId: 'settings', details: { changes } });
    return { ok: true, changed: changes.length };
  };
  const saveMasterList = (key, list) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (!LIST_DEFS.some(d => d.key === key)) return { error: 'Unknown list.' };
    const items = (list?.items || []).map(listClean), retired = (list?.retired || []).map(listClean);
    if (!items.length && !LIST_DEFS.find(d => d.key === key).allowEmpty) return { error: 'At least one value must stay in the list.' };
    if (new Set(items.map(x => x.toLowerCase())).size !== items.length || items.some(x => !x || x.length > 40)) return { error: 'Each value must be unique, not blank, and at most 40 characters.' };
    const before = (masterRefLists.current || {})[key] || { items: listDefaults(key), retired: [] };
    commitMaster(prev => withHistory(prev, [{ section: 'lists', field: key, from: (before.items || []).join(' | '), to: items.join(' | ') }], { ...(prev.lists || {}), [key]: { items, retired: retired.filter(r => !items.includes(r)) } }));
    logAudit({ actor: user.name, action: 'master_update', entityType: 'master', entityId: `list:${key}`, details: { from: before.items, to: items } });
    return { ok: true };
  };
  // access: { role: { featureKey: bool } } holds only the differences from the defaults
  const applyAccess = (role, nextOverrides, note) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (!ROLES.includes(role)) return { error: 'Unknown role.' };
    const eff = (k, ov) => (typeof ov[k] === 'boolean' ? ov[k] : featureDefault(role, FEATURE_BY_KEY[k]));
    const clean = accessDiff(role, nextOverrides);
    const before = (ACCESS.overrides || {})[role] || {};
    if (role !== 'Admin' && !FEATURES.some(f => f.kind === 'tab' && !f.adminOnly && eff(f.key, clean))) return { error: 'A role needs at least one tab, or its people could not use the app.' };
    const changes = FEATURES.filter(f => !f.adminOnly && !(role === 'Admin' && f.kind === 'tab') && eff(f.key, before) !== eff(f.key, clean))
      .map(f => ({ section: 'access', field: `${roleLabel(role)} · ${f.label}`, from: eff(f.key, before) ? 'yes' : 'no', to: eff(f.key, clean) ? 'yes' : 'no' }));
    if (!changes.length) return { ok: true, changed: 0 };
    commitMaster(prev => { const acc = { ...(prev.access || {}) }; if (Object.keys(clean).length) acc[role] = clean; else delete acc[role]; return { ...withHistory(prev, changes), access: acc }; });
    logAudit({ actor: user.name, action: 'master_access', entityType: 'master', entityId: `access:${role}`, details: { note, changes } });
    return { ok: true, changed: changes.length };
  };
  const saveMasterAccess = (role, changes) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    for (const k of Object.keys(changes || {})) { const f = FEATURE_BY_KEY[k]; if (!f) return { error: 'Unknown feature.' }; if (f.adminOnly || (role === 'Admin' && f.kind === 'tab')) return { error: 'The Admin always keeps this and it cannot be changed.' }; }
    return applyAccess(role, { ...((ACCESS.overrides || {})[role] || {}), ...changes }, 'toggle');
  };
  const resetMasterAccess = (role) => applyAccess(role, {}, 'reset');
  // Master data (customers, sizes): the Admin edits everything; a role with "Add to Master" may only ADD from a form
  const saveMasterData = (kind, next, what) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (kind !== 'customers' && kind !== 'sizes' && kind !== 'standards') return { error: 'Unknown Master data.' };
    commitMaster(prev => ({ ...withHistory(prev, [{ section: kind, field: what.field, from: what.from ?? '', to: what.to ?? '' }]), [kind]: next }));
    logAudit({ actor: user.name, action: 'master_data', entityType: 'master', entityId: kind, details: what });
    return { ok: true };
  };
  const saveMasterCapacities = (patch) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    const errors = {}, clean = {};
    Object.entries(patch || {}).forEach(([proc, raw]) => {
      if (!DPR_PROCESS_NAMES.includes(proc)) { errors[proc] = 'Unknown process.'; return; }
      const t = String(raw ?? '').trim().replace(',', '.');
      if (t === '') { clean[proc] = ''; return; }
      const n = Number(t);
      if (!isFinite(n)) errors[proc] = `${proc}: "${t}" is not a number.`; else if (n < 0) errors[proc] = `${proc}: cannot be below 0.`; else clean[proc] = n;
    });
    if (Object.keys(errors).length) return { errors, error: Object.values(errors)[0] };
    const before = (masterRefData.current || {}).capacities || {};
    const changes = Object.entries(clean).filter(([k, v]) => String(before[k] ?? '') !== String(v)).map(([k, v]) => ({ section: 'capacity', field: k, from: before[k] ?? '', to: v }));
    if (!changes.length) return { ok: true, changed: 0 };
    commitMaster(prev => { const caps = { ...(prev.capacities || {}) }; changes.forEach(c => { if (c.to === '') delete caps[c.field]; else caps[c.field] = c.to; }); return { ...withHistory(prev, changes), capacities: caps }; });
    logAudit({ actor: user.name, action: 'master_capacity', entityType: 'master', entityId: 'capacity', details: { changes } });
    return { ok: true, changed: changes.length };
  };
  const saveStandardRequired = (stage, value) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (!STANDARD_STAGES.includes(stage)) return { error: 'Unknown stage.' };
    const before = !!((masterRefData.current || {}).standardRequired || {})[stage];
    if (before === !!value) return { ok: true, changed: 0 };
    commitMaster(prev => ({ ...withHistory(prev, [{ section: 'standards', field: `${stage} · standard required`, from: before ? 'yes' : 'no', to: value ? 'yes' : 'no' }]), standardRequired: { ...(prev.standardRequired || {}), [stage]: !!value } }));
    logAudit({ actor: user.name, action: 'master_standard_required', entityType: 'master', entityId: stage, details: { to: !!value } });
    return { ok: true, changed: 1 };
  };
  const saveToleranceLocked = (stage, value) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (!STANDARD_STAGES.includes(stage)) return { error: 'Unknown stage.' };
    const before = !!((masterRefData.current || {}).toleranceLocked || {})[stage];
    if (before === !!value) return { ok: true, changed: 0 };
    commitMaster(prev => ({ ...withHistory(prev, [{ section: 'standards', field: `${stage} · tolerance locked`, from: before ? 'yes' : 'no', to: value ? 'yes' : 'no' }]), toleranceLocked: { ...(prev.toleranceLocked || {}), [stage]: !!value } }));
    logAudit({ actor: user.name, action: 'master_tolerance_locked', entityType: 'master', entityId: stage, details: { to: !!value } });
    return { ok: true, changed: 1 };
  };
  const addMasterFromForm = ({ customer, location, size }) => {
    if (!canDo(user.role, 'master.add')) return { error: 'You do not have access to add to Master.' };
    const m = masterRefData.current || {}; let customers = m.customers || [], sizes = m.sizes || []; const changes = [];
    if (customer && mdName(customer)) {
      const known = customerFind(customers, customer, true);
      if (!known) { const r = customerAdd(customers, { name: customer, locations: location ? [location] : [] }); if (r.error) return r; customers = r.customers; changes.push({ section: 'customers', field: mdName(customer), from: '', to: location ? `new customer, location ${mdName(location)}` : 'new customer' }); }
      else if (location && mdName(location) && !customerLocations(customers, customer).some(l => mdSame(l, location))) { const r = customerAddLocation(customers, known.id, location); if (r.error) return r; customers = r.customers; changes.push({ section: 'customers', field: known.name, from: '', to: `new location ${mdName(location)}` }); }
    }
    if (size) { const r = sizeAdd(sizes, size); if (r.error) return r; sizes = r.sizes; changes.push({ section: 'sizes', field: sizeLabel(r.sizes[r.sizes.length - 1]), from: '', to: 'new size' }); }
    if (!changes.length) return { ok: true, changed: 0 };
    commitMaster(prev => ({ ...withHistory(prev, changes), customers, sizes }));
    logAudit({ actor: user.name, action: 'master_data_add', entityType: 'master', entityId: 'form', details: { changes } });
    return { ok: true, changed: changes.length };
  };
  const copyMasterAccess = (fromRole, toRole) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    if (toRole === 'Admin') return { error: 'The Admin keeps every tab; copy into another role.' };
    if (!ROLES.includes(fromRole) || fromRole === toRole) return { error: 'Choose a different role to copy from.' };
    const wanted = Object.fromEntries(FEATURES.filter(f => !f.adminOnly).map(f => [f.key, canDo(fromRole, f.key)]));
    return applyAccess(toRole, wanted, `copy from ${fromRole}`);
  };
  const saveCustomerLink = (email, customer) => {
    if (user.role !== 'Admin') return { error: MASTER_ADMIN_ONLY };
    const key = String(email || '').trim().toLowerCase(); const name = String(customer || '').trim().replace(/\s+/g, ' ');
    if (!key) return { error: 'Enter the login email.' };
    if (name.length > 80) return { error: 'Use at most 80 characters.' };
    const before = ((masterRefLinks.current || {})[key]) || '';
    if (before === name) return { ok: true, changed: 0 };
    commitMaster(prev => { const links = { ...(prev.customerLinks || {}) }; if (name) links[key] = name; else delete links[key]; return { ...withHistory(prev, [{ section: 'customer', field: key, from: before, to: name }]), customerLinks: links }; });
    logAudit({ actor: user.name, action: 'master_customer_link', entityType: 'master', entityId: `customer:${key}`, details: { from: before, to: name } });
    return { ok: true, changed: 1 };
  };

  // ---- Daily Production Report (DPR) ----
  const updateDprEntry = (dpKey, entry) => setDprEntries(prev => { const next = { ...prev, [dpKey]: entry }; saveShared(KEYS.dprEntries, next); return next; });
  const updateDq = (key, value) => setDq(prev => { const next = { ...prev, [key]: value }; saveShared(KEYS.dprDowntimeQuality, next); return next; });
  const updateWipBuffer = (next) => setWipBuffer(() => { saveShared(KEYS.dprWipBuffer, next); return next; });
  const processPlansRef = useRef({}); processPlansRef.current = processPlans;
  const dprClosedRef = useRef({}); dprClosedRef.current = dprClosed;
  const settingsRefA = useRef({}); settingsRefA.current = settings;
  const dprEntriesRefA = useRef({}); dprEntriesRefA.current = dprEntries;
  const machineProdRefA = useRef({}); machineProdRefA.current = machineProd;
  // ---- Process plan (typed MT per machine and shift for the processes the spinner plan does not cover) ----
  const commitProcessPlans = (next) => { processPlansRef.current = next; setProcessPlans(next); saveShared(KEYS.processPlans, next); };
  const updateProcessPlan = (date, machineId, shift, value) => {
    if (!canEditPlan(user.role)) return { error: 'Only the people who edit the production plan can change the process plan.' };
    if (!dprMachineExists(machineId) || DPR_DERIVED_PROCESSES.includes(dprProcessOf(machineId))) return { error: 'That machine is planned from the spinner plan lines.' };
    if (!SHIFTS.includes(shift)) return { error: 'Choose Day or Night.' };
    const t = String(value ?? '').trim().replace(',', '.');
    if (t !== '' && (!isFinite(Number(t)) || Number(t) < 0)) return { error: 'Enter the planned MT as a number (0 or more).' };
    const day = { ...(processPlansRef.current[date] || {}) };
    const row = { ...(day[machineId] || {}) };
    if (t === '') delete row[shift]; else row[shift] = Number(t);
    if (Object.keys(row).length) day[machineId] = row; else delete day[machineId];
    const next = { ...processPlansRef.current }; if (Object.keys(day).length) next[date] = day; else delete next[date];
    commitProcessPlans(next);
    return { ok: true };
  };
  const copyProcessPlan = (fromDate, toDate) => {
    if (!canEditPlan(user.role)) return { error: 'Only the people who edit the production plan can change the process plan.' };
    const src = processPlansRef.current[fromDate];
    if (!src || !Object.keys(src).length) return { error: `There is no typed process plan for ${formatDate(fromDate)} to copy.` };
    commitProcessPlans({ ...processPlansRef.current, [toDate]: JSON.parse(JSON.stringify(src)) });
    return { ok: true, copied: Object.keys(src).length };
  };
  // ---- Daily report: every shift that has ended is saved automatically (by whichever device notices first) ----
  const runAutoClose = () => {
    const st = settingsRefA.current || {};
    const ds = settingValue(st, 'shiftDayStart'), ns = settingValue(st, 'shiftNightStart');
    const closed = dprClosedRef.current || {};
    const nowMs = Date.now();
    if (!closed._since) { const next = { ...closed, _since: new Date(nowMs).toISOString() }; dprClosedRef.current = next; setDprClosed(next); saveShared(KEYS.dprClosed, next); return; }
    const todo = dprShiftsToClose(nowMs, ds, ns, closed, closed._since);
    if (!todo.length) return;
    const ctx = { batches: batchesRef.current, heats: heatsRef.current, charges: chargesRef.current, spinnerPlans: spinnerPlansRef.current, processPlans: processPlansRef.current };
    const next = { ...closed };
    todo.forEach(({ date, shift }) => {
      const key = `${date}::${shift}`;
      const typed = mergeDprWithLegacy((dprEntriesRefA.current[key] || {}).rows, (machineProdRefA.current || {})[key]);
      next[key] = dprSnapshot(date, shift, ctx, typed, ds, ns, new Date(nowMs).toISOString());
    });
    dprClosedRef.current = next; setDprClosed(next); saveShared(KEYS.dprClosed, next);
  };
  const correctClosedShift = (key, machineId, field, value, reason) => {
    if (user.role !== 'Admin') return { error: 'Only the Admin can correct a closed report.' };
    const snap = (dprClosedRef.current || {})[key];
    if (!snap) return { error: 'That shift has not been closed.' };
    if (!dprMachineExists(machineId)) return { error: 'Choose the machine.' };
    if (field !== 'planOutput' && field !== 'actualOutput') return { error: 'Choose Plan or Actual.' };
    const t = String(value ?? '').trim().replace(',', '.');
    if (t === '' || !isFinite(Number(t)) || Number(t) < 0) return { error: 'Enter the corrected MT (0 or more).' };
    if (!String(reason || '').trim()) return { error: 'Write the reason for the correction.' };
    const now = new Date().toISOString();
    const row = { ...((snap.rows || {})[machineId] || {}) }; const from = row[field];
    row[field] = Number(t); row[field === 'planOutput' ? 'planSource' : 'actualSource'] = 'corrected';
    const next = { ...dprClosedRef.current, [key]: { ...snap, rows: { ...(snap.rows || {}), [machineId]: row }, corrections: [...(snap.corrections || []), { at: now, by: user.name, machineId, field, from: from ?? null, to: Number(t), reason: String(reason).trim() }] } };
    dprClosedRef.current = next; setDprClosed(next); saveShared(KEYS.dprClosed, next);
    logAudit({ actor: user.name, action: 'dpr_correction', entityType: 'dpr_closed', entityId: key, details: { machineId, field, from: from ?? null, to: Number(t), reason: String(reason).trim() } });
    return { ok: true };
  };
  const updateTargetActual = (date, rows) => setTargetActual(prev => { const next = { ...prev, [date]: rows }; saveShared(KEYS.dprTargetActual, next); return next; });

  // ---- Inventory ----
  const setRawKind = (id, kind) => { if (!RAW_KINDS.includes(kind)) return; const next = rawItemsRef.current.map(r => r.id === id ? { ...r, kind } : r); rawItemsRef.current = next; setRawItems(next); saveShared(KEYS.raw, next); };
  const addRaw = (item) => { const next = [...rawItemsRef.current, item]; rawItemsRef.current = next; setRawItems(next); saveShared(KEYS.raw, next); };
  const deleteRaw = (id) => { const item = rawItemsRef.current.find(r => r.id === id); const next = rawItemsRef.current.filter(r => r.id !== id); rawItemsRef.current = next; setRawItems(next); saveShared(KEYS.raw, next); if (item) logAudit({ actor: user?.name || 'Unknown', action: 'inventory_delete', entityType: 'raw_material', entityId: id, details: { name: item.name, qty: item.qty, unit: item.unit } }); };
  // Posts an SAP-style material document for a stock movement. Every goods
  // movement in the plant gets one, with a movement type classifying WHY the
  // stock changed -- that's what makes the journal auditable rather than a
  // bare list of quantity deltas.
  const postMaterialDocument = ({ movementType, materialNumber, materialName, quantity, unit, storageLocation, refDoc }) => {
    const docNumber = drawDocNumber('materialDoc');
    setMatDocs(prev => {
      const doc = {
        id: uid(),
        docNumber,
        movementType,
        materialNumber,
        materialName,
        quantity: Math.abs(Number(quantity) || 0),
        unit,
        plant: PLANT_CODE,
        storageLocation: storageLocation || 'RM01',
        refDoc: refDoc || null,
        postingDate: new Date().toISOString(),
        postedBy: user?.name || 'System',
      };
      const next = [doc, ...prev].slice(0, 5000); // cap growth
      saveShared(KEYS.matDocs, next);
      return next;
    });
  };

  const adjustRaw = (id, delta, opts = {}) => {
    const material = rawItemsRef.current.find(r => r.id === id) || null;
    const nextItems = rawItemsRef.current.map(r => r.id === id ? { ...r, qty: Math.max(0, Number(r.qty) + delta) } : r);
    rawItemsRef.current = nextItems;
    setRawItems(nextItems);
    saveShared(KEYS.raw, nextItems);
    // Log every change (receipt or consumption) with a date, so reorder
    // forecasting can work out each material's real recent usage rate
    // instead of only knowing the current on-hand quantity.
    setRawConsumption(prev => {
      const next = [...prev, { id: uid(), materialId: id, delta, date: new Date().toISOString() }].slice(-2000); // cap growth
      saveShared(KEYS.rawConsumption, next); return next;
    });
    if (material) {
      // 261 = goods issue to a production order, 501 = receipt without PO,
      // 551 = scrapping. The caller says which applies; a plain manual
      // adjustment falls back to issue/receipt by direction.
      const movementType = opts.movementType || (delta < 0 ? '261' : '501');
      postMaterialDocument({
        movementType,
        materialNumber: materialNumberForRaw(material.name),
        materialName: material.name,
        quantity: delta,
        unit: material.unit,
        storageLocation: movementType === '551' ? 'SCRP' : 'RM01',
        refDoc: opts.refDoc || null,
      });
    }
  };
  const setMaterialPrice = (kind, id, price) => {
    const p = Math.max(0, Number(price) || 0);
    if (kind === 'fin') { const next = finishedRef.current.map(r => r.id === id ? Object.assign({}, r, { price: p }) : r); finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next); }
    else { const next = rawItemsRef.current.map(r => r.id === id ? Object.assign({}, r, { price: p }) : r); rawItemsRef.current = next; setRawItems(next); saveShared(KEYS.raw, next); }
  };
  const commitPOs = (next) => { poRef.current = next; setPurchaseOrders(next); saveShared(KEYS.purchaseOrders, next); };
  const createPurchaseOrder = ({ vendor, deliveryDate, lines }) => {
    if (!user || !canDo(user.role, 'inventory.adjust')) return { error: 'Your role cannot create purchase orders.' };
    if (!String(vendor || '').trim()) return { error: 'Enter the vendor name.' };
    const clean = (lines || []).filter(l => l.itemId && Number(l.qty) > 0);
    if (!clean.length) return { error: 'Add at least one item with a quantity.' };
    const num = String(Math.max.apply(null, [4500000000].concat(poRef.current.map(p => Number(p.poNumber) || 0))) + 1);
    const po = {
      id: uid(), poNumber: num, vendor: String(vendor).trim(), date: new Date().toISOString().slice(0, 10), deliveryDate: deliveryDate || '', createdBy: user.name, status: 'Open',
      lines: clean.map(l => ({ id: uid(), kind: l.kind, itemId: l.itemId, name: l.name, unit: l.unit, qty: Number(l.qty), price: Number(l.price) || 0, received: 0 })),
    };
    commitPOs([po].concat(poRef.current));
    return { po };
  };
  const cancelPurchaseOrder = (poNumber) => {
    if (!user || !canDo(user.role, 'inventory.adjust')) return { error: 'Your role cannot cancel purchase orders.' };
    const po = poRef.current.find(p => String(p.poNumber) === String(poNumber));
    if (!po) return { error: 'Purchase order not found.' };
    if (poStatusOf(po) !== 'Open') return { error: 'Only a purchase order with nothing received can be cancelled.' };
    commitPOs(poRef.current.map(p => p.id === po.id ? Object.assign({}, p, { status: 'Cancelled' }) : p));
    return { ok: true };
  };
  const receivePurchaseOrder = (poNumber, receipts) => {
    const po = poRef.current.find(p => String(p.poNumber) === String(poNumber));
    if (!po) return;
    const lines = (po.lines || []).map(l => {
      const add = (receipts || []).filter(r => r.lineId === l.id).reduce((t, r) => t + (Number(r.qty) || 0), 0);
      return add ? Object.assign({}, l, { received: round3((Number(l.received) || 0) + add) }) : l;
    });
    const upd = Object.assign({}, po, { lines });
    upd.status = poStatusOf(Object.assign({}, upd, { status: 'Open' }));
    commitPOs(poRef.current.map(p => p.id === po.id ? upd : p));
  };
  const addFinished = (item) => { const { list: next } = mergeIntoFinished(finishedRef.current, [item]); finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next); };
  const addFinishedBatch = (items) => { if (!Array.isArray(items) || !items.length) return null; const { list: next, added, merged } = mergeIntoFinished(finishedRef.current, items); finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next); return { added, merged }; };
  const deleteFinished = (id) => { const item = finishedRef.current.find(r => r.id === id); const next = finishedRef.current.filter(r => r.id !== id); finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next); if (item) logAudit({ actor: user?.name || 'Unknown', action: 'inventory_delete', entityType: 'finished_goods', entityId: id, details: { spec: item.spec, category: item.category, qty: item.qty, unit: item.unit } }); };
  // Imported stock leaves by its own id (kg and pallets / boxes), with the same 601 goods-issue document.
  const issueImported = (item, kg, units, refDoc) => {
    const next = finishedRef.current.map(f => f.id === item.id ? { ...f, qty: Math.max(0, Number(f.qty) - kg), altQty: Math.max(0, (Number(f.altQty) || 0) - units) } : f);
    finishedRef.current = next;
    setFinishedItems(next);
    saveShared(KEYS.finished, next);
    postMaterialDocument({ movementType: '601', materialNumber: materialNumberForSpec(item.spec), materialName: item.spec, quantity: kg, unit: 'kg', storageLocation: 'FG01', refDoc });
  };
  const adjustFinished = (id, delta, opts = {}) => {
    const material = finishedRef.current.find(r => r.id === id) || null;
    // opts.alt: change only the pallet / box count (no goods movement is posted for it)
    const nextItems = finishedRef.current.map(r => r.id === id
      ? (opts.alt ? { ...r, altQty: Math.max(0, (Number(r.altQty) || 0) + delta), altUnit: r.altUnit || fgAltUnit(r.category) } : { ...r, qty: Math.max(0, Number(r.qty) + delta) })
      : r);
    finishedRef.current = nextItems;
    setFinishedItems(nextItems);
    saveShared(KEYS.finished, nextItems);
    if (material && !opts.alt) {
      // 101 = goods receipt from production, 601 = goods issue for delivery.
      const movementType = opts.movementType || (delta > 0 ? '101' : '601');
      postMaterialDocument({
        movementType,
        materialNumber: materialNumberForSpec(material.spec),
        materialName: material.spec,
        quantity: delta,
        unit: material.unit,
        storageLocation: 'FG01',
        refDoc: opts.refDoc || null,
      });
    }
  };

  /* ===================================================================
     CYCLE COUNTING (inventory auditing)
     =================================================================== */
  const commitCounts = (next) => { ccRef.current = next; setCycleCounts(next); saveShared(KEYS.cycleCounts, next); };
  const itemsOf = (type) => (type === 'raw' ? rawItemsRef.current : finishedRef.current);
  const startCycleCount = ({ scope, tolerancePct, note }) => {
    if (!canDo(user.role, 'stock.count')) return { error: 'Your role cannot run cycle counts.' };
    if (ccRef.current.some(s => s.status === 'Open' || s.status === 'Review')) return { error: 'A count is already in progress. Finish or cancel it first.' };
    if (!['All stock', 'Raw materials', 'Finished goods'].includes(scope)) return { error: 'Choose what to count.' };
    const tol = Number(tolerancePct);
    if (!(tol >= 0) || tol > 50) return { error: 'The tolerance must be between 0 and 50 %.' };
    const day = todayKey().replace(/-/g, '');
    const n = ccRef.current.filter(x => String(x.no).includes(day)).length + 1;
    const sess = { id: uid(), no: `CC-${day}-${String(n).padStart(2, '0')}`, scope, tolerancePct: tol, note: String(note || '').trim(), status: 'Open', createdAt: new Date().toISOString(), createdBy: user.name, lines: [] };
    commitCounts([...ccRef.current, sess]);
    logAudit({ actor: user.name, action: 'create', entityType: 'cycle_count', entityId: sess.no, details: { scope } });
    return { ok: true };
  };
  const saveCountLine = (sessionId, type, itemId, qty, alt, note) => {
    if (!canDo(user.role, 'stock.count')) return { error: 'Your role cannot count stock.' };
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || sess.status !== 'Open') return { error: 'This count is not open for counting.' };
    const item = itemsOf(type).find(i => i.id === itemId);
    if (!item) return { error: 'That stock item no longer exists.' };
    if (!countScopeItems(sess, rawItemsRef.current, finishedRef.current).some(x => x.type === type && x.item.id === itemId)) return { error: 'That item is outside this count.' };
    const old = (sess.lines || []).find(l => l.key === `${type}:${itemId}`);
    if (old && (old.status === 'approved' || old.status === 'matched')) return { error: 'This item was already confirmed in this count.' };
    commitCounts(ccRef.current.map(x => x.id === sessionId ? upsertCountLine(x, makeCountLine(type, item, qty, alt, note, user.name)) : x));
    return { ok: true };
  };
  const removeCountLine = (sessionId, key) => {
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || sess.status !== 'Open') return { error: 'This count is not open.' };
    commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, lines: (x.lines || []).filter(l => l.key !== key || l.status === 'approved' || l.status === 'matched') } : x));
    return { ok: true };
  };
  const submitCount = (sessionId) => {
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || sess.status !== 'Open') return { error: 'This count is not open.' };
    if (!(sess.lines || []).length) return { error: 'Count at least one item first.' };
    const redo = (sess.lines || []).filter(l => l.status === 'recount').length;
    if (redo) return { error: `${redo} item${redo > 1 ? 's were' : ' was'} sent back for a recount — scan and count ${redo > 1 ? 'them' : 'it'} again first.` };
    commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, status: 'Review', submittedAt: new Date().toISOString(), submittedBy: user.name } : x));
    return { ok: true };
  };
  // Posts a counted difference to the stock that is on the shelf now, as a 701 / 702 material document. No consumption record is written.
  const applyCountAdjustment = (type, id, dQty, dAlt, refNo) => {
    const material = itemsOf(type).find(r => r.id === id);
    if (!material) return false;
    if (type === 'raw') {
      const next = rawItemsRef.current.map(r => r.id === id ? { ...r, qty: Math.max(0, round3(Number(r.qty) + dQty)) } : r);
      rawItemsRef.current = next; setRawItems(next); saveShared(KEYS.raw, next);
    } else {
      const next = finishedRef.current.map(r => r.id === id ? { ...r, qty: Math.max(0, round3(Number(r.qty) + dQty)), altQty: Math.max(0, (Number(r.altQty) || 0) + dAlt), altUnit: r.altUnit || fgAltUnit(r.category) } : r);
      finishedRef.current = next; setFinishedItems(next); saveShared(KEYS.finished, next);
    }
    if (dQty !== 0) postMaterialDocument({ movementType: dQty > 0 ? '701' : '702', materialNumber: type === 'raw' ? materialNumberForRaw(material.name) : materialNumberForSpec(material.spec), materialName: type === 'raw' ? material.name : material.spec, quantity: dQty, unit: material.unit || 'kg', storageLocation: type === 'raw' ? 'RM01' : 'FG01', refDoc: refNo });
    return true;
  };
  const decideCountLine = (sessionId, key, decision) => {
    if (!canDo(user.role, 'stock.approve')) return { error: 'Your role cannot approve count differences.' };
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || sess.status !== 'Review') return { error: 'This count is not awaiting approval.' };
    const line = (sess.lines || []).find(l => l.key === key);
    if (!line || line.status !== 'counted') return { error: 'That line is not waiting for a decision.' };
    if (line.countedBy === user.name && user.role !== 'Admin') return { error: 'You counted this item — another person must approve it.' };
    const now = new Date().toISOString();
    if (decision === 'recount') {
      commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, status: 'Open', lines: x.lines.map(l => l.key === key ? { ...l, status: 'recount', decidedBy: user.name, decidedAt: now } : l) } : x));
      logAudit({ actor: user.name, action: 'cycle_count_recount', entityType: 'cycle_count', entityId: sess.no, details: { item: line.label } });
      return { ok: true };
    }
    const cur = itemsOf(line.itemType).find(i => i.id === line.itemId);
    if (!cur) return { error: 'That stock item no longer exists.' };
    const st = settleCountLine(line, cur);
    if (!st.matched) applyCountAdjustment(line.itemType, line.itemId, st.dQty, st.dAlt, sess.no);
    commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, lines: x.lines.map(l => l.key === key ? { ...l, status: st.matched ? 'matched' : 'approved', decidedBy: user.name, decidedAt: now, postedQty: st.dQty, postedAlt: st.dAlt, movedQty: st.moved } : l) } : x));
    if (!st.matched) logAudit({ actor: user.name, action: 'cycle_count_post', entityType: 'stock', entityId: key, details: { count: sess.no, item: line.label, difference: st.dQty, altDifference: st.dAlt } });
    return { ok: true };
  };
  const closeCount = (sessionId) => {
    if (!canDo(user.role, 'stock.approve')) return { error: 'Your role cannot close counts.' };
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || sess.status !== 'Review') return { error: 'This count is not awaiting approval.' };
    if ((sess.lines || []).some(l => l.status === 'counted' || l.status === 'recount')) return { error: 'Decide every counted line first (approve or recount).' };
    const pr = countProgress(sess, rawItemsRef.current, finishedRef.current);
    commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, status: 'Closed', closedAt: new Date().toISOString(), closedBy: user.name, coveragePct: pr.total ? Math.round((pr.counted / pr.total) * 100) : 100 } : x));
    logAudit({ actor: user.name, action: 'close', entityType: 'cycle_count', entityId: sess.no, details: { counted: pr.counted, total: pr.total } });
    return { ok: true };
  };
  const cancelCount = (sessionId) => {
    if (!canDo(user.role, 'stock.approve')) return { error: 'Your role cannot cancel counts.' };
    const sess = ccRef.current.find(x => x.id === sessionId);
    if (!sess || (sess.status !== 'Open' && sess.status !== 'Review')) return { error: 'This count is already finished.' };
    commitCounts(ccRef.current.map(x => x.id === sessionId ? { ...x, status: 'Cancelled', closedAt: new Date().toISOString(), closedBy: user.name } : x));
    logAudit({ actor: user.name, action: 'cancel', entityType: 'cycle_count', entityId: sess.no });
    return { ok: true };
  };

  /* ===================================================================
     PRODUCTION PLAN (DPP) + DISPATCH PLAN
     The manager enters the whole process plan (spinner -> route ->
     annealing -> packing) plus the next day's dispatches, a day ahead.
     =================================================================== */
  // Creates the plan header the first time anything is added for a date, and
  // leaves a trail if a released plan is edited afterwards.
  const touchMeta = (date, patch = {}) => {
    const now = new Date().toISOString();
    const cur = planMetaRef.current[date];
    const base = cur || { status: 'Draft', createdAt: now, createdBy: user.name, late: planEnteredLate(date, now) };
    const amended = cur?.status === 'Released' && !patch.status ? { amendedAt: now, amendedBy: user.name } : {};
    commitPlanMeta({ ...planMetaRef.current, [date]: { ...base, ...amended, ...patch } });
  };
  const addPlanLine = (date, row) => {
    const line = { ...row, id: row.id || uid(), actual: Number(row.actual) || 0, addedBy: user.name, addedAt: new Date().toISOString() };
    commitSpinnerPlans({ ...spinnerPlansRef.current, [date]: [...(spinnerPlansRef.current[date] || []), line] });
    touchMeta(date);
  };
  const updatePlanLine = (date, id, patch) => {
    commitSpinnerPlans({ ...spinnerPlansRef.current, [date]: (spinnerPlansRef.current[date] || []).map(l => l.id === id ? { ...l, ...patch } : l) });
    touchMeta(date);
  };
  const deletePlanLine = (date, id) => {
    const used = batchesRef.current.filter(b => b.planLineId === id).length;
    if (used > 0) return { error: `${used} production order${used > 1 ? 's are' : ' is'} already running against this plan line, so it can't be removed.` };
    commitSpinnerPlans({ ...spinnerPlansRef.current, [date]: (spinnerPlansRef.current[date] || []).filter(l => l.id !== id) });
    touchMeta(date);
    return { ok: true };
  };
  const releasePlan = (date) => {
    const lines = spinnerPlansRef.current[date] || [];
    const dLines = dispatchPlansRef.current[date] || [];
    const issues = validatePlan(lines, dLines, planMetaRef.current[date], machines);
    if (issues.length) return { error: 'The plan is not complete yet.', issues };
    touchMeta(date, { status: 'Released', releasedAt: new Date().toISOString(), releasedBy: user.name });
    notifyRoles(['Production', 'Melting Supervisor', 'Cascade Operator', 'Spinner Supervisor', 'Machine Supervisor', 'Annealing', 'Packing', 'Quality', 'Dispatch'],
      `Production plan for ${formatDate(date)} released by ${user.name}: ${lines.length} size${lines.length > 1 ? 's' : ''}, ${dLines.length} dispatch order${dLines.length === 1 ? '' : 's'}.`,
      'plan_released', { date, lines: lines.length, dispatches: dLines.length });
    logAudit({ actor: user.name, action: 'release', entityType: 'production_plan', entityId: date, details: { lines: lines.length, dispatches: dLines.length } });
    return { ok: true };
  };
  const reopenPlan = (date) => {
    touchMeta(date, { status: 'Draft', releasedAt: null, releasedBy: null });
    logAudit({ actor: user.name, action: 'reopen', entityType: 'production_plan', entityId: date });
  };
  const setNoDispatch = (date, value) => touchMeta(date, { noDispatch: !!value });
  const addDispatchLine = (date, { orderId, plannedQty, notes }) => {
    const o = ordersRef.current.find(x => x.id === orderId);
    if (!o) return { error: 'Choose an order.' };
    const qty = Number(plannedQty);
    if (!(qty > 0)) return { error: 'Enter the quantity to dispatch.' };
    if (isOrderClosed(o)) return { error: 'That order is already closed.' };
    if (qty > orderMaxDispatchQty(o) + 1e-9) return { error: `Only ${fmtQty(orderMaxDispatchQty(o), o.unit)} can still be dispatched on that order (incl. tolerance).` };
    const existing = dispatchPlansRef.current[date] || [];
    if (existing.some(l => l.orderId === orderId)) return { error: 'That order is already in the dispatch plan for this day.' };
    const line = { id: uid(), orderId, plannedQty: qty, unit: o.unit, notes: notes || '', addedBy: user.name, addedAt: new Date().toISOString() };
    commitDispatchPlans({ ...dispatchPlansRef.current, [date]: [...existing, line] });
    touchMeta(date, { noDispatch: false });
    return { ok: true };
  };
  const deleteDispatchLine = (date, id) => {
    commitDispatchPlans({ ...dispatchPlansRef.current, [date]: (dispatchPlansRef.current[date] || []).filter(l => l.id !== id) });
    touchMeta(date);
  };
  // The dispatch supervisor explains why a planned order did not go out.
  const setDispatchReason = (date, id, reason) => {
    commitDispatchPlans({
      ...dispatchPlansRef.current,
      [date]: (dispatchPlansRef.current[date] || []).map(l => l.id === id
        ? { ...l, reason: String(reason || '').trim(), reasonBy: user.name, reasonAt: new Date().toISOString() } : l),
    });
    logAudit({ actor: user.name, action: 'dispatch_reason', entityType: 'dispatch_plan', entityId: id, details: { date, reason } });
  };

  /* ===================================================================
     PULL FLOW -- machine -> annealing -> packing -> quality -> dispatch
     Every handler returns { ok } or { error } so the screen can show why a
     step was refused instead of failing silently.
     =================================================================== */
  const histEntry = (b, label, at) => ({ stageIndex: b.currentStageIndex, label, at: at || new Date().toISOString(), by: user.name });
  const toIso = (v) => { const d = v ? new Date(v) : new Date(); return isNaN(d) ? null : d.toISOString(); };
  // Times recorded on the floor are the actual times -- a time in the future is a typo.
  // (10 minutes of slack for a clock that runs a little fast.)
  const isFutureTime = (iso) => new Date(iso).getTime() > Date.now() + 10 * 60000;
  const FUTURE_MSG = 'That time is in the future — enter the actual time.';
  const patchBatches = (ids, fn) => {
    const set = new Set(ids);
    commitBatches(batchesRef.current.map(b => set.has(b.id) ? fn(b) : b));
  };
  const batchById = (id) => batchesRef.current.find(b => b.id === id);
  // A pull closes the oldest open request for that spec between the two departments.
  const fulfilRequests = (list, { toDept, fromDept, batch }) => {
    const hit = list
      .filter(r => r.status === 'Open' && r.toDept === toDept && r.fromDept === fromDept && specKey(r.spec) === specKey(batch.spec))
      .sort((a, b) => a.requestedAt.localeCompare(b.requestedAt))[0];
    if (!hit) return list;
    return list.map(r => r.id === hit.id
      ? { ...r, status: 'Fulfilled', fulfilledAt: new Date().toISOString(), fulfilledBy: user.name, batchId: batch.id, productionOrderNo: batch.productionOrderNo }
      : r);
  };

  // ---- Machine (LWC / PCC / CTL) ----
  const startMachineRun = (id, { basketNo, startedAt }) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'AWAIT_MACHINE') return { error: 'This production order is not waiting for the machine.' };
    if (!canActMachine(user.role)) return { error: 'Only the Machine Supervisor, the Production Manager or a Manager can start a run.' };
    const basket = String(b.basketNo || basketNo || '').trim();   // the number given at Cascade follows the basket; typed only for older baskets without one
    if (!basket) return { error: 'Enter the basket being used.' };
    const iso = toIso(startedAt);
    if (!iso) return { error: 'Enter a valid start time.' };
    if (isFutureTime(iso)) return { error: FUTURE_MSG };
    patchBatches([id], x => ({
      ...x,
      basketNo: x.basketNo || basket,
      flow: { ...x.flow, machine: { basketNo: basket, startedAt: iso, loggedBy: user.name, machine: x.routeMachine || x.route } },
      history: [...x.history, histEntry(x, `Basket ${basket} loaded on ${x.routeMachine || x.route}`, iso)],
    }));
    return { ok: true };
  };
  const finishMachineRun = (id, { endedAt, coils }) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'ON_MACHINE') return { error: 'This production order is not running on a machine.' };
    if (!canActMachine(user.role)) return { error: 'Only the Machine Supervisor, the Production Manager or a Manager can finish a run.' };
    const iso = toIso(endedAt);
    if (!iso) return { error: 'Enter a valid finish time.' };
    if (isFutureTime(iso)) return { error: FUTURE_MSG };
    if (iso < b.flow.machine.startedAt) return { error: 'Finish time cannot be before the start time.' };
    const toAnnealing = routeHasAnnealing(b);
    // LWC and PCC baskets must say how many coils came out and what they weighed.
    let coilRec = null, scrapAdd = [];
    const inputKg = batchNetQty(b);
    if (COIL_ROUTES.includes(b.route)) {
      const v = validateCoilRecord(coils || {}, inputKg, b.route);
      if (!v.valid) return { error: Object.values(v.errors)[0], errors: v.errors };
      const n = (k) => Number(coils[k]);
      coilRec = { made: n('made'), accepted: n('accepted'), rejected: n('rejected'), acceptedKg: round3(n('acceptedKg')), rejectedKg: round3(n('rejectedKg')), rejectReason: n('rejected') > 0 ? coils.rejectReason : '', inputKg: round3(inputKg), lossKg: v.lossKg, recordedAt: new Date().toISOString(), recordedBy: user.name };
      if (coilRec.rejectedKg > 0) scrapAdd.push({ id: uid(), stage: b.route, qty: coilRec.rejectedKg, reason: coilRec.rejectReason, actionTaken: `${coilRec.rejected} rejected ${b.route === 'CTL' ? 'piece' : 'coil'}${coilRec.rejected > 1 ? 's' : ''}`, auto: 'coil', at: iso, by: user.name });
      if (coilRec.lossKg > 0) scrapAdd.push({ id: uid(), stage: b.route, qty: coilRec.lossKg, reason: 'Crop / end-cut loss', actionTaken: 'Process loss at the machine', auto: 'coil', at: iso, by: user.name });
    }
    patchBatches([id], x => ({
      ...x,
      scrapLog: [...(x.scrapLog || []), ...scrapAdd],
      flow: {
        ...x.flow,
        machine: { ...x.flow.machine, endedAt: iso, finishedBy: user.name, ...(coilRec ? { coils: coilRec } : {}) },
        ...(toAnnealing ? { annealReadyAt: iso, annealReadyBy: user.name } : { packReadyAt: iso, packReadyBy: user.name }),
      },
      history: [...x.history, histEntry(x, `${coilRec ? `Run finished — ${coilRec.made} ${coilWord(b.route)} (${coilRec.accepted} accepted ${fmtQty(coilRec.acceptedKg, 'kg')}, ${coilRec.rejected} rejected ${fmtQty(coilRec.rejectedKg, 'kg')}) — ` : 'Run finished — '}${toAnnealing ? 'Annealing informed' : 'Packing informed'}`, iso)],
    }));
    const outKg = coilRec ? coilRec.acceptedKg : inputKg;
    notifyRoles([toAnnealing ? 'Annealing' : 'Packing'],
      `${b.productionOrderNo} · ${b.spec} · ${fmtQty(outKg, b.unit)}${coilRec ? ` (${coilRec.accepted} accepted coil${coilRec.accepted === 1 ? '' : 's'})` : ''} finished on ${b.routeMachine || b.route} — ready for ${toAnnealing ? 'annealing' : 'packing'}.`,
      toAnnealing ? 'ready_for_annealing' : 'ready_for_packing', { batchId: id, productionOrderNo: b.productionOrderNo });
    return { ok: true };
  };
  // Corrects the coil record while the basket is still in the machine's output buffer.
  const updateCoilRecord = (id, coils) => {
    const b = batchById(id);
    if (!b || !coilEditable(b)) return { error: 'The coil record can only be changed while the basket is still waiting in the machine output buffer.' };
    if (!canRecordCoils(user.role)) return { error: 'Only Production, Quality or a Manager can change the coil record.' };
    const old = b.flow.machine.coils;
    const v = validateCoilRecord(coils || {}, old.inputKg, b.route);
    if (!v.valid) return { error: Object.values(v.errors)[0], errors: v.errors };
    const n = (k) => Number(coils[k]);
    const nowIso = new Date().toISOString();
    const rec = { ...old, made: n('made'), accepted: n('accepted'), rejected: n('rejected'), acceptedKg: round3(n('acceptedKg')), rejectedKg: round3(n('rejectedKg')), rejectReason: n('rejected') > 0 ? coils.rejectReason : '', lossKg: v.lossKg, correctedAt: nowIso, correctedBy: user.name };
    const keep = (b.scrapLog || []).filter(r => r.auto !== 'coil');
    const add = [];
    if (rec.rejectedKg > 0) add.push({ id: uid(), stage: b.route, qty: rec.rejectedKg, reason: rec.rejectReason, actionTaken: `${rec.rejected} rejected ${b.route === 'CTL' ? 'piece' : 'coil'}${rec.rejected > 1 ? 's' : ''}`, auto: 'coil', at: old.recordedAt, by: user.name });
    if (rec.lossKg > 0) add.push({ id: uid(), stage: b.route, qty: rec.lossKg, reason: 'Crop / end-cut loss', actionTaken: 'Process loss at the machine', auto: 'coil', at: old.recordedAt, by: user.name });
    patchBatches([id], x => ({ ...x, scrapLog: [...keep, ...add], flow: { ...x.flow, machine: { ...x.flow.machine, coils: rec } },
      history: [...x.history, histEntry(x, `Coil record corrected: ${rec.made} coils, ${rec.accepted} accepted (${fmtQty(rec.acceptedKg, 'kg')}), ${rec.rejected} rejected (${fmtQty(rec.rejectedKg, 'kg')})`, nowIso)] }));
    logAudit({ actor: user.name, action: 'coil_correction', entityType: 'production_order', entityId: id, details: { made: rec.made, accepted: rec.accepted, rejected: rec.rejected } });
    return { ok: true };
  };

  // ---- LWC hold & rejected ----
  const holdBasket = (id, { defect, reason }) => {
    const b = batchById(id);
    if (!b || !canHoldBasket(b)) return { error: 'Only an LWC basket that is waiting for, or running on, an LWC machine can be put on hold.' };
    if (!canPutOnHold(user.role)) return { error: 'Only the Machine Supervisor, the Production Manager, Quality or a Manager can put a basket on hold.' };
    if (!lwcDefects().includes(defect)) return { error: `Choose the LWC defect (${joinOr(lwcDefects())}).` };
    const why = String(reason || '').trim();
    if (!why) return { error: 'Enter the reason for hold.' };
    const iso = new Date().toISOString();
    const lotNo = drawDocNumber('inspectionLot');
    const fromState = batchFlowState(b);
    const lot = { lotNo, type: 'LWC-Hold', typeText: 'Quality hold — LWC basket', stage: 'LWC', createdAt: iso, createdBy: user.name, status: 'BLKD', results: [], defects: [`${defect}: ${why}`], ud: null, qty: batchNetQty(b) };
    patchBatches([id], x => ({
      ...x,
      flow: { ...x.flow, hold: { status: 'Hold', defect, reason: why, at: iso, by: user.name, fromState, lotNo } },
      qm: { ...(x.qm || {}), lots: [...(x.qm?.lots || []), lot] },
      history: [...x.history, histEntry(x, `Put on hold at LWC — ${defect} (inspection lot ${lotNo}): ${why}`, iso)],
    }));
    notifyRoles(['Quality', 'Manager', 'Assistant Manager'], `${b.basketNo ? `Basket ${b.basketNo} · ` : ''}${b.productionOrderNo} · ${b.spec} · ${fmtQty(batchNetQty(b), b.unit)} put on hold at ${b.routeMachine || 'LWC'} — ${defect}: ${why}`, 'lwc_hold', { batchId: id, lotNo, defect });
    logAudit({ actor: user.name, action: 'hold', entityType: 'production_order', entityId: id, details: { lotNo, defect, reason: why } });
    return { ok: true, lotNo };
  };
  // Quality / the Manager decide on a held basket: release, reject or rework for downsizing.
  const decideHold = (id, d) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'LWC_HOLD') return { error: 'This basket is not on quality hold.' };
    if (!canDecideHold(user.role)) return { error: 'Only Quality can review and decide on a held basket.' };
    const iso = new Date().toISOString();
    const hold = b.flow.hold;
    const note = String(d.note || '').trim();
    const closeLot = (ud) => ({ ...(b.qm || {}), lots: (b.qm?.lots || []).map(l => l.lotNo === hold.lotNo ? { ...l, status: 'UD', ud: { ...ud, at: iso, by: user.name, remark: note } } : l) });
    const logEntry = (decision, extra) => ({ reason: hold.reason, heldAt: hold.at, heldBy: hold.by, lotNo: hold.lotNo, decision, decidedAt: iso, decidedBy: user.name, note, ...(extra || {}) });
    if (d.decision === 'release') {
      patchBatches([id], x => {
        const { hold: _gone, ...flow } = x.flow;
        return { ...x, flow, qm: closeLot({ ...UD_CODES.A, text: 'Accepted — released from hold' }), holdLog: [...(x.holdLog || []), logEntry('Released')],
          history: [...x.history, histEntry(x, `Released from quality hold (usage decision A)${note ? `: ${note}` : ''}`, iso)] };
      });
      notifyRoles(['Machine Supervisor', 'Production'], `${b.productionOrderNo} · ${b.spec} released from quality hold — back at ${b.routeMachine || 'LWC'}.`, 'lwc_hold_released', { batchId: id });
      logAudit({ actor: user.name, action: 'hold_release', entityType: 'production_order', entityId: id, details: { lotNo: hold.lotNo } });
      return { ok: true };
    }
    if (d.decision === 'reject') {
      if (!note) return { error: 'Write the reason for rejecting the basket.' };
      const kg = batchNetQty(b);
      patchBatches([id], x => ({
        ...x, status: 'Complete', rejected: { at: iso, by: user.name, reason: note, kg, lotNo: hold.lotNo, defect: hold.defect || null },
        scrapLog: [...(x.scrapLog || []), { id: uid(), stage: 'LWC', qty: kg, reason: note, actionTaken: 'Whole basket rejected at quality hold', auto: 'hold-reject', at: iso, by: user.name }],
        flow: { ...x.flow, hold: { ...hold, status: 'Rejected', decidedAt: iso, decidedBy: user.name } },
        qm: closeLot(UD_CODES.S), holdLog: [...(x.holdLog || []), logEntry('Rejected')],
        history: [...x.history, histEntry(x, `Rejected at quality hold — ${fmtQty(kg, x.unit)} scrapped: ${note}`, iso)],
      }));
      notifyRoles(['Machine Supervisor', 'Production', 'Manager', 'Assistant Manager'], `${b.productionOrderNo} · ${b.spec} · ${fmtQty(kg, b.unit)} REJECTED at LWC: ${note}`, 'lwc_rejected', { batchId: id, lotNo: hold.lotNo });
      logAudit({ actor: user.name, action: 'hold_reject', entityType: 'production_order', entityId: id, details: { lotNo: hold.lotNo, kg, reason: note } });
      return { ok: true };
    }
    if (d.decision === 'rework') {
      const v = validateDownsize(d, b, machines);
      if (!v.valid) return { error: Object.values(v.errors)[0], errors: v.errors };
      const reworkNo = drawDocNumber('reworkOrder');
      const target = { productType: d.productType, route: v.route, sizeMm: v.size.mm, thicknessMm: v.thickness.mm, sizeDisplay: v.size.display, sizeEntered: v.size.originalDisplay,
        specification: String(d.specification || '').trim(), spec: buildDimSpec(v.size.mm, v.thickness.mm), routeMachine: d.machine || null };
      patchBatches([id], x => ({
        ...x,
        flow: { ...x.flow, hold: { ...hold, status: 'Rework', decidedAt: iso, decidedBy: user.name, decisionNote: note, reworkNo, target } },
        qm: closeLot({ ...UD_CODES.R, reworkNo }),
        history: [...x.history, histEntry(x, `Quality decision R: rework for downsizing to ${target.spec} (${target.productType}) — rework order ${reworkNo}${note ? `: ${note}` : ''}`, iso)],
      }));
      notifyRoles(['Machine Supervisor', 'Production', 'Manager', 'Assistant Manager'], `${b.productionOrderNo} · ${fmtQty(batchNetQty(b), b.unit)} sent for downsizing rework (order ${reworkNo}) to ${target.spec} — ${target.productType}.`, 'lwc_downsizing', { batchId: id, reworkNo });
      logAudit({ actor: user.name, action: 'hold_rework', entityType: 'production_order', entityId: id, details: { lotNo: hold.lotNo, reworkNo, target: target.spec } });
      return { ok: true, reworkNo };
    }
    return { error: 'Choose release, reject or rework for downsizing.' };
  };
  // Downsizing rework done: add the basket to TODAY's spinner plan, route it to the new machine
  // section (PCC or LWC) and tell the floor. Nobody has to re-enter anything.
  const completeDownsize = (id, { minutes, notes }) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'LWC_REWORK') return { error: 'This basket is not in downsizing rework.' };
    if (!canActMachine(user.role)) return { error: 'Only the Machine Supervisor, the Production Manager or a Manager can complete the rework.' };
    const mins = minutes === '' || minutes == null ? null : Number(minutes);
    if (mins != null && !(mins >= 0)) return { error: 'Rework minutes must be 0 or more.' };
    const hold = b.flow.hold, t = hold.target;
    const m = allMachines(machines);
    const spinner = b.spinnerMachine || (m.spinner || [])[0];
    if (!spinner) return { error: 'No spinner is set up to take the downsized basket.' };
    const iso = new Date().toISOString();
    const date = todayKey();
    const kg = batchNetQty(b);
    const station = (m.packing || []).find(st => st.includes(`(${t.route})`)) || null;
    const lineId = uid();
    addPlanLine(date, { id: lineId, spec: t.spec, planned: kg, unit: 'kg', spinnerMachine: spinner, route: t.route, routeMachine: t.routeMachine || null, annealing: true,
      packingStation: station, orderId: b.orderId || null, source: 'Downsizing rework', sourceBatchId: b.id, sourceOrderNo: b.productionOrderNo, reworkNo: hold.reworkNo, directQty: kg });
    patchBatches([id], x => ({
      ...x, spec: t.spec, route: t.route, routeMachine: t.routeMachine || null, annealing: true, packingStation: station,
      planDate: date, planLineId: lineId, targetOD: t.sizeMm, flow: {},
      downsized: { fromSpec: x.spec, fromRoute: x.route, toSpec: t.spec, toRoute: t.route, toMachine: t.routeMachine || null, reworkNo: hold.reworkNo, lotNo: hold.lotNo, completedAt: iso, completedBy: user.name, minutes: mins, notes: String(notes || ''), planDate: date, planLineId: lineId },
      holdLog: [...(x.holdLog || []), { reason: hold.reason, heldAt: hold.at, heldBy: hold.by, lotNo: hold.lotNo, decision: 'Downsizing rework', decidedAt: hold.decidedAt, decidedBy: hold.decidedBy, note: hold.decisionNote, reworkNo: hold.reworkNo, target: t.spec, completedAt: iso }],
      history: [...x.history, histEntry(x, `Downsizing rework ${hold.reworkNo} completed — now ${t.spec}; added to the spinner plan of ${formatDate(date)} and forwarded to ${t.route}${t.routeMachine ? ` (${t.routeMachine})` : ''}`, iso)],
    }));
    notifyRoles(['Machine Supervisor', 'Production', 'Manager', 'Assistant Manager', 'Quality'],
      `${b.productionOrderNo} · ${fmtQty(kg, 'kg')} downsized (rework ${hold.reworkNo}) to ${t.spec} — added to today's spinner plan (${spinner}) and forwarded to ${t.route}${t.routeMachine ? ` ${t.routeMachine}` : ''}.`,
      `downsized_to_${t.route.toLowerCase()}`, { batchId: id, reworkNo: hold.reworkNo, planLineId: lineId, route: t.route });
    logAudit({ actor: user.name, action: 'downsize_complete', entityType: 'production_order', entityId: id, details: { reworkNo: hold.reworkNo, to: t.spec, route: t.route, planLineId: lineId } });
    return { ok: true, planLineId: lineId, planDate: date };
  };

  // ---- Cascade -> Spinner: the spinner supervisor requests SPECIFIC baskets for a spinner ----
  // A request names the baskets (by the number Cascade gave them) and the spinner (a line of today's plan).
  // The baskets show up in that spinner's Stage Tracking at once, with the same basket number.
  // A basket cannot be split, so the basket that crosses the planned quantity is allowed; no more after it.
  const requestBasketsForSpinner = ({ planDate, planLineId, batchIds }) => {
    if (!canActSpinner(user.role)) return { error: 'Only the Spinner Supervisor, the Production Manager or a Manager can request baskets.' };
    const date = planDate || todayKey();
    const line = (spinnerPlansRef.current[date] || []).find(l => l.id === planLineId);
    if (!line || !line.spinnerMachine || !line.spec) return { error: 'Choose a spinner / planned size from the spinner plan.' };
    if ((line.unit || 'kg') !== 'kg') return { error: 'That plan line is not in kg.' };
    if (!batchIds || !batchIds.length) return { error: 'Tick the baskets to request.' };
    const picked = batchIds.map(batchById);
    if (picked.some(b => !b || b.route || b.currentStageIndex !== CASCADE_INDEX || !b.cascade?.readyAt || b.unit !== 'kg' || b.spinnerRequestNo)) return { error: 'Some of the selected baskets are not waiting at Cascade.' };
    let running = spinnerLineProgress(line, requestsRef.current).requested;
    const planned = Number(line.planned) || 0;
    for (const b of picked) {
      if (running >= planned - 1e-9) return { error: `${line.spinnerMachine} is already fully requested for this size (planned ${fmtQty(planned, 'kg')}, requested ${fmtQty(running, 'kg')}). Basket ${b.basketNo || b.productionOrderNo} would go over the plan.` };
      running += batchNetQty(b);
    }
    const now = new Date().toISOString();
    const requestNo = drawDocNumber('pullRequest');
    const baskets = picked.map(b => ({ batchId: b.id, basketNo: b.basketNo || null, productionOrderNo: b.productionOrderNo, qty: batchNetQty(b), at: now, by: user.name }));
    const total = baskets.reduce((sum, a) => sum + a.qty, 0);
    const req = { id: uid(), requestNo, toDept: 'Spinner', fromDept: 'Cascade', spec: line.spec, qty: total, suppliedQty: total, unit: 'kg', note: '', planDate: date, planLineId, spinnerMachine: line.spinnerMachine,
      baskets, status: 'Supplied', requestedBy: user.name, requestedAt: now, suppliedAt: now };
    patchBatches(batchIds, x => ({
      ...x, currentStageIndex: SPINNER_INDEX, spinnerMachine: line.spinnerMachine, pulledLineId: planLineId, pulledPlanDate: date, spinnerRequestId: req.id, spinnerRequestNo: requestNo,
      history: [...x.history, { stageIndex: SPINNER_INDEX, label: `Basket ${x.basketNo || x.productionOrderNo} requested for ${line.spinnerMachine} (${line.spec}) — request ${requestNo}`, at: now, by: user.name }],
    }));
    commitRequests([req, ...requestsRef.current]);
    notifyRoles(['Cascade Operator', 'Production'], `${line.spinnerMachine} requested basket${baskets.length > 1 ? 's' : ''} ${baskets.map(a => a.basketNo || a.productionOrderNo).join(', ')} (${fmtQty(total, 'kg')}) from Cascade — request ${requestNo}.`, 'spinner_basket_request', { requestNo, baskets: baskets.map(a => a.basketNo) });
    logAudit({ actor: user.name, action: 'basket_request', entityType: 'pull_request', entityId: requestNo, details: { spinner: line.spinnerMachine, baskets: baskets.map(a => a.basketNo || a.productionOrderNo) } });
    return { ok: true, requestNo, total };
  };
  // Put the baskets back at Cascade (only while they have not been confirmed at the spinner).
  const withdrawBasketRequest = (id) => {
    const r = requestsRef.current.find(x => x.id === id && x.toDept === 'Spinner' && x.status === 'Supplied');
    if (!r) return { error: 'That request cannot be withdrawn.' };
    if (!canActSpinner(user.role)) return { error: 'Only the Spinner Supervisor, the Production Manager or a Manager can withdraw a request.' };
    const ids = (r.baskets || []).map(x => x.batchId);
    if (ids.some(bid => { const b = batchById(bid); return !b || b.route || b.currentStageIndex !== SPINNER_INDEX; })) return { error: 'A basket of this request has already been confirmed at the spinner.' };
    const now = new Date().toISOString();
    patchBatches(ids, x => {
      const { spinnerMachine: _m, pulledLineId: _l, pulledPlanDate: _d, spinnerRequestId: _i, spinnerRequestNo: _n, ...rest } = x;
      return { ...rest, currentStageIndex: CASCADE_INDEX, history: [...x.history, { stageIndex: CASCADE_INDEX, label: `Request ${r.requestNo} withdrawn — basket ${x.basketNo || x.productionOrderNo} back at Cascade`, at: now, by: user.name }] };
    });
    commitRequests(requestsRef.current.map(x => x.id === id ? { ...x, status: 'Cancelled', cancelledBy: user.name, cancelledAt: now } : x));
    return { ok: true };
  };

  // ---- Pull requests (downstream asks upstream) ----
  const createPullRequest = ({ toDept, fromDept, spec, qty, unit, note }) => {
    if (!String(spec || '').trim()) return { error: 'Choose the size you need.' };
    if (!(Number(qty) > 0)) return { error: 'Enter the quantity you need.' };
    const requestNo = drawDocNumber('pullRequest');
    const req = { id: uid(), requestNo, toDept, fromDept, spec: spec.trim(), qty: Number(qty), unit: unit || 'kg', note: note || '', status: 'Open', requestedBy: user.name, requestedAt: new Date().toISOString() };
    commitRequests([req, ...requestsRef.current]);
    notifyRoles(fromDept === 'Annealing' ? ['Annealing'] : ['Machine Supervisor', 'Production'],
      `${toDept} is requesting ${fmtQty(req.qty, req.unit)} of ${req.spec} from ${fromDept} (request ${requestNo}).`, 'pull_request', { requestNo });
    return { ok: true };
  };
  const cancelPullRequest = (id) => {
    commitRequests(requestsRef.current.map(r => r.id === id && isRequestOpen(r) ? { ...r, status: 'Cancelled', cancelledBy: user.name, cancelledAt: new Date().toISOString() } : r));
  };

  // ---- Annealing: pull from the machine buffer into a pot ----
  const createAnnealCharge = ({ potNo, batchIds, notes }) => {
    const pot = String(potNo || '').trim();
    if (!pot) return { error: 'Enter the pot number.' };
    if (!batchIds || !batchIds.length) return { error: 'Select the material to pull into this pot.' };
    if (chargesRef.current.some(c => c.potNo.toLowerCase() === pot.toLowerCase() && ['Charged', 'In furnace', 'Out'].includes(c.status))) {
      return { error: `Pot ${pot} is still in use. Finish and forward its current charge first.` };
    }
    const picked = batchIds.map(batchById);
    if (picked.some(b => !b || batchFlowState(b) !== 'READY_FOR_ANNEALING')) return { error: 'Some of the selected material is not ready for annealing.' };
    const now = new Date().toISOString();
    const chargeId = uid();
    const chargeNo = drawDocNumber('annealCharge');
    const charge = {
      id: chargeId, chargeNo, potNo: pot, status: 'Charged', chargedAt: now, chargedBy: user.name, notes: notes || '',
      items: picked.map(b => ({ batchId: b.id, batchCode: b.batchCode, basketNo: b.basketNo || b.flow?.machine?.basketNo || null, productionOrderNo: b.productionOrderNo, spec: b.spec, qty: batchNetQty(b), unit: b.unit, route: b.route, routeMachine: b.routeMachine, planDate: b.planDate, planLineId: b.planLineId })),
    };
    let reqs = requestsRef.current;
    picked.forEach(b => { reqs = fulfilRequests(reqs, { toDept: 'Annealing', fromDept: b.route, batch: b }); });
    patchBatches(batchIds, x => {
      const newIndex = batchStages(x).indexOf('Annealing');
      const moved = { ...x, currentStageIndex: newIndex, flow: { ...x.flow, annealing: { chargeId, chargeNo, potNo: pot, pulledAt: now, pulledBy: user.name } } };
      return { ...moved, history: [...x.history, histEntry(moved, `Pulled to Annealing — pot ${pot}`, now)] };
    });
    commitCharges([charge, ...chargesRef.current]);
    if (reqs !== requestsRef.current) commitRequests(reqs);
    return { ok: true, chargeNo };
  };
  const chargeBatchIds = (c) => c.items.map(i => i.batchId);
  const potIn = (chargeId, { potInAt, keepIds }) => {
    if (!canActAnnealing(user.role)) return { error: 'Only Annealing or a Manager records the pot going in.' };
    const c = chargesRef.current.find(x => x.id === chargeId);
    if (!c || c.status !== 'Charged') return { error: 'This pot is not waiting to go into the furnace.' };
    const iso = toIso(potInAt);
    if (!iso) return { error: 'Enter a valid time.' };
    if (isFutureTime(iso)) return { error: FUTURE_MSG };
    if (iso < c.chargedAt.slice(0, 16)) return { error: 'The pot cannot go in before it was charged.' };
    const split = potInSplit(c.items, keepIds);
    if (split.error) return { error: split.error };
    if (split.returned.length) {
      // what did not go into the furnace goes back to the machine output buffer, exactly as a cancelled charge does
      const retIds = split.returned.map(i => i.batchId);
      patchBatches(retIds, x => {
        const { annealing, ...flow } = x.flow;
        const back = { ...x, currentStageIndex: batchStages(x).indexOf(x.route), flow };
        return { ...back, history: [...x.history, histEntry(back, `Not charged into pot ${c.potNo} — returned to the machine buffer`, iso)] };
      });
    }
    commitCharges(chargesRef.current.map(x => x.id === chargeId ? { ...x, items: split.keep, ...(split.returned.length ? { returnedItems: split.returned, returnedAt: iso, returnedBy: user.name } : {}), status: 'In furnace', potInAt: iso, potInBy: user.name } : x));
    patchBatches(split.keep.map(i => i.batchId), x => ({ ...x, flow: { ...x.flow, annealing: { ...x.flow.annealing, potInAt: iso } }, history: [...x.history, histEntry(x, `Pot ${c.potNo} in furnace`, iso)] }));
    return { ok: true };
  };
  const potOut = (chargeId, { potOutAt, heatingMin, soakingMin, coolingMin }) => {
    const c = chargesRef.current.find(x => x.id === chargeId);
    if (!c || c.status !== 'In furnace') return { error: 'This pot is not in the furnace.' };
    const iso = toIso(potOutAt);
    if (!iso) return { error: 'Enter a valid pot-out time.' };
    if (isFutureTime(iso)) return { error: FUTURE_MSG };
    if (iso <= c.potInAt) return { error: 'Pot-out time must be after the pot-in time.' };
    const nums = [heatingMin, soakingMin, coolingMin];
    if (nums.some(n => n === '' || n == null || isNaN(Number(n)) || Number(n) < 0)) return { error: 'Enter the heating, soaking and cooling time (minutes).' };
    const times = { heatingMin: Number(heatingMin), soakingMin: Number(soakingMin), coolingMin: Number(coolingMin) };
    commitCharges(chargesRef.current.map(x => x.id === chargeId ? { ...x, status: 'Out', potOutAt: iso, potOutBy: user.name, ...times } : x));
    patchBatches(chargeBatchIds(c), x => ({ ...x, flow: { ...x.flow, annealing: { ...x.flow.annealing, potOutAt: iso, ...times } }, history: [...x.history, histEntry(x, `Pot ${c.potNo} out — annealed`, iso)] }));
    return { ok: true };
  };
  // Pot is out: the annealing supervisor forwards the material to Packing.
  const forwardCharge = (chargeId) => {
    const c = chargesRef.current.find(x => x.id === chargeId);
    if (!c || c.status !== 'Out') return { error: 'Record the pot-out time first.' };
    const now = new Date().toISOString();
    commitCharges(chargesRef.current.map(x => x.id === chargeId ? { ...x, status: 'Forwarded', forwardedAt: now, forwardedBy: user.name } : x));
    patchBatches(chargeBatchIds(c), x => ({ ...x, flow: { ...x.flow, annealedReadyAt: now, annealedReadyBy: user.name }, history: [...x.history, histEntry(x, 'Forwarded to Packing', now)] }));
    notifyRoles(['Packing'], `Pot ${c.potNo} (${c.items.map(i => `${i.spec} ${fmtQty(i.qty, i.unit)}`).join(', ')}) is out of annealing — ready for packing.`, 'ready_for_packing', { chargeNo: c.chargeNo });
    return { ok: true };
  };
  // Only before the pot goes in: hand the material back to the machine buffer.
  const cancelCharge = (chargeId) => {
    const c = chargesRef.current.find(x => x.id === chargeId);
    if (!c || c.status !== 'Charged') return { error: 'Only a pot that has not gone into the furnace can be cancelled.' };
    commitCharges(chargesRef.current.map(x => x.id === chargeId ? { ...x, status: 'Cancelled', cancelledBy: user.name, cancelledAt: new Date().toISOString() } : x));
    patchBatches(chargeBatchIds(c), x => {
      const { annealing, ...flow } = x.flow;
      const back = { ...x, currentStageIndex: batchStages(x).indexOf(x.route), flow };
      return { ...back, history: [...x.history, histEntry(back, `Pot ${c.potNo} cancelled — returned to machine buffer`)] };
    });
    return { ok: true };
  };

  // ---- Packing: pull from the annealing (or machine) buffer ----
  const pullToPacking = (batchIds) => {
    if (!batchIds || !batchIds.length) return { error: 'Select the material to pull into Packing.' };
    const picked = batchIds.map(batchById);
    if (picked.some(b => !b || batchFlowState(b) !== 'READY_FOR_PACKING')) return { error: 'Some of the selected material is not ready for packing.' };
    const now = new Date().toISOString();
    let reqs = requestsRef.current;
    picked.forEach(b => { reqs = fulfilRequests(reqs, { toDept: 'Packing', fromDept: routeHasAnnealing(b) ? 'Annealing' : b.route, batch: b }); });
    patchBatches(batchIds, x => {
      const moved = { ...x, currentStageIndex: batchStages(x).indexOf('Packing'), flow: { ...x.flow, packing: { pulledAt: now, pulledBy: user.name, from: routeHasAnnealing(x) ? 'Annealing' : x.route } } };
      return { ...moved, history: [...x.history, histEntry(moved, `Pulled to Packing from ${moved.flow.packing.from}`, now)] };
    });
    if (reqs !== requestsRef.current) commitRequests(reqs);
    return { ok: true };
  };
  const finishPacking = (id, { packedQty, rejectedQty, rejectReason, packUnits, station, tag, note }) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'PACKING') return { error: 'This production order is not being packed.' };
    if (!PACK_TAGS.includes(tag)) return { error: 'Tag the material "Make to stock" or "Make to dispatch".' };
    const net = batchNetQty(b);
    const qty = Number(packedQty);
    const rejKg = Number(rejectedQty) || 0;
    if (!(qty > 0)) return { error: 'Enter the packed quantity.' };
    if (rejKg < 0) return { error: 'Rejected weight cannot be negative.' };
    if (qty + rejKg > net + 1e-9) return { error: `Packed (${fmtQty(qty, b.unit)}) + rejected (${fmtQty(rejKg, b.unit)}) cannot exceed ${fmtQty(net, b.unit)} received.` };
    const unitLabel = packUnitOf(b.route);
    const units = Number(packUnits);
    if (!(units > 0) || !Number.isInteger(units)) return { error: `Enter the number of ${unitLabel} packed (a whole number).` };
    const now = new Date().toISOString();
    const shortfall = Math.max(0, Math.round((net - qty - rejKg) * 1e6) / 1e6);
    const extraScrap = [];
    if (rejKg > 0) {
      extraScrap.push({ id: uid(), stage: 'Packing', qty: rejKg, reason: rejectReason || 'Dent / damage', actionTaken: `Damaged / bad coil rejected during ${b.route} packing`, at: now, by: user.name });
    }
    if (shortfall > 0) {
      extraScrap.push({ id: uid(), stage: 'Packing', qty: shortfall, reason: 'Other', actionTaken: 'Packing shortfall (packed less than received)', at: now, by: user.name });
    }
    const scrapLog = [...(b.scrapLog || []), ...extraScrap];
    const totalScrap = scrapLog.reduce((s, r) => s + Number(r.qty || 0), 0);
    const lotNo = drawDocNumber('inspectionLot');
    patchBatches([id], x => ({
      ...x, scrapLog,
      flow: {
        ...x.flow,
        inspectionLot: { lotNo, createdAt: now, createdBy: user.name },
        packing: {
          ...x.flow.packing,
          packedQty: qty,
          rejectedQty: rejKg,
          rejectReason: rejKg > 0 ? (rejectReason || 'Dent / damage') : '',
          packUnits: units,
          packUnitLabel: unitLabel,
          packages: `${units} ${unitLabel}`,
          station: station || x.packingStation || '',
          tag,
          note: note || '',
          packedAt: now,
          packedBy: user.name,
        },
      },
      history: [...x.history, histEntry(x, `Packed ${fmtQty(qty, x.unit)} (${units} ${unitLabel})${rejKg > 0 ? ` · ${fmtQty(rejKg, x.unit)} rejected (${rejectReason || 'Dent / damage'})` : ''} — ${tag} (${tag === 'Make to stock' ? 'to Warehouse' : 'to Dispatch'}) · inspection lot ${lotNo} created`, now)],
    }));
    addOrIncrementFinished(b.spec || 'Unspecified', b.unit, qty, { category: fgCategoryOfRoute(b.route), altQty: units, altUnit: unitLabel });
    postMaterialDocument({ movementType: '101', materialNumber: materialNumberForSpec(b.spec || 'Unspecified'), materialName: b.spec || 'Unspecified', quantity: qty, unit: b.unit, storageLocation: 'QI01', refDoc: b.productionOrderNo || b.batchCode });
    if (totalScrap > 0) {
      postMaterialDocument({ movementType: '551', materialNumber: materialNumberForSpec(b.spec || 'Unspecified'), materialName: b.spec || 'Unspecified', quantity: totalScrap, unit: b.unit, storageLocation: 'SCRP', refDoc: b.productionOrderNo || b.batchCode });
    }
    if (b.orderId) {
      const ord = ordersRef.current.find(o => o.id === b.orderId);
      if (ord && ['New', 'In Production'].includes(ord.status)) updateOrderStatus(ord.id, 'QC');
    }
    notifyRoles(['Quality'], `${b.productionOrderNo} · ${b.spec} · ${fmtQty(qty, b.unit)} packed (${tag}) — inspection lot ${lotNo} awaiting usage decision.`, 'awaiting_quality', { batchId: id, tag, lotNo });
    return { ok: true };
  };

  // ---- Quality: tag "Released for dispatch" ----
  const qualityDecision = (id, { status, note, inspector }) => {
    const b = batchById(id);
    if (!b || !['AWAIT_QC', 'QC_HOLD'].includes(batchFlowState(b))) return { error: 'This production order is not waiting for quality.' };
    const now = new Date().toISOString();
    if (status === 'Hold') {
      if (!String(note || '').trim()) return { error: 'Write why the material is on hold.' };
      const lotNo = b.flow.inspectionLot?.lotNo || b.flow.quality?.lotNo || drawDocNumber('inspectionLot');
      const firstHold = batchFlowState(b) === 'AWAIT_QC';
      patchBatches([id], x => ({ ...x, flow: { ...x.flow, quality: { status: 'Hold', lotNo, holdAt: now, holdBy: user.name, inspector: inspector || user.name, note: note.trim() } }, history: [...x.history, histEntry(x, `Quality hold on inspection lot ${lotNo} — ${note.trim()}`, now)] }));
      // stock moves from quality-inspection stock to blocked stock (344)
      if (firstHold) postMaterialDocument({ movementType: '344', materialNumber: materialNumberForSpec(b.spec || 'Unspecified'), materialName: b.spec || 'Unspecified', quantity: batchPackedQty(b), unit: b.unit, storageLocation: 'BLK1', refDoc: b.productionOrderNo || b.batchCode });
      return { ok: true };
    }
    const lotNo = b.flow.inspectionLot?.lotNo || b.flow.quality?.lotNo || drawDocNumber('inspectionLot');
    const fromBlocked = batchFlowState(b) === 'QC_HOLD';
    patchBatches([id], x => {
      const moved = { ...x, currentStageIndex: batchStages(x).indexOf('Dispatch'), flow: { ...x.flow, quality: { status: QUALITY_RELEASED, lotNo, releasedAt: now, releasedBy: user.name, inspector: inspector || user.name, note: note || '' } } };
      return { ...moved, history: [...x.history, histEntry(moved, `Usage decision A — released for dispatch — inspection lot ${lotNo}`, now)] };
    });
    // usage decision A: stock moves to unrestricted-use (321 from quality inspection, 343 from blocked)
    postMaterialDocument({ movementType: fromBlocked ? '343' : '321', materialNumber: materialNumberForSpec(b.spec || 'Unspecified'), materialName: b.spec || 'Unspecified', quantity: batchPackedQty(b), unit: b.unit, storageLocation: 'FG01', refDoc: b.productionOrderNo || b.batchCode });
    if (b.orderId) {
      const ord = ordersRef.current.find(o => o.id === b.orderId);
      if (ord && ['New', 'In Production', 'QC'].includes(ord.status)) updateOrderStatus(ord.id, 'Ready to Dispatch');
    }
    const tag = b.flow.packing?.tag;
    notifyRoles(['Dispatch'], `${b.productionOrderNo} · ${b.spec} · ${fmtQty(batchRemainingQty(b), b.unit)} released for dispatch${tag ? ` (${tag})` : ''}${b.orderId ? '' : ' — no linked order'}.`, 'released_for_dispatch', { batchId: id, lotNo });
    return { ok: true, lotNo };
  };

  // ---- Dispatch ----
  const setDispatchDecision = (id, { decision, note }) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'RELEASED') return { error: 'This production order is not released for dispatch.' };
    patchBatches([id], x => {
      const { dispatchDecision, ...flow } = x.flow;
      const nowIso = new Date().toISOString();
      return decision === 'Keep'
        ? { ...x, flow: { ...flow, dispatchDecision: { decision: 'Keep', note: note || '', at: nowIso, by: user.name } }, history: [...x.history, histEntry(x, `Dispatch decision: keep in stock${note ? ` — ${note}` : ''}`, nowIso)] }
        : { ...x, flow };
    });
    return { ok: true };
  };
  const issueFinished = (spec, unit, qty, refDoc, altQty = 0) => {
    const prev = finishedRef.current;
    const own = prev.filter(f => !isImportedItem(f));   // a basket made here never draws down imported stock
    const m = own.find(f => specKey(f.spec) === specKey(spec) && f.unit === unit && Number(f.qty) > 0) || own.find(f => specKey(f.spec) === specKey(spec) && f.unit === unit);
    const next = m ? prev.map(f => f.id === m.id ? { ...f, qty: Math.max(0, Number(f.qty) - qty), altQty: Math.max(0, (Number(f.altQty) || 0) - altQty) } : f) : prev;
    finishedRef.current = next;
    setFinishedItems(next);
    saveShared(KEYS.finished, next);
    postMaterialDocument({ movementType: '601', materialNumber: materialNumberForSpec(spec), materialName: spec, quantity: qty, unit, storageLocation: 'FG01', refDoc });
  };
  // lines: [{ batchId, qty, kg }]. `qty` is in the ORDER's unit of measure (kg, boxes or meters);
  // `kg` is the weight taken from that production order (production is counted in kg). For an
  // order in kg they are the same number; for boxes / meters both must be entered.
  const postDelivery = ({ orderId, vehicle, lrNo, remarks, lines, importedLines }) => {
    const order = ordersRef.current.find(o => o.id === orderId);
    if (!order) return { error: 'Choose an order.' };
    if (isOrderClosed(order)) return { error: 'That order is already closed.' };
    const otherUom = ['boxes', 'meters'].includes(order.unit);
    let total = 0, totalKg = 0;
    const resolved = [];
    for (const l of (lines || [])) {
      const qty = Number(l.qty), kgIn = Number(l.kg);
      if (!(qty > 0) && !(otherUom && kgIn > 0)) continue;     // line not used
      const b = batchById(l.batchId);
      const tag = b?.productionOrderNo || b?.batchCode || 'a production order';
      if (!b || batchFlowState(b) !== 'RELEASED') return { error: 'Some of the selected material is not released for dispatch.' };
      if (!deliveryUnitOk(order, b)) return { error: `${tag} is in ${b.unit} but the order is in ${order.unit}.` };
      if (!(qty > 0)) return { error: `Enter the quantity in ${order.unit} for ${tag}.` };
      const kg = otherUom ? kgIn : qty;
      if (!(kg > 0)) return { error: `Enter the weight in kg taken from ${tag} (the order is in ${order.unit}).` };
      if (kg > batchRemainingQty(b) + 1e-9) return { error: `${tag} only has ${fmtQty(batchRemainingQty(b), b.unit)} left to dispatch.` };
      // pallets / boxes that leave with it: the boxes entered, else in proportion to the weight
      const packed = batchPackedQty(b), units = Number(b.flow?.packing?.packUnits) || 0;
      let altIssued = units > 0 && packed > 0 ? Math.round((kg / packed) * units * 100) / 100 : 0;
      if (order.unit === 'boxes' && b.flow?.packing?.packUnitLabel === 'boxes') altIssued = qty;
      total += qty; totalKg += kg;
      resolved.push({ b, qty, kg, altIssued });
    }
    // imported stock lines
    const impResolved = [];
    for (const l of (importedLines || [])) {
      const qty = Number(l.qty), kgIn = Number(l.kg);
      if (!(qty > 0) && !(otherUom && kgIn > 0)) continue;
      const item = finishedRef.current.find(f => f.id === l.finishedId);
      if (!item || !isImportedItem(item) || !importedCandidates(order, [item]).length) return { error: 'That imported stock is not available for this order (type or size differs).' };
      const tag = `${item.category} ${item.spec}`;
      if (!(qty > 0)) return { error: `Enter the quantity in ${order.unit} for ${tag}.` };
      const kg = otherUom ? kgIn : qty;
      if (!(kg > 0)) return { error: `Enter the weight in kg taken from ${tag} (the order is in ${order.unit}).` };
      if (kg > Number(item.qty) + 1e-9) return { error: `${tag} only has ${fmtQty(item.qty, 'kg')} in stock.` };
      const altU = item.altUnit || fgAltUnit(item.category);
      const units = order.unit === 'boxes' && altU === 'boxes' ? qty : Number(l.units);
      if (!(units > 0) || !Number.isInteger(units)) return { error: `Enter the number of ${altU} taken from ${tag} (a whole number).` };
      if (units > (Number(item.altQty) || 0) + 1e-9) return { error: `${tag} only has ${Number(item.altQty) || 0} ${altU} in stock.` };
      total += qty; totalKg += kg;
      impResolved.push({ item, qty, kg, units, altU });
    }
    if (!resolved.length && !impResolved.length) return { error: 'Enter a quantity against at least one production order or imported stock item.' };
    const pending = orderPendingQty(order);
    const maxQty = orderMaxDispatchQty(order);
    if (total > maxQty + 1e-9) return { error: `That is more than the ${fmtQty(maxQty, order.unit)} that can still be dispatched on this order (${fmtQty(pending, order.unit)} pending${toleranceFor(order.unit) ? ` + ${toleranceFor(order.unit)} kg tolerance` : ''}).` };
    const deliveryNo = drawDocNumber('delivery');
    const now = new Date().toISOString();
    const delivery = {
      id: uid(), deliveryNo, orderId, orderNo: order.orderNo || null, salesOrderNo: order.salesOrderNo || null, customer: order.customer, location: order.location || '',
      spec: order.spec || '', unit: order.unit,
      date: todayKey(), dispatchedAt: now, dispatchedBy: user.name, vehicle: vehicle || '', lrNo: lrNo || '', remarks: remarks || '', totalQty: total, totalKg,
      lines: resolved.map(({ b, qty, kg, altIssued }) => ({ batchId: b.id, batchCode: b.batchCode, productionOrderNo: b.productionOrderNo || null, shellNo: shellInfoOf(b, Object.fromEntries(batchesRef.current.map(x => [x.id, x])))?.no ?? null, spec: b.spec, qty, kg, units: altIssued || null, unitLabel: b.flow?.packing?.packUnitLabel || null, tag: b.flow?.packing?.tag || null })).concat(impResolved.map(({ item, qty, kg, units, altU }) => ({ source: 'imported', finishedId: item.id, category: item.category, spec: item.spec, qty, kg, units, unitLabel: altU }))),
    };
    commitDeliveries([delivery, ...deliveriesRef.current]);
    const byId = Object.fromEntries(resolved.map(r => [r.b.id, r]));
    commitBatches(batchesRef.current.map(b => {
      if (!(b.id in byId)) return b;
      const { qty, kg, altIssued } = byId[b.id];
      const { dispatchDecision, ...flow } = b.flow || {};
      const dispatched = batchDispatchedQty(b) + kg;
      const full = dispatched >= batchPackedQty(b) - 1e-9;
      const entry = histEntry(b, `Delivery ${deliveryNo}: ${fmtQty(qty, order.unit)}${order.unit === 'kg' ? '' : ` (${fmtQty(kg, 'kg')})`}${full ? ' — fully dispatched' : ''}`, now);
      return { ...b, flow: { ...flow, dispatchedQty: dispatched, dispatchedUnits: Math.round(((Number(flow.dispatchedUnits) || 0) + altIssued) * 100) / 100 }, status: full ? 'Complete' : b.status, history: [...b.history, entry] };
    }));
    const newDispatched = orderDispatchedQty(order) + total;
    const newStatus = isFullyDispatched(order.qty, newDispatched, order.unit) ? 'Dispatched' : 'Part Dispatched';
    const updatedOrder = { ...order, dispatchedQty: newDispatched, status: newStatus };
    commitOrders(ordersRef.current.map(o => o.id === orderId ? updatedOrder : o));
    syncOrderTracking(updatedOrder);
    resolved.forEach(({ b, kg, altIssued }) => issueFinished(b.spec, b.unit, kg, deliveryNo, altIssued));
    impResolved.forEach(({ item, kg, units }) => issueImported(item, kg, units, deliveryNo));
    const left = isFullyDispatched(order.qty, newDispatched, order.unit) ? 0 : Math.max(0, Number(order.qty) - newDispatched);
    logAudit({ actor: user.name, action: 'delivery', entityType: 'order', entityId: orderId, details: { deliveryNo, qty: total, uom: order.unit, kg: totalKg, pending: left } });
    notifyRoles(['Sales'], `Delivery ${deliveryNo}: ${fmtQty(total, order.unit)}${order.unit === 'kg' ? '' : ` (${fmtQty(totalKg, 'kg')})`} dispatched to ${order.customer}${order.location ? `, ${order.location}` : ''}${(order.orderNo || order.salesOrderNo) ? ` (order ${orderLabel(order)})` : ''}. ${left > 0 ? `${fmtQty(left, order.unit)} still pending.` : 'Order fully dispatched.'}`, 'delivery', { deliveryNo, orderId });
    return { ok: true, deliveryNo, pending: left };
  };
  // Dispatched less than ordered and nothing more is coming: close the order
  // at what shipped, with the reason on record.
  const shortCloseOrder = (orderId, { reason, note }) => {
    const order = ordersRef.current.find(o => o.id === orderId);
    if (!order) return { error: 'Order not found.' };
    if (isOrderClosed(order)) return { error: 'That order is already closed.' };
    const dispatched = orderDispatchedQty(order);
    if (!(dispatched > 0)) return { error: 'Nothing has been dispatched on this order yet. Edit or remove it instead of short closing.' };
    const pending = orderPendingQty(order);
    if (!(pending > 0)) return { error: 'There is no pending quantity to short close.' };
    if (!String(reason || '').trim()) return { error: 'Choose the reason for short closing.' };
    if (reason === 'Other' && !String(note || '').trim()) return { error: 'Describe the reason in the note.' };
    const now = new Date().toISOString();
    const updated = { ...order, status: 'Short Closed', shortClosed: { qty: pending, dispatchedQty: dispatched, reason, note: note || '', at: now, by: user.name } };
    commitOrders(ordersRef.current.map(o => o.id === orderId ? updated : o));
    syncOrderTracking(updated);
    logAudit({ actor: user.name, action: 'short_close', entityType: 'order', entityId: orderId, details: { cancelledQty: pending, dispatched, reason, note } });
    notifyRolesMasked(['Production', 'Packing', 'Dispatch', 'Manager'], (see) => `Order ${see ? `${orderLabel(order)} ${order.customer}` : 'for a size'} short closed by ${user.name}: ${fmtQty(dispatched, order.unit)} of ${fmtQty(order.qty, order.unit)} shipped, ${fmtQty(pending, order.unit)} cancelled (${reason}).`, 'short_close', { orderId });
    return { ok: true };
  };
  const reopenShortClosed = (orderId) => {
    const order = ordersRef.current.find(o => o.id === orderId);
    if (!order || order.status !== 'Short Closed') return { error: 'That order is not short closed.' };
    const { shortClosed, ...rest } = order;
    const status = isFullyDispatched(order.qty, orderDispatchedQty(order), order.unit) ? 'Dispatched' : 'Part Dispatched';
    const updated = { ...rest, status, shortCloseHistory: [...(order.shortCloseHistory || []), { ...shortClosed, reopenedAt: new Date().toISOString(), reopenedBy: user.name }] };
    commitOrders(ordersRef.current.map(o => o.id === orderId ? updated : o));
    syncOrderTracking(updated);
    logAudit({ actor: user.name, action: 'reopen', entityType: 'order', entityId: orderId });
    return { ok: true };
  };
  // Released and dispatched as far as needed; the rest stays as finished stock.
  // ---- TEMPORARY Admin testing tool: wipe the business data (see AdminClearData) ----
  const clearAllData = ({ confirmText }) => {
    if (user.role !== 'Admin') return { error: 'Only an Admin can clear the data.' };
    if (String(confirmText || '').trim() !== 'CLEAR') return { error: 'Type CLEAR (capital letters) to confirm.' };
    const wipe = [
      [KEYS.orders, [], setOrders], [KEYS.plans, {}, setDailyPlans], [KEYS.spinnerPlans, {}, setSpinnerPlans], [KEYS.batches, [], setBatches], [KEYS.raw, [], setRawItems], [KEYS.finished, [], setFinishedItems],
      [KEYS.downtime, {}, setDowntimeLogs], [KEYS.dprEntries, {}, setDprEntries], [KEYS.dprMachineProd, {}, setMachineProd], [KEYS.dprDowntimeQuality, {}, setDq],
      [KEYS.dprWipBuffer, { limits: {}, days: {} }, setWipBuffer], [KEYS.dprTargetActual, {}, setTargetActual], [KEYS.notifications, [], setNotifications], [KEYS.maintenance, [], setMaintenanceLogs],
      [KEYS.rawConsumption, [], setRawConsumption], [KEYS.capa, [], setCapaRecords], [KEYS.pmTasks, [], setPmTasks], [KEYS.kaizen, [], setKaizenIdeas], [KEYS.matDocs, [], setMatDocs], [KEYS.purchaseOrders, [], setPurchaseOrders],
      [KEYS.numberRanges, {}, setNumberRanges], [KEYS.planMeta, {}, setPlanMeta], [KEYS.dispatchPlans, {}, setDispatchPlans], [KEYS.annealCharges, [], setAnnealCharges],
      [KEYS.pullRequests, [], setPullRequests], [KEYS.deliveries, [], setDeliveries], [KEYS.costOfProduction, {}, setCostData], [KEYS.heats, [], setHeats],
      [KEYS.processPlans, {}, setProcessPlans], [KEYS.dprClosed, {}, setDprClosed],
    ];
    wipe.forEach(([key, empty, setter]) => { setter(empty); saveShared(key, empty); });
    ordersRef.current = []; batchesRef.current = []; finishedRef.current = []; requestsRef.current = []; rangesRef.current = {}; spinnerPlansRef.current = {}; heatsRef.current = [];
    logAudit({ actor: user.name, action: 'clear_all_data', entityType: 'system', entityId: 'all', details: { lists: wipe.length } });
    return { ok: true, cleared: wipe.length };
  };

  // ---- Melting & Casting: cast a heat = 2 shells = 2 production orders, with the raw material used (MT per kind) ----
  const createHeat = (f) => {
    if (!canActMelting(user.role)) return { error: 'Only the Melting Supervisor, the Production Manager or a Manager can cast a heat.' };
    const date = todayKey();
    const v = validateHeat(f, { batches: batchesRef.current, rawItems: rawItemsRef.current, date });
    if (!v.valid) return { error: Object.values(v.errors)[0], errors: v.errors };
    const now = new Date().toISOString();
    const heatId = uid();
    const pos = [drawDocNumber('productionOrder'), drawDocNumber('productionOrder')];   // numbers are drawn only after every check passed
    const mk = (i) => ({
      id: uid(), batchCode: v.codes[i], productionOrderNo: pos[i], qty: v.shells[i].weight, unit: 'kg', orderId: null, rawMaterialId: null,
      spec: null, spinnerMachine: null, route: null, routeMachine: null, targetOD: null, toleranceOD: null, targetThickness: null, toleranceThickness: null,
      currentStageIndex: 0, status: 'In Progress', startedAt: now, scrapLog: [], passMeasurements: [],
      history: [{ stageIndex: 0, label: `Cast at ${v.furnace.name} — shell ${v.shells[i].no} (heat ${v.codes.join(' + ')})`, at: now, by: user.name }],
      heatId, furnace: v.furnace.name, shellNo: v.shells[i].no,
    });
    const [b1, b2] = [mk(0), mk(1)];
    const mtOf = Object.fromEntries(v.lines.map(l => [RAW_KIND_FIELD[l.kind], l.mt]));
    const heat = {
      id: heatId, furnace: v.furnace.name, furnaceCode: v.furnace.code, date, at: now, by: user.name,
      shells: [b1, b2].map(b => ({ batchId: b.id, shellNo: b.shellNo, code: b.batchCode, productionOrderNo: b.productionOrderNo, weightKg: b.qty })),
      raw: { cathodeMT: mtOf.cathodeMT || 0, billetMT: mtOf.billetMT || 0, rodMT: mtOf.rodMT || 0, totalMT: v.rawTotalMT, lines: v.lines },
    };
    commitBatches([...batchesRef.current, b1, b2]);
    commitHeats([heat, ...heatsRef.current]);
    // goods issue (261) to the first production order of the heat, one document per raw material
    v.lines.filter(l => l.deducted).forEach(l => adjustRaw(l.itemId, -l.qty, { movementType: '261', refDoc: pos[0] }));
    notifyRoles(['Production', 'Manager', 'Assistant Manager'], `Heat cast at ${v.furnace.name}: shells ${v.codes[0]} (${fmtQty(b1.qty, 'kg')}) and ${v.codes[1]} (${fmtQty(b2.qty, 'kg')}); raw material ${v.rawTotalMT} MT.`, 'heat_cast', { heatId, codes: v.codes });
    logAudit({ actor: user.name, action: 'heat', entityType: 'melting_heat', entityId: heatId, details: { furnace: v.furnace.name, codes: v.codes, rawMT: v.rawTotalMT } });
    return { ok: true, heatId, codes: v.codes, productionOrders: pos };
  };
  // shell number and weight stay editable while the shell is still at Melting & Casting
  const editShell = (id, { shellNo, weight }) => {
    if (!canActMelting(user.role)) return { error: 'Only the Melting Supervisor, the Production Manager or a Manager can edit a shell.' };
    const b = batchById(id);
    if (!b || !b.heatId || b.currentStageIndex !== 0 || b.status === 'Complete') return { error: 'Only a shell that is still at Melting & Casting can be edited.' };
    const heat = heatsRef.current.find(h => h.id === b.heatId);
    const furnace = furnaceByName(b.furnace);
    const n = Number(shellNo), w = Number(weight);
    if (!Number.isInteger(n) || n < 1 || n > 9999) return { error: 'Enter the shell number (a whole number, 1 or more).' };
    if (!(w > 0) || w > 50000) return { error: 'Enter the weight in kg.' };
    const code = shellCode(furnace.code, heat?.date || todayKey(), n);
    if (batchesRef.current.some(x => x.id !== id && String(x.batchCode || '').toLowerCase() === code.toLowerCase())) return { error: `Batch code ${code} already exists — use another shell number.` };
    const iso = new Date().toISOString();
    patchBatches([id], x => ({ ...x, batchCode: code, shellNo: n, qty: w, history: [...x.history, histEntry(x, `Shell edited: ${x.batchCode} ${fmtQty(x.qty, 'kg')} → ${code} ${fmtQty(w, 'kg')}`, iso)] }));
    if (heat) commitHeats(heatsRef.current.map(h => h.id === heat.id ? { ...h, shells: h.shells.map(sh => sh.batchId === id ? { ...sh, shellNo: n, code, weightKg: w } : sh) } : h));
    logAudit({ actor: user.name, action: 'shell_edit', entityType: 'production_order', entityId: id, details: { from: b.batchCode, to: code, weight: w } });
    return { ok: true, code };
  };

  const closeProductionOrder = (id) => {
    const b = batchById(id);
    if (!b || batchFlowState(b) !== 'RELEASED') return { error: 'Only a released production order can be closed.' };
    patchBatches([id], x => ({ ...x, status: 'Complete', history: [...x.history, histEntry(x, `Closed — ${fmtQty(batchRemainingQty(x), x.unit)} kept in stock`)] }));
    return { ok: true };
  };

  // ---- Cost of production ----
  const updateCostMonth = (month, patch) => setCostData(prev => {
    const next = { ...prev, [month]: { ...(prev[month] || {}), ...patch } };
    saveShared(KEYS.costOfProduction, next); return next;
  });

  masterRefLists.current = master.lists || {};
  masterRefLinks.current = master.customerLinks || {};
  masterRefData.current = master;
  const isCustomer = user?.role === 'Customer';
  const customerLink = isCustomer ? ((master.customerLinks || {})[String(user.name || '').toLowerCase()] || '') : '';
  const scoped = isCustomer ? scopeForCustomer({ orders, deliveries, dispatchPlans }, customerLink) : null;
  ACCESS.overrides = master.access || {};
  APP_CONFIG.lists = master.lists || {};
  APP_CONFIG.dueSoonDays = settingValue(settings, 'dueSoonDays');
  APP_CONFIG.furnaceActiveHours = settingValue(settings, 'furnaceActiveHours');

  return (
    <div style={{ fontFamily: "'Inter', sans-serif", color: C.ink }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap');
        /* Fiori uses a single humanist sans throughout rather than a separate
           display face -- headings are the same family at heavier weight.
           Inter stands in for SAP's own "72" typeface. */
        .font-display { font-family: 'Inter', sans-serif; letter-spacing: -0.01em; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        * { box-sizing: border-box; }
        button { font-family: inherit; }
        input:focus-visible, select:focus-visible, button:focus-visible {
          outline: 2px solid ${C.copper}; outline-offset: 1px;
        }
        .hover-lift { transition: transform 0.1s ease, box-shadow 0.15s ease; }
        .hover-lift:hover { transform: translateY(-1px); box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
        @keyframes pulseNode {
          0% { box-shadow: 0 0 0 0 rgba(184,112,58,0.45); }
          70% { box-shadow: 0 0 0 7px rgba(184,112,58,0); }
          100% { box-shadow: 0 0 0 0 rgba(184,112,58,0); }
        }
        .pulse-node { animation: pulseNode 2s ease-out infinite; }
        @media (prefers-reduced-motion: reduce) {
          .pulse-node { animation: none; }
          .hover-lift { transition: none; }
        }
        /* Fiori shape language: tighter radii than the previous theme, and a
           flat shell bar that stays put while content scrolls under it. */
        .fiori-shellbar { position: sticky; top: 0; z-index: 30; }
        @media (max-width: 720px) {
          .shellbar-plant, .shellbar-sync, .shellbar-kbd { display: none !important; }
        }
        .master-field-row { display: grid; grid-template-columns: minmax(180px, 1.2fr) minmax(130px, 0.8fr) minmax(0, 1.6fr); gap: 12px; align-items: center; }
        @media (max-width: 700px) { .master-field-row { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
        @media (max-width: 560px) {
          .fiori-shellbar { padding: 0 10px !important; gap: 8px !important; }
          .shellbar-title { font-size: 13px !important; overflow: hidden; text-overflow: ellipsis; max-width: 38vw; }
          .shellbar-search { padding: 5px 8px !important; margin: 0 0 0 auto !important; width: auto !important; }
          .shellbar-search-text { display: none; }
          .main-pad { padding: 14px 12px !important; }
        }
        @media (max-width: 860px) {
          .sidebar-desktop { display: none !important; }
          .nav-mobile { display: flex !important; }
          .dash-grid { grid-template-columns: 1fr !important; }
          .quick-entry-fab { display: flex !important; }
        }
        .dash-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        @media (max-width: 1100px) { .dash-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 560px) { .dash-strip { grid-template-columns: 1fr; } }
        .print-only { display: none; }
        @media print {
          .sidebar-desktop, .nav-mobile, .no-print, header { display: none !important; }
          .print-only { display: block !important; }
          body, main { background: #fff !important; padding: 0 !important; }
          main { padding: 0 20px !important; }
          table { page-break-inside: auto; }
          tr { page-break-inside: avoid; }
        }
      `}</style>

      {trackingCode ? (
        <TrackOrderScreen code={trackingCode} />
      ) : recoveryToken ? (
        <ResetPasswordScreen accessToken={recoveryToken} onDone={() => { window.location.hash = ''; window.location.reload(); }} />
      ) : userLoading ? (
        <LoadingScreen />
      ) : !user ? (
        <IdentityScreen onSubmit={handleSetUser} />
      ) : dataLoading ? (
        <LoadingScreen />
      ) : (SHARED_LOGIN_ROLES.includes(user.role) && !user.actingAsConfirmed) ? (
        <ActingAsGate user={user} shiftNames={shiftNames} onConfirm={handleConfirmActing} onLogout={handleLogout} />
      ) : (
        <BatchIndexCtx.Provider value={batchIndex}>
        <MasterDataCtx.Provider value={{ customers: master.customers || [], sizes: master.sizes || [], standards: master.standards || [], standardRequired: master.standardRequired || {}, toleranceLocked: master.toleranceLocked || {}, potCapacityKg: settingValue(settings, 'potCapacityKg'), capacities: master.capacities || {}, shiftDayStart: settingValue(settings, 'shiftDayStart'), shiftNightStart: settingValue(settings, 'shiftNightStart'), orderListClosestFirst: settingValue(settings, 'orderListClosestFirst'), seeCustomer: canDo(user.role, 'customer.see'), specs: (master.lists || {}).specifications?.items || [], canAdd: canDo(user.role, 'master.add'), save: addMasterFromForm }}>
        <ReportCtx.Provider value={{ batches, heats, orders, deliveries, charges: annealCharges, labResults, pmTasks, cycleCounts, rawItems, finishedItems, maintenanceLogs, toolingItems, energyLogs, capaRecords, dprEntries, machineProd, spinnerPlans, processPlans, dprClosed }}>
        {loadProblem > 0 && (
          <div role="alert" data-testid="load-problem-banner" style={{ position: 'fixed', top: 0, left: 0, right: 0, zIndex: 9999, background: '#b3261e', color: '#fff', padding: '10px 16px', fontSize: 13.5, fontWeight: 600, textAlign: 'center' }}>
            Some data could not be loaded, so saving is paused to protect what is stored. Do not enter new data. Check your connection and refresh the page.
            <button type="button" onClick={() => window.location.reload()} style={{ marginLeft: 12, padding: '4px 12px', borderRadius: 6, border: '1px solid #fff', background: 'transparent', color: '#fff', cursor: 'pointer', fontWeight: 700 }}>Refresh</button>
          </div>
        )}
        <Shell tab={tab} setTab={setTab} user={user} onLogout={handleLogout} lastSync={lastSync} onRefresh={loadAll}
          notifications={notifications} onMarkNotificationsRead={markNotificationsRead} isOnline={isOnline} pendingSyncCount={pendingSyncCount}
          orders={scoped ? scoped.orders : orders} settings={settings} onUpdateSettings={updateSettings} onAddOrder={addOrder} onAddMaintenance={addMaintenance} pullRequests={pullRequests}>
          {isCustomer && <CustomerBanner user={user} link={customerLink} />}
          <SpaceBackBar tab={tab} setTab={setTab} />
          {tab === 'launchpad' && <HomePage setTab={setTab} prefs={userPrefsAll[String((user && user.name) || '').toLowerCase()]} onSavePref={saveUserPref} orders={orders} dailyPlans={dailyPlans} batches={batches} rawItems={rawItems}
            maintenanceLogs={maintenanceLogs} capaRecords={capaRecords} pmTasks={pmTasks} costData={costData} machineProd={machineProd}
            dprEntries={dprEntries} rawConsumption={rawConsumption} user={user} toolingItems={toolingItems} energyLogs={energyLogs}
            capacities={master.capacities || {}} 
            planMeta={planMeta} spinnerPlans={spinnerPlans} dispatchPlans={dispatchPlans} deliveries={deliveries} heats={heats} settings={settings} onClearAll={clearAllData} />}
          {tab === 'qmlots' && <QMLotsTab batches={batches} />}
          {tab === 'matdocs' && <MaterialDocsTab matDocs={matDocs} rawItems={rawItems} finishedItems={finishedItems} />}
          {SPACE_HUBS[tab] && <SpaceHubTab hubKey={tab} setTab={setTab} user={user} data={{ batches, maintenanceLogs, pullRequests, rawItems, capaRecords, cycleCounts, orders, purchaseOrders }} />}
          {tab === 'migo' && <GoodsReceiptPoTab rawItems={rawItems} finishedItems={finishedItems} matDocs={matDocs} purchaseOrders={purchaseOrders} onAdjustRaw={adjustRaw} onAdjustFinished={adjustFinished} onSetPrice={setMaterialPrice} onReceivePO={receivePurchaseOrder} user={user} setTab={setTab} />}
          {tab === 'purchaseorders' && <PurchaseOrdersTab purchaseOrders={purchaseOrders} rawItems={rawItems} finishedItems={finishedItems} onCreate={createPurchaseOrder} onCancel={cancelPurchaseOrder} user={user} setTab={setTab} />}
          {tab === 'matprices' && <MaterialPricesTab rawItems={rawItems} finishedItems={finishedItems} onSetPrice={setMaterialPrice} user={user} setTab={setTab} />}
          {tab === 'overduepo' && <OverdueMaterialsTab purchaseOrders={purchaseOrders} setTab={setTab} />}
          {tab === 'stocksingle' && <StockSingleMaterialTab rawItems={rawItems} finishedItems={finishedItems} matDocs={matDocs} setTab={setTab} />}
          {tab === 'deadstock' && <DeadStockTab rawItems={rawItems} finishedItems={finishedItems} matDocs={matDocs} setTab={setTab} />}
          {tab === 'slowmoving' && <SlowMovingTab rawItems={rawItems} finishedItems={finishedItems} matDocs={matDocs} setTab={setTab} />}
          {tab === 'analyzestock' && <AnalyzeStockTab rawItems={rawItems} finishedItems={finishedItems} matDocs={matDocs} setTab={setTab} />}
          {tab === 'conpurchase' && <ConsumablesPurchaseTab user={user} setTab={setTab} />}
          {tab === 'constore' && <ConsumablesStoreTab user={user} setTab={setTab} />}
          {tab === 'concost' && <ConsumablesCostTab batches={batches} user={user} setTab={setTab} />}
          {tab === 'orders' && <OrdersTab orders={scoped ? scoped.orders : orders} batches={scoped ? [] : batches} deliveries={scoped ? scoped.deliveries : deliveries} dispatchPlans={scoped ? scoped.dispatchPlans : dispatchPlans} onAdd={addOrder} onUpdateStatus={updateOrderStatus} onDelete={deleteOrder}
            onShortClose={shortCloseOrder} onReopen={reopenShortClosed} user={user} settings={settings} onUpdateSettings={updateSettings} setTab={setTab} />}
          {tab === 'schedule' && <ScheduleTab orders={orders} dprEntries={dprEntries} />}
          {tab === 'plan' && <DailyPlanTab dailyPlans={dailyPlans} onAddRow={addPlanRow} onUpdateActual={updateActual} onDeleteRow={deletePlanRow}
            downtimeLogs={downtimeLogs} onAddDowntime={addDowntime} onDeleteDowntime={deleteDowntime}
            spinnerPlans={spinnerPlans} planMeta={planMeta} dispatchPlans={dispatchPlans} orders={orders} deliveries={deliveries} batches={batches} finishedItems={finishedItems}
            onAddPlanLine={addPlanLine} onUpdatePlanLine={updatePlanLine} onDeletePlanLine={deletePlanLine} onUpdateSpinnerPlanActual={updateSpinnerPlanActual}
            processPlans={processPlans} onUpdateProcessPlan={updateProcessPlan} onCopyProcessPlan={copyProcessPlan}
            onReleasePlan={releasePlan} onReopenPlan={reopenPlan} onSetNoDispatch={setNoDispatch}
            onAddDispatchLine={addDispatchLine} onDeleteDispatchLine={deleteDispatchLine}
            machines={machines} onUpdateMachines={updateMachines} user={user} />}
          {tab === 'plan' && <RawMaterialRequestsPanel orders={orders} rawItems={rawItems} user={user} />}
          {tab === 'stages' && <StageTrackingTab batches={batches} orders={orders} rawItems={rawItems} machines={machines} spinnerPlans={spinnerPlans} planMeta={planMeta} deliveries={deliveries} user={user} setTab={setTab}
            onAdvance={advanceStage} onBack={backStage} onDelete={deleteBatch} onLogScrap={logScrap} onLogPass={logPass} onCompleteRework={completeRework}
            onSetRoute={setBatchRoute} onCloseOrder={closeProductionOrder} onSaveCoils={updateCoilRecord}
            heats={heats} maintenanceLogs={maintenanceLogs} onCastHeat={createHeat} onEditShell={editShell} />}
          {tab === 'floor' && <ShopFloorTab batches={batches} charges={annealCharges} requests={pullRequests} spinnerPlans={spinnerPlans} machines={machines} user={user}
            handlers={{ requestBasketsForSpinner, withdrawBasketRequest, startMachineRun, finishMachineRun, updateCoilRecord, holdBasket, decideHold, completeDownsize, createAnnealCharge, potIn, potOut, forwardCharge, cancelCharge, createPullRequest, cancelPullRequest, pullToPacking, finishPacking }} />}
          {tab === 'qchold' && <QcHoldSectionTab batches={batches} machines={machines} user={user} onDecide={decideHold} />}
          {tab === 'quality' && <QualityReleaseTab batches={batches} user={user} onDecision={qualityDecision} />}
          {tab === 'dispatch' && <DispatchTab batches={scoped ? [] : batches} orders={scoped ? scoped.orders : orders} deliveries={scoped ? scoped.deliveries : deliveries} finishedItems={scoped ? [] : finishedItems} dispatchPlans={scoped ? scoped.dispatchPlans : dispatchPlans} user={user} setTab={setTab}
            onPostDelivery={postDelivery} onDecision={setDispatchDecision} onSetReason={setDispatchReason} />}
          {tab === 'cost' && <CostOfProductionTab costData={costData} onUpdateMonth={updateCostMonth} batches={batches} dprEntries={dprEntries} machineProd={machineProd} settings={settings} user={user} charges={annealCharges} onUpdateSettings={updateSettings} />}
          {tab === 'inventory' && <><InventoryTab batches={batches} rawItems={rawItems} finishedItems={finishedItems} onAddRaw={addRaw} onAdjustRaw={adjustRaw} onDeleteRaw={deleteRaw} onAddFinished={addFinished} onAddFinishedBatch={addFinishedBatch} onAdjustFinished={adjustFinished} onDeleteFinished={deleteFinished} onSetFinishedCategory={setFinishedCategory} onSetRawKind={setRawKind} rawConsumption={rawConsumption} user={user} /><RawMaterialRequestsPanel orders={orders} rawItems={rawItems} user={user} /></>}
          {tab === 'bomMrp' && <BomMrpTab bom={bom} onAddBom={addBom} onDeleteBom={deleteBom} orders={orders} rawItems={rawItems} batches={batches} settings={settings} user={user} />}
          {tab === 'skills' && <SkillMatrixTab skillMatrix={skillMatrix} onUpdateLevel={updateSkillLevel} onRemovePerson={removeSkillPerson} user={user} />}
          {tab === 'cyclecount' && canSeeTab(user, 'cyclecount') && <CycleCountTab sessions={cycleCounts} rawItems={rawItems} finishedItems={finishedItems} onStart={startCycleCount} onSaveLine={saveCountLine} onRemoveLine={removeCountLine} onSubmit={submitCount} onDecide={decideCountLine} onClose={closeCount} onCancel={cancelCount} user={user} />}
          {tab === 'lab' && canSeeTab(user, 'lab') && <LabTab heats={heats} batches={batches} labResults={labResults} onAdd={addLabResult} onDelete={deleteLabResult} user={user} />}
          {tab === 'reports' && canSeeTab(user, 'reports') && <ReportsTab user={user} />}
          {tab === 'audit' && canSeeTab(user, 'audit') && <AuditTab user={user} />}
          {tab === 'tooling' && <ToolingTab toolingItems={toolingItems} onAddDie={addDie} onUpdateDieUsage={updateDieUsage} onSendForPolishing={sendDieForPolishing} onDeleteDie={deleteDie} user={user} />}
          {tab === 'energy' && <EnergyTrackingTab energyLogs={energyLogs} onLogMachineEnergy={logMachineEnergy} customEnergyMachines={settings.customEnergyMachines || []} onAddEnergyMachine={(m) => updateSettings({ customEnergyMachines: [...(settings.customEnergyMachines || []), m] })} onRemoveEnergyMachine={(id) => updateSettings({ customEnergyMachines: (settings.customEnergyMachines || []).filter(x => x.id !== id) })} user={user} />}
          {tab === 'kaizen' && <KaizenTab kaizenIdeas={kaizenIdeas} onAdd={addKaizen} onUpdateStatus={updateKaizenStatus} onDelete={deleteKaizen} user={user} />}
          {tab === 'dpr' && <DprTab dprEntries={dprEntries} onUpdateDpr={updateDprEntry}
            machineProd={machineProd}
            dq={dq} onUpdateDq={updateDq}
            wipBuffer={wipBuffer} onUpdateWipBuffer={updateWipBuffer} batches={batches} spinnerPlans={spinnerPlans}
            heats={heats} charges={annealCharges} processPlans={processPlans} dprClosed={dprClosed} onCorrectClosed={correctClosedShift}
            targetActual={targetActual} onUpdateTargetActual={updateTargetActual}
            user={user} />}
          {tab === 'maintenance' && <MaintenanceTab maintenanceLogs={maintenanceLogs} onAdd={addMaintenance} onResolve={resolveMaintenance} onSetInProgress={setMaintenanceInProgress} onDelete={deleteMaintenance} pmTasks={pmTasks} onAddPm={addPmTask} onMarkPmDone={markPmDone} onDeletePm={deletePmTask} user={user} />}
          {tab === 'capa' && <CapaTab capaRecords={capaRecords} onAdd={addCapa} onUpdateStatus={updateCapaStatus} onDelete={deleteCapa} user={user} />}
          {tab === 'spc' && <SpcTab batches={batches} />}
          {tab === 'trends' && <TrendsTab dailyPlans={dailyPlans} batches={batches} downtimeLogs={downtimeLogs} maintenanceLogs={maintenanceLogs} settings={settings} onUpdateSettings={updateSettings} />}
          {tab === 'master' && canSeeTab(user, 'master') && <MasterTab user={user} settings={settings} master={master} machines={machines}
            onSaveSettings={saveMasterSettings} onSaveList={saveMasterList} onUpdateMachines={updateMachines}
            onSaveAccess={saveMasterAccess} onResetAccess={resetMasterAccess} onCopyAccess={copyMasterAccess} onSaveData={saveMasterData} onSaveRequired={saveStandardRequired} onSaveTolLock={saveToleranceLocked} onSaveCapacities={saveMasterCapacities} orders={orders} />}
          {tab === 'team' && <TeamRolesTab userRoles={userRoles} onUpdate={updateUserRoles} shiftNames={shiftNames} onUpdateShiftNames={updateShiftNames} user={user} customerLinks={master.customerLinks || {}} onSaveCustomerLink={saveCustomerLink} />}
        </Shell>
        </ReportCtx.Provider>
        </MasterDataCtx.Provider>
        </BatchIndexCtx.Provider>
      )}
    </div>
  );
}

function NeelShellEnhancer({ onNavigate }) {
  const [themeId, setThemeId] = useState(() => localStorage.getItem('neel_active_theme') || 'morning_horizon');
  const [favOpen, setFavOpen] = useState(true);
  const [spacesOpen, setSpacesOpen] = useState(false);
  const [favIds, setFavIds] = useState(() => {
    try {
      const s = localStorage.getItem('neel_favorite_app_ids');
      return s ? JSON.parse(s) : ALL_NEEL_APPS_CATALOG.slice(0, 12).map(a => a.id);
    } catch { return []; }
  });

  useEffect(() => {
    const onTheme = (e) => setThemeId(e.detail || 'morning_horizon');
    const onFav = (e) => setFavIds(Array.isArray(e.detail) ? e.detail : []);
    window.addEventListener('neel-theme-changed', onTheme);
    window.addEventListener('neel-favorites-updated', onFav);
    return () => {
      window.removeEventListener('neel-theme-changed', onTheme);
      window.removeEventListener('neel-favorites-updated', onFav);
    };
  }, []);

  const theme = NEEL_THEMES[themeId] || NEEL_THEMES.morning_horizon;
  return null;
}
// neel-theme-changed-listener



