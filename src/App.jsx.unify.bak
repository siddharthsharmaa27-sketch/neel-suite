// the text a Master size has on a plan line / finished-goods line: the same "15 X 0.7 MM" the order form builds, so it matches orders and batches
function masterSizeSpec(sz) { return sz.thk ? buildDimSpec(sz.od, sz.thk) : `${fmt2(sz.od)} MM`; }
