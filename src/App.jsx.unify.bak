}
function standardSetActive(list, id, active) { return { standards: (list || []).map(x => x.id === id ? { ...x, active: !!active } : x) }; }
function standardRemove(list, id) { return { standards: (list || []).filter(x => x.id !== id) }; }
function standardsFor(list, stage) { return (list || []).filter(x => x.stage === stage && x.active !== false).sort((a, b) => a.name.localeCompare(b.name)); }
// the standard whose size text equals this size (same normalisation as everywhere else); null when none says so
