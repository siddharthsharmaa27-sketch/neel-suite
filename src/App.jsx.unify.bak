  if (name.length > 60) return { error: 'Use at most 60 characters for the name.' };
  if ((list || []).some(x => x.id !== exceptId && x.stage === stage && mdSame(x.name, name))) return { error: `"${name}" already exists for ${stage}.` };
  const od = standardNum(input.od), odTol = standardNum(input.odTol), thk = standardNum(input.thk), thkTol = standardNum(input.thkTol);
  if (!(od > 0)) return { error: 'Enter the OD target in mm (more than 0).' };
  if (!(odTol >= 0)) return { error: 'Enter the OD tolerance in mm (0 or more).' };
  if (odTol >= od) return { error: 'The OD tolerance must be smaller than the OD.' };
  if (!(thk > 0)) return { error: 'Enter the thickness target in mm (more than 0).' };
  if (!(thkTol >= 0)) return { error: 'Enter the thickness tolerance in mm (0 or more).' };
