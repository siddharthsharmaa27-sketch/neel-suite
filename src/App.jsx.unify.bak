/* =========================================================================
   ACCESS (Master > Access): every tab and every key action is a FEATURE; the Admin ticks which roles get which.
   The default for each feature is exactly what the code allowed before (so nothing changes until the Admin edits), written here as a rule.
   ACCESS.overrides = { role: { featureKey: true | false } } holds only the differences from the default; App sets it from ctpm:master on every render.
   ========================================================================= */
const ACCESS = { overrides: {} };
const ADMIN_FIXED_TABS = true;   // the Admin always keeps every tab (so it can never be locked out of Master / Access)
const rMach = (r) => r === 'Machine Supervisor' || isProductionManager(r) || isManagerRole(r);
const ACTION_FEATURES = [
  { key: 'orders.add', group: 'Orders & dispatch', label: 'Add and delete orders', rule: r => r === 'Sales' || r === 'Admin' },
  { key: 'orders.status', group: 'Orders & dispatch', label: 'Change an order\'s status', rule: r => ['Sales', 'Admin', 'Production', 'PPC Manager', 'Packing', 'Dispatch', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'orders.shortClose', group: 'Orders & dispatch', label: 'Short-close an order', rule: r => r === 'Sales' || isManagerRole(r) },
  { key: 'dispatch.act', group: 'Orders & dispatch', label: 'Post deliveries and decide on released stock', rule: r => r === 'Dispatch' || isManagerRole(r) },
  { key: 'plan.edit', group: 'Planning & production', label: 'Edit and release the production plan and dispatch plan', rule: r => isManagerRole(r) || r === 'PPC Manager' },
  { key: 'inventory.add', group: 'Inventory', label: 'Add inventory items / stock records', rule: r => ['Store', 'RM & Supply Chain Manager', 'Admin', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'inventory.adjust', group: 'Inventory', label: 'Adjust inventory quantities and material classification', rule: r => ['Store', 'RM & Supply Chain Manager', 'Admin', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'inventory.delete', group: 'Inventory', label: 'Delete inventory records', rule: r => ['Admin'].includes(r) },
  { key: 'inventory.import', group: 'Inventory', label: 'Import finished-goods inventory from Excel', rule: r => ['Store', 'RM & Supply Chain Manager', 'Admin', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'stock.count', group: 'Inventory', label: 'Run cycle counts (scan labels and count stock)', rule: r => ['Store', 'RM & Supply Chain Manager', 'Dispatch', 'Packing', 'Admin', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'stock.approve', group: 'Inventory', label: 'Approve cycle-count differences (posts to inventory)', rule: r => ['RM & Supply Chain Manager', 'Admin', 'Manager', 'Assistant Manager'].includes(r) },
  { key: 'melting.cast', group: 'Planning & production', label: 'Cast a heat and edit shells', rule: r => r === 'Melting Supervisor' || isProductionManager(r) || isManagerRole(r) },
  { key: 'cascade.act', group: 'Planning & production', label: 'Finish baskets at Cascade', rule: r => r === 'Cascade Operator' || isProductionManager(r) || isManagerRole(r) },
  { key: 'spinner.act', group: 'Planning & production', label: 'Request baskets and run the Spinner gate', rule: r => r === 'Spinner Supervisor' || isProductionManager(r) || isManagerRole(r) },
  { key: 'machine.act', group: 'Planning & production', label: 'Start and finish runs on LWC / PCC / CTL', rule: rMach },
  { key: 'coils.record', group: 'Planning & production', label: 'Record coils (LWC / PCC)', rule: r => rMach(r) || r === 'Quality' },
  { key: 'po.manage', group: 'Planning & production', label: 'Manage production orders (remove, route)', rule: r => !STATION_ROLES.includes(r) },
  { key: 'po.logActual', group: 'Planning & production', label: 'Log production actuals', rule: r => isProductionManager(r) || STATION_ROLES.includes(r) },
  { key: 'annealing.act', group: 'Planning & production', label: 'Annealing: pull into pots, pot in / out', rule: r => r === 'Annealing' || isManagerRole(r) },
  { key: 'packing.act', group: 'Planning & production', label: 'Packing: pull and pack', rule: r => r === 'Packing' || isManagerRole(r) },
  { key: 'lab.enter', group: 'Quality', label: 'Enter lab results (Spectro chemistry, tensile / yield / elongation / hardness)', rule: r => r === 'Quality' || r === 'Admin' },
  { key: 'quality.release', group: 'Quality', label: 'Release or hold packed material (usage decision)', rule: r => r === 'Quality' || isManagerRole(r) },
  { key: 'hold.put', group: 'Quality', label: 'Put an LWC basket on hold', rule: r => rMach(r) || r === 'Quality' },
  { key: 'hold.decide', group: 'Quality', label: 'Decide on a held basket (release, reject, downsize)', rule: r => r === 'Quality' || r === 'Admin' },
  { key: 'rework.act', group: 'Quality', label: 'Send a lot for rework at Planetary Rolling', rule: r => isProductionManager(r) || r === 'Quality' || isManagerRole(r) },
  { key: 'maintenance.signoff', group: 'Maintenance', label: 'Sign off (resolve) breakdowns', rule: r => MAINTENANCE_SIGNOFF_ROLES.includes(r) },
  { key: 'cost.view', group: 'Cost', label: 'See cost figures (dashboard and Cost of Production)', rule: r => isManagerRole(r) || r === 'Owner' },
  { key: 'customer.see', group: 'Visibility', label: 'See which customer an order is for', rule: r => ['Production', 'PPC Manager', 'Manager', 'Assistant Manager', 'Admin', 'Owner', 'Sales', 'Dispatch'].includes(r) },
  { key: 'master.add', group: 'Visibility', label: 'Add new customers, sizes and other values to Master from a form', rule: r => ['Sales', 'Production', 'PPC Manager', 'Manager', 'Assistant Manager', 'Admin'].includes(r) },
];
const CUSTOMER_TABS = ['orders', 'dispatch'];   // what the Customer role gets by default: its own orders and deliveries, read only
const FEATURES = [
  ...NAV.filter(n => !SPACE_HUBS[n.key] && n.key !== 'launchpad').map(n => ({ key: `tab.${n.key}`, group: 'Tabs', kind: 'tab', label: n.label, tab: n.key, adminOnly: n.key === 'master', rule: n.roles ? (r => n.roles.includes(r)) : () => true, customer: CUSTOMER_TABS.includes(n.key) })),
  ...ACTION_FEATURES.map(f => ({ ...f, kind: 'action' })),
];
const FEATURE_BY_KEY = Object.fromEntries(FEATURES.map(f => [f.key, f]));
function featureDefault(role, f) {
  if (role === 'Customer') return !!f.customer;       // the Customer role starts with only its own orders and deliveries
  return !!f.rule(role);
}
function canDo(role, key) {
  const f = FEATURE_BY_KEY[key]; if (!f) return false;
  if (f.adminOnly) return role === 'Admin';
  if (role === 'Admin' && f.kind === 'tab') return true;       // the Admin always keeps every tab
  const o = ACCESS.overrides && ACCESS.overrides[role] && ACCESS.overrides[role][key];
  if (typeof o === 'boolean') return o;
  return featureDefault(role, f);
}
function canSeeTab(user, key) {
  if (!user) return false;
  if (SPACE_HUB_TABS[key]) return SPACE_HUB_TABS[key].some(k => canSeeTab(user, k));
  if (key === 'launchpad') return user.role !== 'Customer';   // NEEL_HOME_V1: Home is for everyone
  return canDo(user.role, `tab.${key}`);
}
function visibleTabs(user) { return NAV.filter(n => canSeeTab(user, n.key)); }
function firstVisibleTab(user) { const v = visibleTabs(user); return (v.find(n => n.key === 'launchpad') || v[0] || { key: 'launchpad' }).key; }
// the differences from the default, ready to store: only features whose value differs from the default are kept
function accessDiff(role, wanted) {
  const out = {};
  Object.entries(wanted || {}).forEach(([k, v]) => { const f = FEATURE_BY_KEY[k]; if (f && !f.adminOnly && typeof v === 'boolean' && v !== featureDefault(role, f)) out[k] = v; });
  return out;
}
// what a role would see: tabs and granted actions (for the "view as" panel in Master)
function roleSummary(role) {
  const on = (kind) => FEATURES.filter(f => f.kind === kind && canDo(role, f.key));
  return { tabs: on('tab').map(f => f.tab), actions: on('action').map(f => f.key) };
}
// ---- Master data: customers (with locations) and sizes. Orders keep the text they were saved with; Master never rewrites them. ----
function mdName(s) { return String(s ?? '').trim().replace(/\s+/g, ' '); }
function mdSame(a, b) { return mdName(a).toLowerCase() === mdName(b).toLowerCase(); }
function mdCleanLocations(list) {
  const out = [];
  (list || []).forEach(l => { const n = mdName(l); if (n && !out.some(x => mdSame(x, n))) out.push(n); });
  return out;
}
function customerFind(customers, name, activeOnly = false) { return (customers || []).find(c => mdSame(c.name, name) && (!activeOnly || c.active !== false)) || null; }
function customerCheckName(customers, name, exceptId = null) {
  const n = mdName(name);
  if (!n) return 'Enter the customer name.';
  if (n.length > 80) return 'Use at most 80 characters for a customer name.';
  if ((customers || []).some(c => c.id !== exceptId && mdSame(c.name, n))) return `"${n}" is already in Master.`;
  return '';
}
function customerCheckLocations(locs) {
  const bad = (locs || []).map(mdName).find(l => l.length > 60);
  return bad ? `A location can have at most 60 characters ("${bad.slice(0, 20)}...").` : '';
}
// add a customer; a deactivated one with the same name is brought back (and its locations merged) instead of being added twice
function customerAdd(customers, { name, locations = [], gstin = '' }, newId = uid) {
  const list = (customers || []).map(c => ({ ...c, locations: [...(c.locations || [])] }));
  const n = mdName(name), locs = mdCleanLocations(locations);
  const lerr = customerCheckLocations(locs); if (lerr) return { error: lerr };
  const existing = list.find(c => mdSame(c.name, n));
  if (existing && existing.active !== false) { const e = customerCheckName(customers, n); return { error: e || `"${n}" is already in Master.` }; }
  const err = existing ? '' : customerCheckName(customers, n); if (err) return { error: err };
  const g = mdName(gstin).toUpperCase();
  if (existing) { existing.active = true; existing.locations = mdCleanLocations([...existing.locations, ...locs]); if (g) existing.gstin = g; return { customers: list, id: existing.id, reactivated: true }; }
  const c = { id: newId(), name: n, locations: locs, gstin: g, active: true };
  return { customers: [...list, c], id: c.id };
}
function customerAddLocation(customers, id, location) {
  const n = mdName(location); if (!n) return { error: 'Enter the location.' };
  const lerr = customerCheckLocations([n]); if (lerr) return { error: lerr };
  const c = (customers || []).find(x => x.id === id); if (!c) return { error: 'That customer is not in Master.' };
  if ((c.locations || []).some(l => mdSame(l, n))) return { error: `"${n}" is already a location of ${c.name}.` };
  return { customers: customers.map(x => x.id === id ? { ...x, locations: [...(x.locations || []), n] } : x) };
}
function customerRemoveLocation(customers, id, location) { return { customers: (customers || []).map(x => x.id === id ? { ...x, locations: (x.locations || []).filter(l => l !== location) } : x) }; }
function customerRename(customers, id, name) {
  const err = customerCheckName(customers, name, id); if (err) return { error: err };
  if (!(customers || []).some(c => c.id === id)) return { error: 'That customer is not in Master.' };
  return { customers: customers.map(c => c.id === id ? { ...c, name: mdName(name) } : c) };
}
function customerSetActive(customers, id, active) { return { customers: (customers || []).map(c => c.id === id ? { ...c, active: !!active } : c) }; }
function customerRemove(customers, id) { return { customers: (customers || []).filter(c => c.id !== id) }; }
// one customer per line: "Name; Location; Location" (a tab also separates). Good lines are applied, bad lines are reported by line number.
function customersImport(customers, text, newId = uid) {
  let cur = customers || [], added = 0, merged = 0; const errors = [];
  String(text || '').split(/\r?\n/).forEach((line, i) => {
    if (!line.trim()) return;
    const parts = line.split(/[;\t]/).map(mdName); const name = parts[0];
    const location = parts[1] || ''; const gstin = parts[2] || '';
    const existing = customerFind(cur, name);
    if (existing && existing.active !== false) {
      let next = cur; let any = false; let bad = '';
      if (location && !(existing.locations || []).some(x => mdSame(x, location))) { const r = customerAddLocation(next, existing.id, location); if (r.error) bad = r.error; else { next = r.customers; any = true; } }
      if (gstin && existing.gstin !== gstin) { next = next.map(c => c.id === existing.id ? { ...c, gstin } : c); any = true; }
      if (bad) errors.push(`Line ${i + 1}: ${bad}`); else if (any) { cur = next; merged += 1; } else errors.push(`Line ${i + 1}: "${name}" is already in Master.`);
      return;
    }
    const r = customerAdd(cur, { name, locations: location ? [location] : [], gstin }, newId);
    if (r.error) errors.push(`Line ${i + 1}: ${r.error}`); else { cur = r.customers; added += 1; }
  });
  return { customers: cur, added, merged, errors };
}
function customerOptions(customers) { return (customers || []).filter(c => c.active !== false).map(c => c.name).sort((a, b) => a.localeCompare(b)); }
function customerLocations(customers, name) { const c = customerFind(customers, name, true); return c ? mdCleanLocations(c.locations) : []; }

function sizeLabel(sz) {
  const mm = (v) => String(Math.round(Number(v) * 1000) / 1000);
  return `${sz.od ? mm(sz.od) : ''}${sz.thk ? ` × ${mm(sz.thk)}` : ''} mm${sz.productType ? ` · ${sz.productType}` : ''}${sz.spec ? ` · ${sz.spec}` : ''}${sz.uom ? ` · ${sz.uom}` : ''}`;
}
function sizeKey(x) { return [x.productType || '', Number(x.od) || 0, Number(x.thk) || 0, mdName(x.spec).toLowerCase(), mdName(x.uom).toLowerCase()].join('|'); }
function sizeCheck(sizes, input, exceptId = null) {
  const pt = input.productType; const od = Number(input.od); const thkTxt = String(input.thk ?? '').trim(); const thk = thkTxt === '' ? 0 : Number(thkTxt);
  if (!PRODUCT_TYPES.includes(pt)) return { error: 'Choose the product type.' };
  if (!(od > 0) || !isFinite(od)) return { error: 'Enter the tube OD in mm (more than 0), or provide a valid size string.' };
  if (thkTxt !== '' && (!(thk > 0) || !isFinite(thk))) return { error: 'The thickness must be more than 0 mm, or left empty.' };
  if (mdName(input.spec).length > 80) return { error: 'The specification can have at most 80 characters.' };
  const clean = { productType: pt, od, thk: thk || 0, spec: mdName(input.spec), uom: mdName(input.uom) };
  if ((sizes || []).some(x => x.id !== exceptId && sizeKey(x) === sizeKey(clean))) return { error: `${sizeLabel(clean)} is already in Master.` };
  return { clean };
}
function sizeAdd(sizes, input, newId = uid) {
  const r = sizeCheck(sizes, input); if (r.error) return r;
  const sz = { id: newId(), ...r.clean, active: true };
  return { sizes: [...(sizes || []), sz], id: sz.id };
}
function sizesImport(sizes, text, newId = uid) {
  let cur = sizes || [], added = 0; const errors = [];
  String(text || '').split(/\r?\n/).forEach((line, i) => {
