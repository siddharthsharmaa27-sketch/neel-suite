  if (line?.shift === 'Split') return { Day: Number(line.dayQty) || 0, Night: Number(line.nightQty) || 0 };
  return { Day: planned, Night: 0 };      // "Day", nothing stored (older lines) or anything unknown
}
function lineShiftIssue(line) {
  const sh = line?.shift;
  if (sh === undefined || sh === null || sh === '' || sh === 'Day' || sh === 'Night') return '';
  if (sh !== 'Split') return 'the shift must be Day, Night or Split.';
  const d = Number(line.dayQty), n = Number(line.nightQty), p = Number(line.planned);
  if (!(d > 0) || !(n > 0)) return 'a Split line needs a Day quantity and a Night quantity, both more than 0.';
  if (Math.abs(d + n - p) > 1e-6) return `the Day (${d}) and Night (${n}) quantities must add up to the planned quantity (${p}).`;
